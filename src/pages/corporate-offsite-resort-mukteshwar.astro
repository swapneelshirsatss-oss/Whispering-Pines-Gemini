    icon: Sparkles
  },
  {
    num: "03",
    title: "Flexible All-Day Dining",
    description: "Continuous tea/coffee/snack stations during work hours, wholesome multi-cuisine buffets, and late-night snacks.",
    icon: Utensils
  },
  {
    num: "04",
    title: "Station & Airport Transit",
    description: "Managed private transfers from Kathgodam Station (70 km / 2.5 hrs) and Pantnagar Airport (105 km / 3.5 hrs).",
    icon: Car
  },
  {
    num: "05",
