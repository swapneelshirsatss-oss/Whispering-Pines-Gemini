      "url": "https://whisperingpinesresort.in/corporate-offsite-resort-mukteshwar/",
      "image": "https://whisperingpinesresort.in/images/banquest-hall-in-resort.avif",
      "telephone": "+917505029696",
      "priceRange": "₹₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "House No. 23-13/4, Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Road",
        "addressLocality": "Mukteshwar",
        "addressRegion": "Nainital, Uttarakhand",
        "postalCode": "263137",
