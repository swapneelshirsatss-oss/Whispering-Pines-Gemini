        { "@type": "LocationFeatureSpecification", "name": "2,200 Sq. Ft. Peak-Facing Wedding & Conference Lawn", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Dedicated Heated Indoor Conference Lounge", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Standalone 3-BHK Alpine Executive Leadership Villa", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Corporate GST Input-Credit Billing", "value": true }
      ],
