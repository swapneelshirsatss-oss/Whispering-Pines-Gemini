      { time: "01:30 PM", title: "Welcome Luncheon", desc: "Multi-cuisine buffet spread at Pine View Restaurant with mountain view seating." },
      { time: "03:30 PM", title: "Opening Keynote & Strategy Session", desc: "AV-equipped conference session in Pine View Lounge or Nanda Devi Lawn." },
      { time: "07:30 PM", title: "Sundowner BBQ & Fire Pit Networking", desc: "Live barbecue grills, acoustic mountain music, and team conversations under starry skies." }
    ]
  },
  {
    day: "Day 02",
    theme: "Deep Work & Synergy",
    highlight: "Morning forest walks, intensive sprints & annual gala dinner",
    events: [
      { time: "07:30 AM", title: "Guided Pine Forest Walk", desc: "Morning nature trail through deodar forests to invigorate focus and alertness." },
      { time: "09:00 AM", title: "Energizing Breakfast Buffet", desc: "Pahadi fresh fruit bar, continental breakfast, and specialty coffee bar." },
      { time: "10:00 AM", title: "Core Workshops & Breakout Sprints", desc: "Split team sprints across the Alpine Boardroom and poolside breakout circles." },
      { time: "03:00 PM", title: "Team-Building Lawn Challenges", desc: "Structured outdoor collaboration challenges and trust activities on the peak lawn." },
      { time: "07:30 PM", title: "Annual Awards & Gala Dinner", desc: "Curated celebration banquet, recognitions, and music at the conference hall." }
    ]
  },
  {
    day: "Day 03",
    theme: "Reflect & Depart",
    highlight: "Closing town hall, panoramic group photograph & scenic departures",
    events: [
      { time: "08:30 AM", title: "Farewell Breakfast", desc: "Leisurely family-style breakfast buffet with hot mountain breakfast favorites." },
      { time: "10:00 AM", title: "Closing Town Hall & Action Items", desc: "Final alignment huddle, team takeaways, and roadmaps for the upcoming quarters." },
      { time: "12:00 PM", title: "Group Photo facing Nanda Devi & Departure", desc: "Executive team photo against snow peaks and managed private coach transit to station/airport." }
    ]
  }
];

// Rich JSON-LD Structured Data
const corporateSchema = {
