---

<Layout
  title="Executive Corporate Retreats in Mukteshwar | Whispering Pines Resort"
  description="Plan executive corporate offsites and MICE leadership retreats at Whispering Pines Resort Mukteshwar. 150 Mbps fiber Wi-Fi, 100% confidential buyout up to 70 delegates, and 180° Nanda Devi snow peaks."
  canonical="/corporate-offsite-resort-mukteshwar/"
  image="/images/banquest-hall-in-resort.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(corporateSchema)} />
  </Fragment>

  <div class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#C9A832] selection:text-[#1B3322]">
    
    {/* ========================================================================= */}
    {/* [SECTION 1: HERO HEADER] */}
    {/* ========================================================================= */}
    <header class="relative min-h-[90vh] flex items-center justify-center bg-[#1B3322] text-[#FAF9F6] pt-16 pb-20 sm:pb-24 overflow-hidden border-b border-[#C9A832]/20">
      {/* Background Imagery with High-Contrast Editorial Vignette */}
      <div class="absolute inset-0 z-0">
        <img
          src="/images/Whispering-pines-balcony-view-nanital.avif"
          alt="180 degree panoramic Himalayan snow peak views from Whispering Pines Resort for corporate retreats"
          class="w-full h-full object-cover object-center filter brightness-[0.28]"
          loading="eager"
          fetchpriority="high"
        />
        {/* Multi-layered dark forest scrims for razor-sharp typography contrast */}
        <div class="absolute inset-0 bg-gradient-to-t from-[#1B3322] via-[#1B3322]/75 to-[#1B3322]/85" />
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#1B3322]/85 via-[#1B3322]/60 to-[#1B3322]/95 pointer-events-none" />
      </div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {/* Eyebrow Badge */}
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#1B3322]/80 backdrop-blur-md border border-[#C9A832]/45 mb-8 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C9A832]"></span>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#C9A832] font-semibold">
            MICE · LEADERSHIP RETREATS · TEAM OFFSITES
          </span>
        </div>

        {/* Main Title (H1) with Optical Drop Shadow */}
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-normal text-[#FAF9F6] tracking-tight leading-[1.1] mb-6 max-w-4xl mx-auto text-balance drop-shadow-[0_2px_14px_rgba(0,0,0,0.7)]">
          Executive Corporate Retreats in Mukteshwar
        </h1>

        {/* Editorial Gold Hairline Rule */}
        <div class="w-20 h-[1.5px] bg-[#C9A832] mx-auto mb-6 opacity-90 shadow-xs" />

        {/* Sub-headline with High-Contrast Legibility */}
        <p class="font-sans text-base sm:text-lg lg:text-xl text-[#FAF9F6]/95 font-light leading-relaxed max-w-3xl mx-auto mb-10 text-pretty drop-shadow-[0_1px_6px_rgba(0,0,0,0.5)]">
          Elevate strategic thinking, team synergy, and leadership alignment at 1,780 metres. Set amidst peaceful pine forests with 180° panoramic views of Nanda Devi and Trishul snow peaks, Whispering Pines Resort offers boutique 4-star hospitality, dedicated conference spaces, 150 Mbps enterprise fiber Wi-Fi, and exclusive estate buyouts for up to 70 delegates.
        </p>

        {/* CTA Buttons */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 mb-14">
          {/* Primary CTA: WhatsApp */}
          <a
            href="https://wa.me/917505029696?text=Hi%20Casa%20De%20Bello!%20I%20am%20inquiring%20about%20an%20Executive%20Corporate%20Offsite%20%2F%20MICE%20Retreat%20at%20Whispering%20Pines%20Resort."
            target="_blank"
            rel="noopener noreferrer"
            onclick="window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'generate_lead', event_category: 'corporate', event_label: 'hero_whatsapp_click' });"
            class="w-full sm:w-auto btn-shimmer inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#1EBE5D] text-white font-mono text-xs uppercase tracking-[0.16em] font-semibold transition-all duration-300 shadow-luxury-md hover:scale-[1.02]"
          >
            <Phone className="w-4 h-4 fill-current shrink-0" />
            <span>Inquire on WhatsApp (+91-7505029696)</span>
          </a>

          {/* Secondary CTA: Scroll to Lead Form */}
          <a
            href="#corporate-inquiry"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-[#FAF9F6]/10 hover:bg-[#FAF9F6]/20 text-[#FAF9F6] border border-[#FAF9F6]/25 font-mono text-xs uppercase tracking-[0.16em] font-semibold transition-all duration-300 backdrop-blur-sm"
          >
            <span>Download Offsite Proposal</span>
            <ArrowUpRight className="w-4 h-4 text-[#C9A832]" />
          </a>
        </div>

        {/* Trust Indicators Bar (4 Key Metrics) */}
        <div class="border-t border-[#FAF9F6]/15 pt-8 mt-4">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-left sm:text-center">
            {/* Metric 1 */}
            <div class="space-y-1">
              <span class="font-mono text-xl sm:text-2xl font-normal text-[#C9A832] block tnum">
                100% Private
              </span>
              <p class="font-sans text-xs text-[#FAF9F6]/80 leading-snug">
                Confidential Estate Buyout (Up to 70 Delegates)
              </p>
            </div>

            {/* Metric 2 */}
            <div class="space-y-1 sm:border-l sm:border-[#FAF9F6]/15 sm:pl-4">
              <span class="font-mono text-xl sm:text-2xl font-normal text-[#C9A832] block tnum">
                150 Mbps
              </span>
              <p class="font-sans text-xs text-[#FAF9F6]/80 leading-snug">
                Enterprise Fiber Wi-Fi Across All Areas
              </p>
            </div>

            {/* Metric 3 */}
            <div class="space-y-1 sm:border-l sm:border-[#FAF9F6]/15 sm:pl-4">
              <span class="font-mono text-xl sm:text-2xl font-normal text-[#C9A832] block tnum">
                2,200 Sq. Ft.
              </span>
              <p class="font-sans text-xs text-[#FAF9F6]/80 leading-snug">
                Panoramic Himalayan Peak Lawn
              </p>
            </div>

            {/* Metric 4 */}
            <div class="space-y-1 sm:border-l sm:border-[#FAF9F6]/15 sm:pl-4">
              <div class="flex items-center sm:justify-center gap-1 text-[#C9A832]">
                <Star className="w-4 h-4 fill-current text-[#C9A832]" />
                <span class="font-mono text-xl sm:text-2xl font-normal text-[#C9A832] tnum">
                  4.6 / 5
                </span>
              </div>
              <p class="font-sans text-xs text-[#FAF9F6]/80 leading-snug">
                Rated on Google (388+ Verified Reviews)
              </p>
            </div>
          </div>
        </div>

      </div>
    </header>

    {/* ========================================================================= */}
    {/* [SECTION 2: WHY CHOOSE WHISPERING PINES?] */}
    {/* ========================================================================= */}
    <section class="py-24 sm:py-32 bg-[#FAF9F6] border-b border-[#1B3322]/10" id="why-choose-us">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Section Header */}
        <div class="max-w-3xl mb-16 sm:mb-20">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#C27847] font-semibold block mb-3">
            PURPOSE-BUILT RETREATS
          </span>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-normal text-[#1B3322] leading-tight text-balance mb-4">
            An Inspiring Mountain Setting for Strategic Focus
          </h2>
          <div class="w-16 h-[1.5px] bg-[#C9A832] mb-6" />
          <p class="font-sans text-base sm:text-lg text-[#2C3531]/80 font-light leading-relaxed">
            Break away from standard hotel ballrooms. Whispering Pines combines peaceful Himalayan isolation with executive infrastructure, giving leadership teams the headspace to align, innovate, and recharge.
          </p>
        </div>

        {/* 6 Value Pillars (3x2 Grid) */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {VALUE_PILLARS.map((pillar) => {
            const Icon = pillar.icon;
            return (
              <div class="bg-white rounded-2xl border border-[#E8E5DF] p-7 sm:p-8 flex flex-col justify-between hover:border-[#1B3322]/30 shadow-luxury-sm hover:shadow-luxury-md transition-all duration-300 group hover:-translate-y-1">
                <div class="space-y-4">
                  <div class="flex items-center justify-between">
                    <div class="w-10 h-10 rounded-full bg-[#1B3322]/5 flex items-center justify-center text-[#1B3322] group-hover:bg-[#1B3322] group-hover:text-[#FAF9F6] transition-colors">
                      <Icon className="w-5 h-5" />
                    </div>
                    <span class="font-mono text-xs text-[#C9A832] font-semibold">
                      {pillar.num}
                    </span>
                  </div>

                  <h3 class="font-display text-xl sm:text-2xl font-normal text-[#1B3322] leading-snug">
                    {pillar.title}
                  </h3>

                  <p class="font-sans text-xs sm:text-sm text-[#2C3531]/80 font-light leading-relaxed">
                    {pillar.description}
                  </p>
                </div>

                <div class="pt-5 mt-4 border-t border-[#1B3322]/10 flex items-center gap-2 text-[11px] font-mono text-[#1B3322]/70">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#C9A832]"></span>
                  <span>Casa De Bello Executive Standard</span>
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </section>

    {/* ========================================================================= */}
    {/* [SECTION 3: MEETING SPACES & CAPACITIES] */}
    {/* ========================================================================= */}
    <section class="py-24 sm:py-32 bg-[#FBF9F5] border-b border-[#1B3322]/10" id="workspaces">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* Section Header */}
        <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#C27847] font-semibold block mb-3">
            WORKSPACES
          </span>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-normal text-[#1B3322] leading-tight text-balance">
            Venues Configured for Productive Sessions
          </h2>
          <div class="w-16 h-[1.5px] bg-[#C9A832] mx-auto mt-4 mb-4" />
          <p class="font-sans text-sm sm:text-base text-[#2C3531]/75 font-light leading-relaxed">
            From climate-controlled presentation suites and executive villa boardrooms to high-altitude lawn town halls, discover agile workspaces built for high-performance teams.
          </p>
        </div>

        {/* 4 Clean Cards */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
          {WORKSPACES.map((space) => (
            <article class="bg-white rounded-2xl border border-[#E8E5DF] overflow-hidden shadow-luxury-sm hover:shadow-luxury-md transition-all duration-300 flex flex-col group">
              {/* Space Real Image Header */}
              <div class="relative h-64 sm:h-72 overflow-hidden bg-[#1B3322]/5">
                <img
                  src={space.image}
                  alt={space.alt}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent opacity-70" />
                
                {/* Setting Tag Badge */}
