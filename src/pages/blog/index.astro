---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs";
import WhatsAppButton from "../../components/WhatsAppButton";
import { BLOG_POSTS } from "../../data/blogPosts.tsx";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Whispering Pines Resort Blog",
  description:
    "Discover updates, travel tips, and stories from the heart of the Himalayas.",
  url: "https://whisperingpinesresort.in/blog/",
  publisher: {
    "@type": "Organization",
    name: "Whispering Pines Resort",
    logo: {
      "@type": "ImageObject",
      url: "https://whisperingpinesresort.in/logo.svg",
    },
  },
};
---

<Layout
  title="Blog | Whispering Pines Resort Mukteshwar"
  description="Read the latest news, travel guides, and stories from Whispering Pines Resort Mukteshwar."
>
  <div
    class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#c9a832] selection:text-[#1B3322]"
  >
    {/* JSON-LD Schema for SEO */}
    <script
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify(schemaData)}
    />

    <Breadcrumbs />

    {/* Hero Header Banner */}
    <header class="relative bg-[#1B3322] text-white pt-32 pb-20 px-4 sm:px-6 lg:px-8 border-b border-[#c9a832]/20 overflow-hidden">
      <div class="absolute inset-0 z-0 opacity-30">
        <img
          src="/images/Resort-Near-Mukteshwar-for-Families-Couples-Workations.avif"
          alt="Whispering Pines Resort Mukteshwar Blog & Travel Guides"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <div class="relative z-10 max-w-4xl mx-auto text-center space-y-4">
        <span class="text-xs font-mono text-[#c9a832] uppercase tracking-[0.25em] font-semibold block">
          Whispering Pines Himalayan Journal
        </span>
        <h1 class="text-4xl md:text-6xl font-bold font-display tracking-tight text-white">
          Our Blog & Travel Guides
        </h1>
        <p class="text-base md:text-xl text-gray-200 font-light max-w-2xl mx-auto leading-relaxed">
          Discover Himalayan travel guides, resort stories, seasonal updates, and insider tips from Malla Ramgarh near Mukteshwar.
        </p>
      </div>
    </header>

    <main class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          BLOG_POSTS.map((post) => {
            const articleUrl = post.customUrl || `/blog/${post.slug}/`;
            return (
              <article class="bg-white rounded-lg shadow-sm border border-[#EAE8E3] overflow-hidden hover:shadow-md transition-shadow flex flex-col">
                <a
                  href={articleUrl}
                  class="h-48 w-full overflow-hidden block"
                >
                  <img
                    src={post.imageUrl}
                    alt={post.title}
                    class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-500"
                  />
                </a>
                <div class="p-6 flex-1 flex flex-col">
                  <div class="flex items-center text-xs text-gray-500 mb-3 space-x-4">
                    <span>{post.date}</span>
                    <span>{post.readTime}</span>
                  </div>
                  <a href={articleUrl} class="group block">
                    <h2 class="text-xl font-bold text-[#1B3322] mb-3 leading-tight group-hover:text-[#c9a832] transition-colors">
                      {post.title}
                    </h2>
                  </a>
                  <p class="text-sm text-gray-600 mb-4 line-clamp-3 flex-1">
                    {post.excerpt}
                  </p>
                  <a
                    href={articleUrl}
                    class="text-[#c9a832] font-semibold text-sm hover:text-[#1B3322] transition-colors flex items-center mt-auto w-fit"
                  >
                    Read More
                    <svg
                      class="w-4 h-4 ml-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"
                      />
                    </svg>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </main>

    <WhatsAppButton client:idle />
  </div>
</Layout>
