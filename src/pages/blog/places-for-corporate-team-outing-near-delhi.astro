---
import Layout from '../../layouts/Layout.astro';
import { RESORT_CONTACT, generateWhatsAppLink } from '../../data';
import BlogShareBar from '../../components/BlogShareBar.astro';
import DirectVsOtaTable from '../../components/DirectVsOtaTable.astro';

const pageTitle = "Places for Corporate Team Outing Near Delhi (2026-27 Guide)";
const pageDescription = "Shortlisting places for a corporate team outing near Delhi? Venues sorted by 1 day, 1 night & 2 nights offsites, budgets, MICE setup & team activities.";
const canonicalUrl = "https://whisperingpinesresort.in/blog/places-for-corporate-team-outing-near-delhi/";
const ogImageUrl = "https://whisperingpinesresort.in/images/corporate-team-outing-conference-hall-india.webp";
const ogAltText = "Indian corporate team conference and offsite retreat meeting with panoramic Himalayan views at Whispering Pines Resort near Delhi";

const breadcrumbs = [
  { name: "Home", item: "https://whisperingpinesresort.in/" },
  { name: "Blog", item: "https://whisperingpinesresort.in/blog/" },
  { name: "Corporate Team Outing Near Delhi", item: canonicalUrl }
];

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
  "headline": "Places for Corporate Team Outing Near Delhi (2026-27 Guide): Sorted by How Many Days You Have",
  "description": pageDescription,
  "image": { "@type": "ImageObject", "url": ogImageUrl, "width": 1200, "height": 675 },
  "datePublished": "2026-11-06T10:00:00+05:30",
  "dateModified": "2026-11-06T10:00:00+05:30",
  "author": {
    "@type": "Person",
    "name": "Gaurav Pandey",
    "jobTitle": "CEO and Director, Casa De Bello Pvt Ltd",
    "url": "https://whisperingpinesresort.in/about-whispering-pines-resort-ramgarh/",
    "sameAs": ["https://casadebello.com/"]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
    "url": "https://whisperingpinesresort.in",
    "logo": { "@type": "ImageObject", "url": "https://whisperingpinesresort.in/logo.svg" }
  },
  "keywords": "Places for corporate team outing near Delhi, corporate team outing near Delhi, resorts for corporate outing near Delhi, corporate offsite near Delhi, corporate offsite resorts in Uttarakhand, corporate team building activities in Uttarakhand, 2 night corporate offsite, Whispering Pines Resort MICE"
};

const resortSchema = {
  "@context": "https://schema.org",
  "@type": ["Resort", "Hotel", "LodgingBusiness"],
  "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
  "description": "Premium 4-star mountain conference resort with 25 rooms, standalone 3-BHK private alpine villa, Pine View Conference Lounge (up to 80 delegates), 2,200 sq. ft. Nanda Devi lawn, 150 Mbps fiber Wi-Fi, and complete private property buyouts for corporate offsites up to 70 delegates.",
  "url": "https://whisperingpinesresort.in",
  "telephone": "+91-7505029696",
  "email": "booking@whisperingpinesresort.in",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd, Mukteshwar, Nainital, Uttarakhand 263137",
    "addressLocality": "Mukteshwar",
    "addressRegion": "Uttarakhand",
    "postalCode": "263137",
    "addressCountry": "IN"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": "29.4264111", "longitude": "79.5505355" },
  "hasMap": "https://maps.google.com/?cid=8386667112972057918",
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.6", "reviewCount": "409", "bestRating": "5", "worstRating": "1" },
  "priceRange": "₹3,000 – ₹15,999",
  "amenityFeature": [
    { "@type": "LocationFeatureSpecification", "name": "Pine View Conference Lounge (Seats up to 80 Delegates)", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "150 Mbps High-Speed Enterprise Fiber Wi-Fi", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "2,200 sq. ft. Panoramic Nanda Devi Lawn for Team Building", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Alpine Villa CXO Boardroom with Natural Stone Fireplace", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Dual Silent DG Generator Power Backup", "value": true },
    { "@type": "LocationFeatureSpecification", "name": "Itemized GST Invoices & PO Vendor Onboarding", "value": true }
  ]
};

const corporateFaqs = [
  {
    question: "What are the best places for a corporate team outing near Delhi?",
    answer: "The ideal venue depends strictly on your timeframe. For a single-day outing, stay within 100 km in Gurugram, Damdama, or Manesar. For a 1-night offsite, Neemrana, Rishikesh, or Jim Corbett work well (120 to 260 km). For a strategic 2-night corporate offsite away from urban noise, the Kumaon hills around Ramgarh and Mukteshwar (340 km) offer 180° Himalayan views, 100% private resort buyouts, and productive climate-controlled meeting facilities."
  },
  {
    question: "How far is Whispering Pines Resort from Delhi for a corporate group?",
    answer: "Whispering Pines Resort in Malla Ramgarh is located approximately 340 km from Delhi NCR, typically taking 6.5 to 7.5 hours via NH 9. Alternatively, groups can travel comfortably via the Kathgodam Shatabdi Express to Kathgodam railway station (43 km / ~1.5 hours away), where the resort arranges coordinated AC coach and taxi fleet transfers."
  },
  {
    question: "How many delegates can Whispering Pines host for an overnight corporate retreat?",
    answer: "We accommodate corporate groups of 20 to 70 delegates across 25 premium rooms and a standalone 3-BHK Alpine Villa. For mid-sized teams, we provide a 100% private property buyout, ensuring zero outside leisure guests share your conference halls, lawns, or dining spaces."
  },
  {
    question: "What conference and meeting AV equipment are provided on-site?",
    answer: "Our heated Pine View Conference Lounge includes a professional speaker podium with gooseneck microphone, wireless handheld and lapel mics, an active JBL PA sound system, ceiling-mounted HD projection with motorized widescreen, mobile flip charts, magnetic whiteboards, delegate stationery kits, and 150 Mbps fiber Wi-Fi backed by dual silent generators."
  },
  {
    question: "What corporate team building activities can groups do in Uttarakhand?",
    answer: "At Whispering Pines, teams enjoy lawn trust challenges and team coordination games on our 2,200 sq. ft. Nanda Devi lawn, guided pine forest morning walks, the 16 km Bhalu Gaad waterfall trail, local fruit orchard tours, acoustic bonfire evenings with live barbecue counters, and optional morning visits to Kainchi Dham Ashram."
  },
  {
    question: "Do you provide itemized GST input-credit invoices and vendor PO registration?",
    answer: "Yes. Our corporate reservations desk provides fully itemized quotation sheets, GST input-credit tax invoices, vendor onboarding documentation (PAN, GSTIN, MSME, cancelled cheque), and accepts corporate Purchase Orders (POs) with transparent payment milestones."
  },
  {
    question: "Is there a private dining setup for corporate groups away from leisure guests?",
    answer: "Yes. Company groups receive dedicated dining inside the Cedar Dining Hall (seating up to 80 delegates), custom multi-cuisine buffets timed to your meeting agenda, dedicated Pure Vegetarian and Jain meal options on request, and private open-air gala dinners on the lawn."
  }
];

const waCorporateLink = generateWhatsAppLink(
  "Hi Gaurav! I am organizing a Corporate Team Outing / Offsite from Delhi and would like an itemized proposal, conference venue details, and group rates for Whispering Pines Resort."
);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  image={ogImageUrl}
  breadcrumbs={breadcrumbs}
  faqs={corporateFaqs}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={ogImageUrl} fetchpriority="high" type="image/webp" />
    <meta property="article:published_time" content="2026-11-06T10:00:00+05:30" />
    <meta property="article:modified_time" content="2026-11-06T10:00:00+05:30" />
    <meta property="article:author" content="Gaurav Pandey — CEO and Director, Casa De Bello Pvt Ltd" />
    <meta property="article:section" content="Corporate Offsites, MICE & Team Building Guides" />
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(resortSchema)} />
  </Fragment>

  <article class="bg-[#FAF9F6] text-[#0E2C21] font-sans antialiased selection:bg-[#B0966D] selection:text-[#0E2C21]">
    {/* Breadcrumbs Navigation */}
    <nav class="pt-28 pb-4 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto" aria-label="Breadcrumb">
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-500">
        <a href="/" class="hover:text-[#0E2C21] transition-colors">Home</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-[#0E2C21] transition-colors">Blog</a>
        <span>/</span>
        <span class="text-[#7A6038] truncate">Corporate Team Outing Near Delhi</span>
      </div>
    </nav>

    {/* Main Container */}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 space-y-12">
      {/* Header Card */}
      <header class="bg-white p-6 sm:p-10 md:p-12 rounded-sm shadow-sm border border-[#EAE8E3] space-y-6">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-gray-500">
            <span class="bg-[#0E2C21] text-[#B0966D] text-[11px] font-semibold uppercase px-3 py-1 rounded-full shadow-xs">
              Corporate MICE Guide
            </span>
            <span>•</span>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#B0966D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              November 6, 2026
            </span>
            <span>•</span>
            <span>Updated November 6, 2026</span>
            <span>•</span>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#B0966D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              14 min read
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-[#0E2C21] leading-tight">
            Places for Corporate Team Outing Near Delhi (2026-27 Guide): Sorted by How Many Days You Have
          </h1>

          {/* Author Byline */}
          <div class="pt-4 flex flex-col sm:flex-row sm:items-center gap-4 border-t border-gray-100">
            <div class="flex items-center gap-3">
              <img
                src="/images/Gaurav-pandey-casa-de-bello.webp"
                alt="Gaurav Pandey — CEO and Director, Casa De Bello Pvt Ltd"
                class="w-12 h-12 rounded-full object-cover border-2 border-[#B0966D] shrink-0 shadow-sm"
                width="48"
                height="48"
                loading="eager"
              />
              <div>
                <p class="text-sm font-bold text-[#0E2C21]">
                  By Gaurav Pandey, CEO and Director, Casa De Bello Pvt Ltd
                </p>
                <p class="text-xs text-gray-500 font-light">
                  Whispering Pines Resort, Malla Ramgarh • Hosting Delhi corporate retreats, leadership offsites &amp; MICE groups
                </p>
              </div>
            </div>
            <div class="sm:ml-auto">
              <span class="inline-block bg-[#0E2C21]/5 text-[#7A6038] text-[11px] font-semibold px-3 py-1 rounded-sm border border-[#0E2C21]/10">
                🏢 120+ Company Groups Hosted
              </span>
            </div>
          </div>
        </div>

        {/* Feature Hero Image */}
        <div class="w-full h-64 sm:h-96 md:h-[460px] overflow-hidden rounded-sm border border-gray-100 shadow-sm bg-gray-100">
          <img
            src={ogImageUrl}
            alt={ogAltText}
            width="1200"
            height="675"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        {/* Trust Banner */}
        <div class="bg-[#FAF9F6] p-5 rounded-sm border-l-4 border-[#8A6F4A] shadow-xs space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[#7A6038] block">Why You Can Trust This Guide</span>
          <ul class="text-xs sm:text-sm text-gray-700 space-y-1.5 font-light">
            <li>• It is written directly by the operational team that hosts corporate offsites at Whispering Pines, not by an aggregator affiliate.</li>
            <li>• Facts about our facilities match our verified venue blueprints, and external destinations link to public 2026 pricing citations.</li>
            <li>• Where another destination fits your team's exact constraints better, we explicitly say so, and list our own candid limits below.</li>
          </ul>
        </div>

        {/* Share Bar Top */}
        <BlogShareBar
          title={pageTitle}
          url={canonicalUrl}
          description={pageDescription}
          label="Planning a company offsite? Share this venue guide with your HR or leadership committee"
          className="my-4"
        />

        {/* AEO Quick Answer Box */}
        <div class="aeo-direct-answer bg-[#FAF9F6] p-6 sm:p-7 rounded-sm border border-[#EAE8E3] shadow-xs space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-[#7A6038] block">
            Quick Answer: The Best Places for Corporate Team Outing Near Delhi
          </span>
          <p class="text-base text-gray-800 leading-relaxed font-light">
            <strong>For a single-day outing, stay within 100 km:</strong> Gurugram, Sohna, Damdama, or Manesar resorts keep travel under 90 minutes. <strong>For a 1-night offsite,</strong> Neemrana (heritage), Rishikesh (adventure rafting), or Jim Corbett (wildlife safaris) work best at 120 to 260 km. <strong>For a 2-night strategic offsite well away from city distractions,</strong> the Kumaon hills around Ramgarh and Mukteshwar (340 km from Delhi) provide cool mountain weather, 180° Himalayan snow peak views, 150 Mbps Wi-Fi, and complete resort buyout privacy for groups of 20 to 70 people.
          </p>
          <div class="pt-2 flex flex-wrap gap-4 text-xs text-[#0E2C21] font-medium">
            <span>✓ Venues Sorted by Trip Duration</span>
            <span>✓ Complete AV, Podium &amp; MICE Setup</span>
            <span>✓ 100% Private Resort Buyouts Up to 70 Pax</span>
            <span>✓ GST Input-Credit &amp; PO Support</span>
          </div>
        </div>

        {/* Body Content */}
        <div class="prose prose-lg max-w-none text-[#2C3531] font-light leading-relaxed prose-headings:font-display prose-headings:text-[#0E2C21] prose-a:text-[#0E2C21] prose-a:font-semibold prose-a:underline space-y-8">
          <p class="text-lg text-gray-700 leading-relaxed">
            If you are shortlisting places for a corporate team outing near Delhi, the single most critical filter is counting how many days your team can genuinely be away before picking a location. A Saturday day outing, an overnight bonding offsite, and a multi-day strategic leadership retreat demand fundamentally different venues. Unfortunately, most aggregator listicles online lump all three formats together.
          </p>

          <p>
            We manage <a href="/">Whispering Pines Resort</a> in Malla Ramgarh, Uttarakhand — 340 km from Delhi — hosting company offsites, product launch retreats, and CXO councils throughout the year. Being 6.5 hours away makes us the wrong choice for a single-day trip, but a category-defining choice for a <a href="/corporate-offsite-resort-mukteshwar/">two-night corporate offsite of 20 to 70 delegates</a>. This guide categorizes venue options strictly by distance and duration, covering external destinations alongside our own property, so you can pair your venue with the time you actually have.
          </p>

          {/* Section 1: Day Outings (<100 km) */}
          <h2 class="text-2xl sm:text-3xl font-bold text-[#0E2C21] pt-6 border-t border-gray-100">
            Day Outings Within 100 km of Delhi (Zero Overnight Stay)
          </h2>

          <p>
            If your company can only spare one working day or a Saturday without overnight travel approval, avoid heading towards the hills. Stay firmly inside the NCR highway belt, depart the office by 8:30 AM, and have everyone back home for dinner. These resorts for corporate outings near Delhi are engineered specifically for high-throughput single-day fun:
          </p>

          <div class="overflow-x-auto my-6 border border-[#EAE8E3] rounded-sm bg-white shadow-xs">
            <table class="w-full text-left text-sm text-[#2C3531]">
              <thead class="bg-[#0E2C21] text-[#FAF9F6] text-xs uppercase font-semibold">
                <tr>
                  <th class="p-3.5">Area &amp; Venue Example</th>
                  <th class="p-3.5">Distance from Delhi</th>
                  <th class="p-3.5">Format &amp; Setup</th>
                  <th class="p-3.5">Published Starting Price</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 text-xs sm:text-sm">
                <tr class="hover:bg-[#FAF9F6]/60">
                  <td class="p-3.5 font-bold text-[#0E2C21]">Badshahpur, Gurugram (Dream Island)</td>
                  <td class="p-3.5">~47 km</td>
                  <td class="p-3.5">Day package, team games, lawn obstacle activities, buffet lunch</td>
                  <td class="p-3.5 font-semibold text-[#7A6038]">from ₹990 per person</td>
                </tr>
                <tr class="hover:bg-[#FAF9F6]/60">
                  <td class="p-3.5 font-bold text-[#0E2C21]">Tauru Road, Gurugram (Surjivan Resort)</td>
                  <td class="p-3.5">~49 km</td>
                  <td class="p-3.5">Ethnic village-themed day outing, traditional mud games, folk dance</td>
                  <td class="p-3.5 font-semibold text-[#7A6038]">from ₹1,325 per person</td>
                </tr>
                <tr class="hover:bg-[#FAF9F6]/60">
                  <td class="p-3.5 font-bold text-[#0E2C21]">Dharuhera (Aravali Resorts)</td>
                  <td class="p-3.5">~70 km</td>
                  <td class="p-3.5">Adventure activities, open pool deck, DJ and banquet dance floor</td>
                  <td class="p-3.5 font-semibold text-[#7A6038]">from ₹1,200 per person</td>
                </tr>
                <tr class="hover:bg-[#FAF9F6]/60">
                  <td class="p-3.5 font-bold text-[#0E2C21]">Jhajjar (Pratapgarh Farms)</td>
                  <td class="p-3.5">~82 km</td>
                  <td class="p-3.5">Rural cultural immersion, pottery, camel rides (min. 30 people)</td>
                  <td class="p-3.5 font-semibold text-[#7A6038]">₹1,140 per person</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-sm text-gray-700">
            <strong>Best For:</strong> Budget team days, sales celebrations, large 200+ employee headcounts, and teams with strict no-overnight policy.
          </p>
          <p class="text-sm text-gray-700">
            <strong>The Realistic Limit:</strong> Everyone is back checking Slack and email by 7:00 PM. A single-day outing builds light team camaraderie, but it virtually never delivers the mental decompression needed for deep product roadmapping or leadership alignment. Furthermore, on peak weekends, you almost always share the grounds with three other noisy corporate groups.
          </p>

          {/* Section 2: One-Night Offsites (120 to 260 km) */}
          <h2 class="text-2xl sm:text-3xl font-bold text-[#0E2C21] pt-6 border-t border-gray-100">
            One-Night Corporate Offsites (120 to 260 km from Delhi)
          </h2>

          <p>
            An overnight stay shifts group dynamics entirely. Colleagues dine together unhurried, linger around a late-night bonfire, and the second morning is consistently when the most valuable strategic conversations unlock. Three destinations dominate one-night NCR shortlists:
          </p>

          <div class="overflow-x-auto my-6 border border-[#EAE8E3] rounded-sm bg-white shadow-xs">
            <table class="w-full text-left text-sm text-[#2C3531]">
              <thead class="bg-[#7A6038] text-white text-xs uppercase font-semibold">
                <tr>
                  <th class="p-3.5">Destination</th>
                  <th class="p-3.5">Distance &amp; Drive Time</th>
                  <th class="p-3.5">Primary Team Value</th>
                  <th class="p-3.5">Crucial Constraints to Watch</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 text-xs sm:text-sm">
                <tr class="hover:bg-[#FAF9F6]/60">
                  <td class="p-3.5 font-bold text-[#0E2C21]">Neemrana, Rajasthan</td>
                  <td class="p-3.5">~120 km (~3h)</td>
                  <td class="p-3.5">Heritage palace ambience, aerial zipline, relaxed evening banquets</td>
                  <td class="p-3.5">Multi-tiered ramp layouts make moving large groups between sessions tiring</td>
                </tr>
                <tr class="hover:bg-[#FAF9F6]/60">
                  <td class="p-3.5 font-bold text-[#0E2C21]">Rishikesh, Uttarakhand</td>
                  <td class="p-3.5">~240 km (~5.5h)</td>
                  <td class="p-3.5">Ganga white-water rafting, beach volleyball, riverside camps &amp; resorts</td>
                  <td class="p-3.5">Rafting closes during monsoons; highway traffic jams around Haridwar</td>
                </tr>
                <tr class="hover:bg-[#FAF9F6]/60">
                  <td class="p-3.5 font-bold text-[#0E2C21]">Jim Corbett, Uttarakhand</td>
                  <td class="p-3.5">~260 km (~5.5h)</td>
                  <td class="p-3.5">Open-top 4x4 jungle jeep safaris, large riverside lawns, resort pools</td>
                  <td class="p-3.5">Safari zone permits require 45-day pre-booking; premium zones close in monsoon</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-sm text-gray-700">
            <strong>Budget Expectations:</strong> A 2-day, 1-night Rishikesh offsite averages ₹3,500 to ₹4,500/head at entry level, ₹5,000 to ₹7,000 mid-range, and ₹8,000 to ₹12,000 for luxury properties. In Jim Corbett, corporate packages typically run ₹2,500 to ₹5,500 per person per night on twin sharing.
          </p>

          <p class="text-sm text-gray-700 font-medium">
            <strong>Our Candid Recommendation:</strong> If your team only has a single night and prioritizes adrenaline, choose Rishikesh. If they want wildlife safaris, choose Jim Corbett. Driving 340 km to Ramgarh for a single night involves too much highway time for too brief a retreat.
          </p>

          {/* Section 3: Two-Night Corporate Offsites in Kumaon */}
          <h2 class="text-2xl sm:text-3xl font-bold text-[#0E2C21] pt-6 border-t border-gray-100">
            Two-Night Corporate Offsites in the Kumaon Hills (The Sweet Spot)
          </h2>

          <p>
            Two nights is where the Kumaon hills fully reward the longer drive. Evening 1 is welcome arrival, crisp mountain air, and a starlit barbecue bonfire. Day 2 is a full, uninterrupted 10-hour working and team-building cycle where no delegate is worried about catching an evening metro or train. Day 3 delivers an inspiring wrap-up town hall and a smooth daytime descent.
          </p>

          <p>
            Perched at 1,780 metres in Malla Ramgarh along the Bhowali-Ramgarh-Mukteshwar corridor, Whispering Pines Resort maintains summer daytime temperatures between 22°C and 28°C — allowing outdoor lawn workshops even in mid-May when Delhi is sweltering at 43°C. For comprehensive on-site hospitality and logistics, review our <a href="/resort-services-ramgarh/">full resort services and guest facilities</a>.
          </p>

          {/* Whispering Pines Venue Matrix */}
          <h3 class="text-lg font-bold text-[#0E2C21] pt-2">Corporate MICE Infrastructure at Whispering Pines Resort</h3>
          <div class="overflow-x-auto my-4 border border-[#EAE8E3] rounded-sm bg-white shadow-xs">
            <table class="w-full text-left text-sm text-[#2C3531]">
              <thead class="bg-[#0E2C21] text-[#FAF9F6] text-xs uppercase font-semibold">
                <tr>
                  <th class="p-3.5">Venue &amp; Facility</th>
                  <th class="p-3.5">Physical Specs</th>
                  <th class="p-3.5">Seating Capacity</th>
                  <th class="p-3.5">Ideal Business Session Format</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100 text-xs sm:text-sm">
                <tr class="hover:bg-[#FAF9F6]/60">
                  <td class="p-3.5 font-bold text-[#0E2C21]">Pine View Conference Lounge</td>
                  <td class="p-3.5">1,400 sq. ft. heated indoor hall, natural daylight, pine views</td>
                  <td class="p-3.5 font-semibold text-[#7A6038]">Up to 80 delegates (Theater / Cluster)</td>
                  <td class="p-3.5">Plenary keynotes, quarterly business reviews, slide-heavy town halls</td>
                </tr>
