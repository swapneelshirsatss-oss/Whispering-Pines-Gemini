        <h3 class="text-base font-bold text-[#1B3322] mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-[#c9a832]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
