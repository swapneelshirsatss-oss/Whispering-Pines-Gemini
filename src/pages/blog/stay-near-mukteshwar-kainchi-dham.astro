        description={pageDescription}
        label="Planning a trip with friends or family? Share this guide"
        className="mb-12"
      />

      <!-- EDITORIAL INTRODUCTION -->
      <section class="prose prose-lg max-w-none text-[#2C3531] space-y-5 mb-14">
