---
import Layout from '../../layouts/Layout.astro';
import BlogContent from "../../components/BlogContent";
import BlogShareBar from "../../components/BlogShareBar.astro";
import DirectVsOtaTable from "../../components/DirectVsOtaTable.astro";
import { BLOG_POSTS } from '../../data/blogPosts.tsx';

export async function getStaticPaths() {
  return BLOG_POSTS.filter((post) => !post.customUrl).map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = BLOG_POSTS.find((p) => p.slug === slug);

if (!post) {
  throw new Error(`Blog post not found for slug: ${slug}`);
}

const relatedPosts = BLOG_POSTS.filter((p) => p.slug !== slug).slice(0, 3);

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://whisperingpinesresort.in/blog/${post.slug}/`
    },
    "headline": post.title,
    "image": [post.imageUrl.startsWith("http") ? post.imageUrl : `https://whisperingpinesresort.in${post.imageUrl}`],
    "datePublished": new Date(post.date).toISOString(),
    "dateModified": new Date(post.updatedDate ?? post.date).toISOString(),
    "description": post.excerpt,
    "url": `https://whisperingpinesresort.in/blog/${post.slug}/`,
    "author": {
      "@type": "Person",
      "name": "Gaurav Pandey",
      "jobTitle": "Director",
      "image": "https://whisperingpinesresort.in/images/Gaurav-pandey-casa-de-bello.webp",
      "worksFor": {
        "@type": "Organization",
        "name": "Casa De Bello Pvt Ltd",
        "url": "https://casadebello.com/"
      }
    },
    "publisher": {
      "@type": "Organization",
      "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
      "logo": {
        "@type": "ImageObject",
        "url": "https://whisperingpinesresort.in/logo.svg"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Resort",
    "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
    "image": "https://whisperingpinesresort.in/og-image.webp",
    "telephone": "+91-7505029696",
    "url": "https://whisperingpinesresort.in/",
    "priceRange": "₹3000 - ₹15999",
    "hasMap": "https://maps.google.com/?cid=8386667112972057918",
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 29.42641,
      "longitude": 79.55053,
      "elevation": "1780m"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd, Mukteshwar, Nainital, Uttarakhand 263137",
      "addressLocality": "Mukteshwar",
      "addressRegion": "Uttarakhand",
      "postalCode": "263137",
      "addressCountry": "IN"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.6",
      "reviewCount": "409",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  ...(post.faqSchema ? [post.faqSchema] : []),
  ...(post.extraSchemas || [])
];
---

<Layout 
  title={post.seoTitle ?? `${post.title} | Whispering Pines Resort Mukteshwar`}
  description={post.seoDescription ?? post.excerpt}
  image={post.imageUrl}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={post.imageUrl} fetchpriority="high" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schemaData)}
    />
  </Fragment>

  <div class="relative w-full bg-[#FAF9F6] text-[#0E2C21] overflow-x-hidden selection:bg-[#B0966D] selection:text-[#0E2C21]">

    <main class="pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-12">
      {/* Back Button */}
      <a 
        href="/blog/"
        class="inline-flex items-center gap-2 text-xs font-bold text-[#0E2C21] hover:text-[#7A6038] focus:outline-none focus:ring-2 focus:ring-[#7A6038] transition-colors group bg-white px-4 py-2 rounded-full border border-[#EAE8E3] shadow-sm"
        aria-label="Back to All Blog Articles"
      >
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to All Articles
      </a>

      {/* Article Header */}
      <article class="bg-white p-6 sm:p-10 md:p-12 rounded-sm shadow-sm border border-[#EAE8E3] space-y-8">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-gray-500">
            <span class="bg-[#0E2C21] text-[#B0966D] text-[11px] font-semibold uppercase px-3 py-1 rounded-full shadow-sm">
              Himalayan Guide
            </span>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#B0966D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {post.date}
            </span>
            {post.updatedDate && (
              <>
                <span>•</span>
                <span>Updated {post.updatedDate}</span>
              </>
            )}
            <span>•</span>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#B0966D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {post.readTime}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-[#0E2C21] leading-tight">
            {post.title}
          </h1>

          <div class="pt-4 flex items-center gap-3 border-t border-gray-100">
            <img
              src="/images/Gaurav-pandey-casa-de-bello.webp"
              alt="Gaurav Pandey"
              class="w-10 h-10 rounded-full object-cover border border-[#B0966D] shrink-0 shadow-sm"
              width="40"
              height="40"
              loading="lazy"
            />
            <div>
              <p class="text-xs font-bold text-[#0E2C21]">Written by Gaurav Pandey</p>
              <p class="text-[11px] text-gray-500 font-light">Director, Casa De Bello Pvt Ltd • Malla Ramgarh</p>
            </div>
          </div>
        </div>

        {/* Feature Hero Image */}
        <div class="w-full h-64 sm:h-96 md:h-[480px] overflow-hidden rounded-sm border border-gray-100 shadow-sm bg-gray-100">
          <img 
            src={post.imageUrl} 
            alt={post.imageAlt ?? post.title} 
            width="1200"
            height="675"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        {/* Share Bar Top */}
        <BlogShareBar
          title={post.title}
          url={`https://whisperingpinesresort.in/blog/${post.slug}/`}
          description={post.excerpt}
          label="Planning a trip? Share this guide with your travel group"
          className="my-6"
        />

        {/* Verified Host E-E-A-T Attribution Bar */}
        <div class="bg-[#FAF9F6] p-4 sm:p-5 rounded-sm border border-[#EAE8E3] flex flex-col sm:flex-row items-center justify-between gap-4 my-6">
          <div class="flex items-center gap-3.5">
            <img
              src="/images/Gaurav-pandey-casa-de-bello.webp"
              alt="Gaurav Pandey — Director, Whispering Pines Resort by Casa De Bello"
              class="w-12 h-12 rounded-full object-cover border-2 border-[#8A6F4A] shrink-0 shadow-xs"
              width="48"
              height="48"
              loading="lazy"
            />
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#7A6038] block">Verified On-Site Host &amp; Fact-Checked Guide</span>
              <p class="text-xs sm:text-sm font-bold text-[#0E2C21]">Reviewed by Gaurav Pandey — Director, Whispering Pines Resort by Casa De Bello</p>
              <p class="text-xs text-gray-600 font-light">1,780m Malla Ramgarh Ridge • 180° Nanda Devi View From All Rooms • Direct WhatsApp: +91 75050 29696</p>
            </div>
          </div>
          <a
            href="https://wa.me/917505029696?text=Hi%20Gaurav!%20I'm%20reading%20your%20travel%20guide%20and%20would%20like%20to%20claim%20the%20Flat%2025%25%20Direct%20Booking%20Discount."
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold text-xs rounded-sm shadow-xs transition-all"
          >
            <span>💬 Ask Host on WhatsApp</span>
          </a>
        </div>

        {/* Direct vs OTA Table */}
        <DirectVsOtaTable className="my-6" />

        {/* Body Content */}
        <div class="prose prose-lg max-w-none text-[#2C3531] font-light leading-relaxed prose-headings:font-display prose-headings:text-[#0E2C21] prose-a:text-[#0E2C21] prose-a:font-semibold prose-a:underline">
          <BlogContent content={post.content} excerpt={post.excerpt} />
        </div>

        {/* Share Bar Bottom */}
        <BlogShareBar
          title={post.title}
          url={`https://whisperingpinesresort.in/blog/${post.slug}/`}
          description={post.excerpt}
          label="Found this guide helpful? Share it with your friends or family"
          className="mt-8 mb-4"
        />
      </article>

      {/* Related Articles Section */}
      {relatedPosts.length > 0 && (
        <section class="space-y-6 pt-6">
          <h2 class="text-2xl font-bold font-display text-[#0E2C21]">
            Explore More Himalayan Guides
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((rel) => {
              const relUrl = rel.customUrl || `/blog/${rel.slug}/`;
              return (
                <a 
                  href={relUrl}
                  class="bg-white rounded-sm border border-[#EAE8E3] p-5 shadow-sm hover:shadow-md hover:border-[#8A6F4A]/30 transition-all duration-300 flex flex-col justify-between group"
                >
                  <div class="space-y-3">
                    <div class="h-36 w-full rounded-sm overflow-hidden mb-3">
                      <img src={rel.imageUrl} alt={rel.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <span class="text-[10px] text-gray-500 font-medium">{rel.readTime}</span>
                    <h3 class="text-sm font-bold text-[#0E2C21] group-hover:text-[#7A6038] transition-colors line-clamp-2 leading-snug">
                      {rel.title}
                    </h3>
                  </div>
                  <span class="text-xs font-semibold text-[#0E2C21] group-hover:text-[#7A6038] transition-colors mt-4 flex items-center gap-1">
                    Read Guide →
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {/* Callout Card */}
      <section class="bg-gradient-to-br from-[#0E2C21] to-[#133A2B] text-white rounded-sm p-8 border border-[#8A6F4A]/30 text-center space-y-4">
        <h3 class="text-2xl font-bold font-display text-white">Experience Whispering Pines Resort</h3>
        <p class="text-sm text-gray-300 font-light max-w-xl mx-auto">
          Book your luxury stay with 180° Himalayan valley views from every room in Malla Ramgarh near Mukteshwar.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://wa.me/917505029696?text=Hi!%20I%20want%20to%20claim%20the%20Flat%2025%25%20Direct%20Booking%20Discount%20at%20Whispering%20Pines%20Resort."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex flex-col items-center justify-center bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold text-xs px-6 py-3 rounded-full shadow-md transition-all duration-300"
          >
            <span class="uppercase tracking-wider">💬 Book Direct on WhatsApp (+91 75050 29696)</span>
            <span class="text-[11px] font-medium text-white/95 mt-0.5">Save Flat 25% Direct • ⚡ &lt; 5m reply</span>
          </a>
          <a
            href="https://casadebello-book.whisperingpinesresort.in/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-[#B0966D] hover:bg-[#C4A77D] text-[#0E2C21] font-bold text-xs px-6 py-3.5 rounded-full shadow-md uppercase tracking-wider transition-all duration-300"
          >
            Check Rates &amp; Availability
          </a>
        </div>
      </section>
    </main>
  </div>
</Layout>
