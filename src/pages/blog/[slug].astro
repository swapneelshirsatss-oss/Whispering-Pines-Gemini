---
import Layout from '../../layouts/Layout.astro';
import WhatsAppButton from "../../components/WhatsAppButton";
import BlogContent from "../../components/BlogContent";
import { BLOG_POSTS } from '../../data/blogPosts.tsx';

export async function getStaticPaths() {
  return BLOG_POSTS.filter((post) => !post.customUrl).map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = BLOG_POSTS.find((p) => p.slug === slug);

if (!post) {
  throw new Error(`Blog post not found for slug: ${slug}`);
}

const relatedPosts = BLOG_POSTS.filter((p) => p.slug !== slug).slice(0, 3);

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://whisperingpinesresort.in/blog/${post.slug}/`
    },
    "headline": post.title,
    "image": [post.imageUrl],
    "datePublished": new Date(post.date).toISOString(),
    "dateModified": new Date(post.date).toISOString(),
    "description": post.excerpt,
    "url": `https://whisperingpinesresort.in/blog/${post.slug}/`,
    "author": {
      "@type": "Person",
      "name": "Gaurav Pandey",
      "jobTitle": "Director",
      "worksFor": {
        "@type": "Organization",
        "name": "Casa De Bello Pvt Ltd",
        "url": "https://casadebello.com/"
      }
    },
    "publisher": {
      "@type": "Organization",
      "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
      "logo": {
        "@type": "ImageObject",
        "url": "https://whisperingpinesresort.in/logo.svg"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Place",
    "name": "Whispering Pines Resort by Casa De Bello - Malla Ramgarh",
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 29.42641,
      "longitude": 79.55053,
      "elevation": "1780m"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd",
      "addressLocality": "Mukteshwar",
      "addressRegion": "Uttarakhand",
      "postalCode": "263137",
      "addressCountry": "IN"
    }
  }
];
---

<Layout 
  title={`${post.title} | Whispering Pines Resort Mukteshwar`}
  description={post.excerpt}
>
  <div class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#c9a832] selection:text-[#1B3322]">
    {/* JSON-LD Schema for SEO */}
    <script
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify(schemaData)}
    />

    <main class="pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-12">
      {/* Back Button */}
      <a 
        href="/blog/"
        class="inline-flex items-center gap-2 text-xs font-bold text-[#1B3322] hover:text-[#c9a832] transition-colors group bg-white px-4 py-2 rounded-full border border-[#EAE8E3] shadow-sm"
      >
        <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to All Articles
      </a>

      {/* Article Header */}
      <article class="bg-white p-6 sm:p-10 md:p-12 rounded-3xl shadow-sm border border-[#EAE8E3] space-y-8">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-medium text-gray-500">
            <span class="bg-[#1B3322] text-[#c9a832] text-[11px] font-semibold uppercase px-3 py-1 rounded-full shadow-sm">
              Himalayan Guide
            </span>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#c9a832]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {post.date}
            </span>
            <span>•</span>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-[#c9a832]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              {post.readTime}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-display text-[#1B3322] leading-tight">
            {post.title}
          </h1>

          <div class="pt-4 flex items-center gap-3 border-t border-gray-100">
            <div class="w-10 h-10 rounded-full bg-[#1B3322] text-[#c9a832] flex items-center justify-center font-bold text-sm border border-[#c9a832]">
              GP
            </div>
            <div>
              <p class="text-xs font-bold text-[#1B3322]">Written by Gaurav Pandey</p>
              <p class="text-[11px] text-gray-500 font-light">Director, Casa De Bello Pvt Ltd • Malla Ramgarh</p>
            </div>
          </div>
        </div>

        {/* Feature Hero Image */}
        <div class="w-full h-64 sm:h-96 md:h-[480px] overflow-hidden rounded-2xl border border-gray-100 shadow-inner">
          <img 
            src={post.imageUrl} 
            alt={post.title} 
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>

        {/* Body Content */}
        <div class="prose prose-lg max-w-none text-[#2C3531] font-light leading-relaxed prose-headings:font-display prose-headings:text-[#1B3322] prose-a:text-[#1B3322] prose-a:font-semibold prose-a:underline">
          <BlogContent content={post.content} excerpt={post.excerpt} />
        </div>
      </article>

      {/* Related Articles Section */}
      {relatedPosts.length > 0 && (
        <section class="space-y-6 pt-6">
          <h2 class="text-2xl font-bold font-display text-[#1B3322]">
            Explore More Himalayan Guides
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((rel) => {
              const relUrl = rel.customUrl || `/blog/${rel.slug}/`;
              return (
                <a 
                  href={relUrl}
                  class="bg-white rounded-2xl border border-[#EAE8E3] p-5 shadow-sm hover:shadow-md hover:border-[#c9a832]/30 transition-all duration-300 flex flex-col justify-between group"
                >
                  <div class="space-y-3">
                    <div class="h-36 w-full rounded-xl overflow-hidden mb-3">
                      <img src={rel.imageUrl} alt={rel.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <span class="text-[10px] text-gray-500 font-medium">{rel.readTime}</span>
                    <h3 class="text-sm font-bold text-[#1B3322] group-hover:text-[#c9a832] transition-colors line-clamp-2 leading-snug">
                      {rel.title}
                    </h3>
                  </div>
                  <span class="text-xs font-semibold text-[#1B3322] group-hover:text-[#c9a832] transition-colors mt-4 flex items-center gap-1">
                    Read Guide →
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {/* Callout Card */}
      <section class="bg-gradient-to-br from-[#1B3322] to-[#24422D] text-white rounded-3xl p-8 border border-[#c9a832]/30 text-center space-y-4">
        <h3 class="text-2xl font-bold font-display text-white">Experience Whispering Pines Resort</h3>
        <p class="text-sm text-gray-300 font-light max-w-xl mx-auto">
          Book your luxury stay with 180° Himalayan valley views in Malla Ramgarh near Mukteshwar.
        </p>
        <div class="pt-2">
          <a
            href="https://casadebello-book.whisperingpinesresort.in/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-[#c9a832] hover:bg-[#b09228] text-[#1B3322] font-bold text-xs px-6 py-3 rounded-full shadow-md uppercase tracking-wider transition-all duration-300"
          >
            Check Rates & Availability
          </a>
        </div>
      </section>
    </main>

    <WhatsAppButton client:idle />
  </div>
</Layout>
