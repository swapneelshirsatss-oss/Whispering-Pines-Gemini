---
// 301 Permanent Redirect to /book-now/ (Primary Landing Page)
return Astro.redirect('/book-now/', 301);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/book-now/" />
    <link rel="canonical" href="https://whisperingpinesresort.in/book-now/" />
    <title>Redirecting to Whispering Pines Booking...</title>
    <script is:inline>
      window.location.replace('/book-now/');
    </script>
  </head>
  <body style="background:#07150C;color:#FAF7F2;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;">
    <p>Redirecting to <a href="/book-now/" style="color:#25D366;text-decoration:underline;">Whispering Pines Direct Booking Page</a>...</p>
  </body>
</html>
