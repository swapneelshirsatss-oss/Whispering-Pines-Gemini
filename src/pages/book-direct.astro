  <!-- =========================================================================
       CLIENT JAVASCRIPT: LUXURY CONCIERGE CALCULATOR ENGINE
       ========================================================================= -->
  <script is:inline>
    (function () {
      const roomSelect = document.getElementById('calc-room');
      const checkInInput = document.getElementById('calc-checkin');
      const checkOutInput = document.getElementById('calc-checkout');
      const guestsSelect = document.getElementById('calc-guests');
      const priceDisplay = document.getElementById('calc-display-price');
      const nightsDisplay = document.getElementById('calc-display-nights');
      const savingsDisplay = document.getElementById('calc-display-savings');
      const whatsappBtn = document.getElementById('btn-whatsapp-submit');
      const mobileStickyWhatsapp = document.getElementById('mobile-sticky-whatsapp');

      // Initialize default dates: tomorrow and day after
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(today.getDate() + 1);
      const dayAfter = new Date(tomorrow);
      dayAfter.setDate(tomorrow.getDate() + 1);

      const toDateInputValue = (d) => d.toISOString().split('T')[0];
      if (checkInInput && checkOutInput) {
        checkInInput.value = toDateInputValue(tomorrow);
        checkOutInput.value = toDateInputValue(dayAfter);
        checkInInput.min = toDateInputValue(today);
        checkOutInput.min = toDateInputValue(tomorrow);
      }

      function updateCalculation() {
        if (!roomSelect || !checkInInput || !checkOutInput || !priceDisplay || !nightsDisplay) return;

        const selectedOption = roomSelect.options[roomSelect.selectedIndex];
        const roomName = selectedOption.text.split('—')[0].trim();
        const basePrice = parseInt(selectedOption.getAttribute('data-price') || '6499', 10);
        const guests = guestsSelect ? guestsSelect.value : '2 Adults';

        const checkInVal = checkInInput.value;
        const checkOutVal = checkOutInput.value;

        let nights = 1;
        if (checkInVal && checkOutVal) {
          const diffMs = new Date(checkOutVal) - new Date(checkInVal);
          const calculated = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
          if (calculated > 0) nights = calculated;
        }

        const totalPrice = basePrice * nights;
        const otaEstimated = Math.round(totalPrice * 1.2);
        const savings = otaEstimated - totalPrice;

        priceDisplay.textContent = '₹' + totalPrice.toLocaleString('en-IN');
        nightsDisplay.textContent = 'for ' + nights + ' night' + (nights > 1 ? 's' : '') + ' (all taxes included)';
        if (savingsDisplay) {
          savingsDisplay.textContent = '✓ You save approx. ₹' + savings.toLocaleString('en-IN') + ' vs MakeMyTrip/Booking.com';
        }

        // Build Structured Pre-Filled WhatsApp Payload
        const message = 
`Hi! I would like to reserve a stay at Whispering Pines Resort Mukteshwar:

🏡 *Accommodation:* ${roomName}
📅 *Check-In:* ${checkInVal || 'Flexible'}
📅 *Check-Out:* ${checkOutVal || 'Flexible'} (${nights} night${nights > 1 ? 's' : ''})
👥 *Guests:* ${guests}
💰 *Est. Direct Tariff:* ₹${totalPrice.toLocaleString('en-IN')}

Please confirm availability and share your best direct booking rate!`;

        const encodedUrl = 'https://wa.me/917505029696?text=' + encodeURIComponent(message);

        if (whatsappBtn) {
          whatsappBtn.onclick = function () {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'generate_lead', {
                event_category: 'booking',
                event_label: 'whatsapp_direct_calculator',
                value: totalPrice
              });
            }
            window.open(encodedUrl, '_blank', 'noopener,noreferrer');
          };
        }

        if (mobileStickyWhatsapp) {
          mobileStickyWhatsapp.href = encodedUrl;
        }
      }

      if (roomSelect) roomSelect.addEventListener('change', updateCalculation);
      if (checkInInput) checkInInput.addEventListener('change', updateCalculation);
      if (checkOutInput) checkOutInput.addEventListener('change', updateCalculation);
      if (guestsSelect) guestsSelect.addEventListener('change', updateCalculation);

      updateCalculation();
    })();
  </script>
