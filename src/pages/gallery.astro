---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import GalleryGrid from "../components/GalleryGrid";
import SEOGalleryContent from "../components/SEOGalleryContent.astro";
import RecentBookingNotification from "../components/RecentBookingNotification";
import GallerySchema from "../components/GallerySchema.astro";
---

<Layout 
  title="Photo Gallery | Whispering Pines Resort Mukteshwar" 
  description="Explore the photo gallery of Whispering Pines Resort near Mukteshwar (Malla Ramgarh). View our suites, private 3-BHK villa, dining, and 180° Himalayan views."
>
  <GallerySchema slot="head" />
  <div class="relative w-full bg-[#FAF9F6] text-[#0E2C21] overflow-x-hidden selection:bg-[#B0966D] selection:text-[#0E2C21]">
    <Breadcrumbs />
    <div class="pt-24 pb-20 bg-[#FAF9F6]">
      <GalleryGrid client:visible />
      <SEOGalleryContent />
    </div>
    <RecentBookingNotification client:idle />
  </div>
</Layout>
