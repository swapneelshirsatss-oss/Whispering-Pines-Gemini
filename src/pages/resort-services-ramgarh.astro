---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ServicesSection from "../components/ServicesSection.astro";
import SEOServicesContent from "../components/SEOServicesContent.astro";
import WhatsAppButton from "../components/WhatsAppButton";
import RecentBookingNotification from "../components/RecentBookingNotification";
---

<Layout 
  title="Resort Services & Guest Facilities | Whispering Pines Ramgarh Mukteshwar" 
  description="Multi-cuisine Kumaoni dining, Kathgodam railway transfers, bonfire nights, guided orchard walks, and concierge services at Whispering Pines Resort Ramgarh."
>
  <div class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#c9a832] selection:text-[#1B3322]">
    <Breadcrumbs />
    
    <main class="pt-8">
      <ServicesSection asH1={true} title="Resort Services & Guest Facilities" />
      
      {/* Corporate Offsites & MICE Feature Banner */}
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-10">
        <div class="rounded-2xl bg-[#1B3322] text-[#FAF9F6] p-8 sm:p-12 relative overflow-hidden border border-[#C9A832]/30 shadow-luxury-md">
          <div class="absolute top-0 right-0 w-96 h-96 bg-[#C9A832]/10 blur-3xl pointer-events-none" />
          <div class="relative z-10 max-w-3xl space-y-4">
            <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#FAF9F6]/10 text-xs font-mono uppercase tracking-[0.2em] text-[#C9A832] font-semibold border border-[#C9A832]/30">
              <span class="w-1.5 h-1.5 rounded-full bg-[#C9A832]"></span>
              MICE & Executive Retreats
            </span>
            <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-normal text-[#FAF9F6] leading-tight">
              Executive Corporate Retreats & Team Offsites in Mukteshwar
            </h2>
            <p class="font-sans text-sm sm:text-base text-[#FAF9F6]/80 font-light leading-relaxed">
              Elevate strategic thinking at 1,780 metres. Dedicated heated conference hall, 150 Mbps enterprise fiber Wi-Fi, 2,200 sq. ft. peak lawn, and 100% confidential buyout up to 70 delegates.
            </p>
            <div class="pt-3 flex flex-wrap items-center gap-4">
              <a
                href="/corporate-offsite-resort-mukteshwar/"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[#C9A832] hover:bg-[#d4b33b] text-[#1B3322] font-mono text-xs uppercase tracking-wider font-semibold transition-all shadow-sm"
              >
                <span>Explore Corporate Offsite Packages</span>
                <span class="text-sm">→</span>
              </a>
              <a
                href="https://wa.me/917505029696?text=Hi!%20I%20am%20inquiring%20about%20corporate%20offsite%20packages%20at%20Whispering%20Pines%20Resort."
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-[#FAF9F6] border border-white/20 font-mono text-xs uppercase tracking-wider font-semibold transition-all"
              >
                <span>Inquire on WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <SEOServicesContent />
    </main>

    <WhatsAppButton client:idle />
    <RecentBookingNotification client:idle />
  </div>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Resort",
        "@id": "https://whisperingpinesresort.in/resort-services-ramgarh/#resort",
        "name": "Whispering Pines Resort by Casa De Bello",
        "url": "https://whisperingpinesresort.in/resort-services-ramgarh/",
        "telephone": "+91-7505029696",
        "priceRange": "₹₹₹",
        "hasMap": "https://maps.google.com/?cid=8386667112972057918",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd, Mukteshwar, Nainital, Uttarakhand 263137",
          "addressLocality": "Mukteshwar",
          "addressRegion": "Uttarakhand",
          "postalCode": "263137",
          "addressCountry": "IN"
        }
      },
      {
        "@type": "Service",
        "name": "Resort Dining & Room Service",
        "provider": { "@id": "https://whisperingpinesresort.in/resort-services-ramgarh/#resort" },
        "serviceType": "Food and Beverage",
        "description": "Authentic Kumaoni regional specialties, North Indian cuisine, and Continental comfort meals served indoors and on the panoramic Himalayan dining deck."
      },
      {
        "@type": "Service",
        "name": "Kathgodam & Pantnagar Transit Concierge",
        "provider": { "@id": "https://whisperingpinesresort.in/resort-services-ramgarh/#resort" },
        "serviceType": "Airport & Railway Station Pickup / Drop",
        "description": "Convenient private mountain cab pickups and drop-offs to Kathgodam Railway Station (40 km) and Pantnagar Airport (75 km)."
      },
      {
        "@type": "Service",
        "name": "Evening Mountain Bonfire & Stargazing",
        "provider": { "@id": "https://whisperingpinesresort.in/resort-services-ramgarh/#resort" },
        "serviceType": "Recreation & Entertainment",
        "description": "Warm evening bonfires with barbecue snacks under clear Himalayan night skies overlooking Nanda Devi."
      },
      {
        "@type": "Service",
        "name": "Executive Corporate Retreats & MICE Offsites",
        "url": "https://whisperingpinesresort.in/corporate-offsite-resort-mukteshwar/",
        "provider": { "@id": "https://whisperingpinesresort.in/resort-services-ramgarh/#resort" },
        "serviceType": "Corporate Offsite and Conference Facility",
        "description": "Dedicated heated conference lounge, 150 Mbps enterprise fiber Wi-Fi, 2,200 sq. ft. peak lawn, and 100% confidential buyout up to 70 delegates."
      }
    ]
  })} />
</Layout>
