---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';

// Image Assets
import heroImgSrc from '../assets/images/Whispering-pines-balcony-view-nanital.avif';
import villaImgSrc from '../assets/images/villa_in_nanital.avif';
import suiteImgSrc from '../assets/images/Delux_room_Whispering_pines_mukteshwar.avif';
import familyImgSrc from '../assets/images/Family_Twin_Room_Near_nainital.avif';
import diningImgSrc from '../assets/images/Restaurant-cafe-ramgarh.avif';
import bathroomImgSrc from '../assets/images/delux-room-bathroom.avif';
import viewImgSrc from '../assets/images/outside-view-from-resort-hotel.avif';
import cedarImgSrc from '../assets/images/Group_booking_nainital_resort.avif';

const heroImage = await getImage({ src: heroImgSrc, format: 'webp', width: 1800, quality: 82 });
const heroMobile = await getImage({ src: heroImgSrc, format: 'webp', width: 800, quality: 78 });
const villaImg = await getImage({ src: villaImgSrc, format: 'webp', width: 900, quality: 80 });
const suiteImg = await getImage({ src: suiteImgSrc, format: 'webp', width: 900, quality: 80 });
const familyImg = await getImage({ src: familyImgSrc, format: 'webp', width: 900, quality: 80 });
const diningImg = await getImage({ src: diningImgSrc, format: 'webp', width: 900, quality: 80 });
const bathroomImg = await getImage({ src: bathroomImgSrc, format: 'webp', width: 900, quality: 80 });
const viewImg = await getImage({ src: viewImgSrc, format: 'webp', width: 900, quality: 80 });
const cedarImg = await getImage({ src: cedarImgSrc, format: 'webp', width: 900, quality: 80 });

// Room cards ordered entry tariff -> flagship so mobile searchers see the ₹3,999 rate first.
// Tariffs are the approved client-profile rates, all inclusive of breakfast.
const ROOM_CARDS = [
  {
    id: 'cedar', name: 'Executive Cedar Suite', price: '₹3,999', value: 3999,
    img: cedarImg, sleeps: 'Sleeps 2 to 3',
    eyebrow: 'Malla Ramgarh • Entry Himalayan-View Suite',
    alt: 'Executive Cedar Suite with cedar panelling and Himalayan view at Whispering Pines Resort, Mukteshwar',
    text: 'Our most-booked suite among hotels near Mukteshwar: cedar-panelled walls, a heated Himalayan-view room and an en-suite bath with 24/7 hot water. The easiest way into a 4-star resort stay at 1,780 m.',
    tags: ['Heated Room', '180° Snow View', 'En-Suite Bath'],
  },
  {
    id: 'family', name: 'Family Twin Room', price: '₹4,999', value: 4999,
    img: familyImg, sleeps: 'Sleeps 4 Guests',
    eyebrow: 'Malla Ramgarh • Ground Floor Garden Ease',
    alt: 'Family Twin Room with twin double beds and ground-floor garden access near Nainital',
    text: 'Ground-floor garden access with no steep stairs, suited to elderly parents and young children. Twin double beds, a garden sit-out and quick access to the dining room.',
    tags: ['Ground Floor Level', 'Twin Double Beds', 'Garden Sit-out'],
  },
  {
    id: 'skylight', name: 'Deluxe Skylight Suite', price: '₹6,499', value: 6499,
    img: suiteImg, sleeps: 'Sleeps 2 to 3', featured: true,
    eyebrow: 'Malla Ramgarh • Romantic Stargazing Suite',
    alt: 'Deluxe Skylight Suite with glass ceiling and private balcony overlooking the Himalayas',
    text: 'Cedar pine panels, a private stargazing glass roof and a valley-view balcony facing Nanda Devi — the suite guests name when they call us the best resort in Mukteshwar.',
    tags: ['Stargazing Glass Roof', 'Valley Balcony', 'King Bed'],
  },
  {
    id: 'villa', name: '3-BHK Private Alpine Villa', price: '₹15,999', value: 15999,
    img: villaImg, sleeps: 'Sleeps up to 10',
    eyebrow: 'Malla Ramgarh • Signature Standalone 3-BHK Villa',
    alt: 'Standalone 3-BHK Private Alpine Villa with private orchard lawn at Whispering Pines Resort, Mukteshwar',
    text: 'Standalone 3-BHK luxury alpine villa with a living-room fireplace, private orchard lawn, three en-suite baths and dedicated chef service for family retreats and group stays.',
    tags: ['Private Fireplace', 'Orchard Lawn', '3 En-Suite Baths'],
  },
];

const RESORT_PHONE_DISPLAY = "075050 29696";
const RESORT_PHONE_TEL = "+917505029696";
const BOOKING_ENGINE_URL = "https://casadebello-book.whisperingpinesresort.in/";
---

<Layout
  title="4-Star Resort & Hotel Near Mukteshwar | Whispering Pines (Up to 20% Off)"
  description="Official direct booking for Whispering Pines Resort in Malla Ramgarh — a 4-star resort & luxury hotel near Mukteshwar. 180° Himalayan views, suites from ₹3,999 incl. breakfast. Save up to 20% direct."
  canonical="https://whisperingpinesresort.in/book-now/"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroMobile.src} media="(max-width: 768px)" fetchpriority="high" type="image/webp" />
    <link rel="preload" as="image" href={heroImage.src} media="(min-width: 769px)" fetchpriority="high" type="image/webp" />
    
    <!-- Schema.org Hotel, Offers & FAQ Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Hotel",
          "@id": "https://whisperingpinesresort.in/#hotel",
          "name": "Whispering Pines Resort by Casa De Bello",
          "url": "https://whisperingpinesresort.in/book-now/",
          "image": "https://whisperingpinesresort.in/og-image.webp",
          "telephone": "+91-7505029696",
          "priceRange": "₹3,999 - ₹15,999",
          "currenciesAccepted": "INR",
          "paymentAccepted": "Cash, Credit Card, UPI, Bank Transfer",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd",
            "addressLocality": "Mukteshwar, Nainital",
            "postalCode": "263137",
            "addressRegion": "Uttarakhand",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 29.4260969,
            "longitude": 79.5506794
          },
          "hasMap": "https://maps.google.com/?cid=8386667112972057918",
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.6",
            "reviewCount": "428",
            "bestRating": "5",
            "worstRating": "1"
          },
          "amenityFeature": [
            { "@type": "LocationFeatureSpecification", "name": "24/7 Instant Hot Geyser Water", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "100% Uninterrupted Power Backup", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "150 Mbps Enterprise Fiber Wi-Fi", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Private Paved Drive-in Car Parking", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Fresh Farm-to-Table Kumaoni Dining", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "180° Panoramic Himalayan Snow Peak Views", "value": true }
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://whisperingpinesresort.in/book-now/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How far is Whispering Pines Resort from Mukteshwar Dham, and how does it compare to hotels in Mukteshwar town?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Whispering Pines Resort is 25 km from Mukteshwar Dham, about a 45 minute drive along the smooth, paved Bhowali–Ramgarh–Mukteshwar highway, in Malla Ramgarh at 1,780 m. Staying here instead of in Mukteshwar town buys you unobstructed 180° Nanda Devi and Trishul snow-peak views, no narrow town traffic jams, gated drive-in parking for 25+ cars, 24/7 hot water, 100% power backup, 150 Mbps fiber Wi-Fi, and 100% pet-friendly orchard lawns with a ₹0 pet surcharge. The trade-off is honest: Mukteshwar town’s shops and the Dham itself are a 45 minute drive away rather than a short walk."
              }
            },
            {
              "@type": "Question",
              "name": "Why is booking directly on WhatsApp or Call cheaper than MakeMyTrip or Booking.com?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Third-party booking platforms (OTAs) charge hotels substantial commission fees plus convenience fees. When you book directly with our front desk, we bypass middleman fees entirely and transfer 100% of those savings to you, guaranteeing our best rate (up to 20% lower), along with complimentary Kumaoni welcome tea."
              }
            },
            {
              "@type": "Question",
              "name": "Is the road to Whispering Pines Resort suitable for hatchbacks and luxury sedans?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, absolutely. Unlike secluded hillside properties that require hazardous off-roading down dirt tracks, Whispering Pines Resort is situated directly on the smooth, paved Bhowali-Ramgarh-Mukteshwar highway. Any hatchback, luxury sedan, or SUV can easily drive right up to our gated private parking area."
              }
            },
            {
              "@type": "Question",
              "name": "Is there reliable hot water and power backup during cold mountain days?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Every private room and suite features a dedicated high-capacity electric geyser for 24/7 instant hot water. In addition, the property is backed by an automated 100% generator power backup system that operates heaters, lighting, and 150 Mbps optical fiber Wi-Fi throughout any regional power outages."
              }
            }
          ]
        }
      ]
    })} />

  </Fragment>

  <!-- =========================================================================
       SECTION 0: PRE-HEADER ROYAL EMBLEM RIBBON (TAJ & CLUB MAHINDRA BENCHMARK)
       ========================================================================= -->
  <aside aria-label="Direct host privilege banner" class="bg-[#03110B] text-[#FAF7F2] border-b border-[#B0966D]/30 py-2.5 px-4 text-xs font-sans tracking-wide relative z-20">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-center sm:text-left">
      <!-- Left: Prestigious Status -->
      <div class="flex items-center gap-2 mx-auto sm:mx-0">
        <span class="inline-flex items-center gap-1.5 text-[#B0966D] font-sans uppercase tracking-[0.2em] text-[10px] font-bold">
          <span class="w-2 h-2 rounded-full bg-[#B0966D]"></span>
          Direct Resident Privilege
        </span>
        <span class="text-[#FAF7F2]/40 hidden md:inline">|</span>
        <span class="text-[#FAF7F2]/80 text-[11px] hidden md:inline">
          Save Up to 20% vs. MakeMyTrip & Agoda • Zero Commission Markups • Priority Suite Allocation
        </span>
      </div>

      <!-- Right: Direct WhatsApp & Phone Desk -->
      <div class="flex items-center gap-2.5 sm:gap-3 mx-auto sm:mx-0">
        <span class="hidden lg:inline-flex items-center gap-1.5 text-[11px] text-[#FAF7F2]/75 font-sans">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Host Desk Active Now
        </span>
        <a
          href="https://wa.me/917505029696?text=Hi!%20I%20am%20viewing%20your%20direct%20booking%20page%20for%20Whispering%20Pines%20Resort.%20Could%20you%20please%20share%20room%20availability%20and%20your%20best%20direct%20rates%3F"
          target="_blank"
          rel="noopener noreferrer"
          data-track-fn="trackBookingConversion" data-track-args='["generate_lead","booking","top_ribbon_whatsapp",{"conversion_type":"whatsapp"}]'
          class="inline-flex items-center gap-1.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-sans text-[11px] font-bold px-3 py-1 rounded-full shadow-sm active:scale-95 transition-all"
          title="Chat directly on WhatsApp with front desk"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WhatsApp Concierge</span>
        </a>
        <a
          href={`tel:${RESORT_PHONE_TEL}`}
          data-track-fn="trackBookingConversion" data-track-args='["phone_call_click","engagement","top_ribbon_phone_call",{"conversion_type":"phone","phone_number":"7505029696"}]'
          class="inline-flex items-center gap-1.5 font-sans text-xs font-bold text-[#E5CFA0] hover:text-[#FAF7F2] transition-colors underline decoration-[#E5CFA0]/60 underline-offset-4"
        >
          <svg class="w-3.5 h-3.5 text-[#E5CFA0]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="hidden sm:inline">Direct Desk:</span> {RESORT_PHONE_DISPLAY}
        </a>
      </div>
    </div>
  </aside>

  <!-- =========================================================================
       SECTION 1: HERO ENCLAVE — THE HIMALAYAN SANCTUARY (ARISTOCRATIC RESTRAINT)
       ========================================================================= -->
  <section class="relative min-h-[94vh] flex items-center justify-center bg-[#03110B] text-[#FAF7F2] overflow-hidden">
    <!-- Cinematic Panoramic Background with Subtle Vignette -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <picture>
        <source srcset={heroMobile.src} media="(max-width: 768px)" type="image/webp" />
        <img
          src={heroImage.src}
          alt="Panoramic private balcony view of Nanda Devi Himalayan mountain range from Whispering Pines Resort Ramgarh"
          class="w-full h-full object-cover opacity-30"
          loading="eager" fetchpriority="high"
          decoding="async"
          width="1800"
          height="1200"
        />
      </picture>
      {/* Dual Atmospheric Scrims for Razor-Sharp Typography Legibility */}
      <div class="absolute inset-0 bg-gradient-to-t from-[#03110B] via-[#03110B]/75 to-[#03110B]/85"></div>
      <div class="absolute inset-0 bg-radial from-transparent via-[#03110B]/40 to-[#03110B]/95 pointer-events-none"></div>
    </div>

    <!-- Aristocratic Watermark Filigree Border -->
    <div class="absolute inset-4 sm:inset-8 border border-[#B0966D]/20 pointer-events-none z-10 hidden sm:block">
      <div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-[#B0966D]"></div>
      <div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-[#B0966D]"></div>
      <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-[#B0966D]"></div>
      <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-[#B0966D]"></div>
    </div>

    <!-- Main Hero Presentation Container -->
    <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-14 pb-24">
      
      <!-- Taj Imperial Crest & Verified Google Rating Badge -->
      <div class="inline-flex flex-col sm:flex-row items-center gap-2 bg-[#051E14]/90 border border-[#B0966D]/40 backdrop-blur-xl px-5 py-2 rounded-full mb-8 shadow-md">
        <div class="flex items-center gap-1 text-[#C4A77D]">
          <span class="text-sm tracking-tighter">★★★★★</span>
        </div>
        <span class="font-mono text-xs text-[#FAF7F2] font-semibold tracking-wider uppercase">
          4.6★ Excellence Score (428 Verified Google Reviews)
        </span>
        <span class="hidden sm:inline text-[#B0966D]/60">•</span>
        <span class="text-[11px] text-[#FAF7F2]/80 font-sans tracking-wide">
          Malla Ramgarh, Mukteshwar (1,780m Altitude)
        </span>
      </div>

      <!-- Main Benefit-Driven Royal Headline -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight text-[#FAF7F2] leading-[1.12] max-w-4xl mx-auto mb-6 text-balance drop-shadow-[0_2px_14px_rgba(0,0,0,0.7)]">
        4-Star Resort &amp; Luxury Hotel Near Mukteshwar <br class="hidden sm:inline" />
        <span class="font-normal text-[#FAF7F2]">
          180° Nanda Devi Snow Views • Save Up to 20% Direct
        </span>
      </h1>

      <!-- Editorial Subcopy (Concrete, Grounded, Zero AI Slop) -->
      <p class="font-sans text-base sm:text-lg md:text-xl text-[#FAF7F2]/95 font-light max-w-2xl mx-auto leading-relaxed mb-10 text-pretty drop-shadow-[0_1px_6px_rgba(0,0,0,0.6)]">
        Whispering Pines Resort stands apart from the hotels and resorts in Mukteshwar town: we are in Malla Ramgarh, a 25 km (45 minute) drive from Mukteshwar Dham, with 5-star mountain comforts on a paved highway. Heated Himalayan-view suites, Glass-Roof Skylight Suites and a 3-BHK Private Villa for ten, plus gated parking for 25+ cars and 150 Mbps fiber Wi-Fi.
      </p>

      <!-- The Taj-Inspired "Direct Resident Privilege Pass" (Price Disparity Card) -->
      <div class="max-w-xl mx-auto mb-10 bg-[#051E14]/85 backdrop-blur-md border border-[#B0966D]/40 rounded-sm p-5 sm:p-6 text-left shadow-[0_12px_40px_rgba(0,0,0,0.6)] relative overflow-hidden">
        <!-- Subtle Top Gold Trim -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#B0966D] to-transparent"></div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-[#FAF7F2]/10 pb-4 mb-4">
          <div>
            <span class="text-[10px] font-sans uppercase tracking-[0.2em] text-[#FAF7F2]/60 block">Third-Party Portals (MakeMyTrip / Agoda)</span>
            <span class="text-sm line-through text-[#FAF7F2]/50 font-sans">Higher rates + taxes & platform surcharges</span>
          </div>
          <span class="bg-red-500/15 text-red-300 border border-red-500/30 text-[10px] font-mono uppercase tracking-wider px-2.5 py-1 rounded-sm">
            OTA Commission Markups
          </span>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="text-[10px] font-sans uppercase tracking-[0.2em] text-[#C4A77D] font-bold block">Direct Host Resident Rate (WhatsApp / Call)</span>
            <div class="flex items-baseline gap-2 mt-0.5">
              <span class="text-2xl sm:text-3xl font-bold font-sans text-white">From ₹3,999 / night</span>
              <span class="text-xs text-[#FAF7F2]/70 font-sans">incl. breakfast</span>
            </div>
          </div>
          <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs font-sans font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-sm flex items-center gap-1.5 shadow-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Save up to 20% Direct
          </span>
        </div>
      </div>

      <!-- High-Intent Primary Conversion CTAs (Call Desk + WhatsApp + BookingJini) -->
      <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3.5 max-w-3xl mx-auto mb-8">
        <!-- Direct Phone Call CTA (High-Contrast Primary Mobile Driver) -->
        <a
          href={`tel:${RESORT_PHONE_TEL}`}
          data-track-fn="trackBookingConversion" data-track-args='["phone_call_click","engagement","hero_phone_call",{"conversion_type":"phone","phone_number":"7505029696"}]'
          class="w-full sm:w-auto flex-1 bg-[#FAF7F2] hover:bg-[#E5CFA0] text-[#03110B] border-2 border-[#B0966D] font-bold py-4 px-5 rounded-sm shadow-[0_8px_24px_rgba(0,0,0,0.35)] flex items-center justify-center gap-2 text-sm uppercase tracking-wider active:scale-[0.98] transition-all text-center"
        >
          <svg class="w-4 h-4 text-[#03110B] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call Desk: {RESORT_PHONE_DISPLAY}</span>
        </a>

        <!-- WhatsApp Concierge CTA -->
        <a
          href="https://wa.me/917505029696?text=Hi!%20I%20am%20viewing%20your%20direct%20booking%20page%20for%20Whispering%20Pines%20Resort.%20Could%20you%20please%20share%20room%20availability%20and%20your%20best%20direct%20rates%20for%20an%20upcoming%20stay%3F"
          target="_blank"
          rel="noopener noreferrer"
          data-track-fn="trackBookingConversion" data-track-args='["generate_lead","booking","hero_whatsapp_direct",{"conversion_type":"whatsapp","value":3500,"currency":"INR"}]'
          class="w-full sm:w-auto flex-1 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold py-4 px-6 rounded-sm shadow-[0_8px_24px_rgba(10,18,15,0.28)] flex items-center justify-center gap-2.5 text-sm uppercase tracking-wider active:scale-[0.98] transition-all border border-white/20 text-center relative group"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
