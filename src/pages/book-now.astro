  <!-- =========================================================================
       CLIENT JAVASCRIPT: LUXURY CONCIERGE CALCULATOR ENGINE
       ========================================================================= -->
  <script is:inline>
    (function () {
      // Hotel & Room Data Definition (Hotel is Primary, Rooms Secondary)
      const hotelOptions = {
        mukteshwar: {
          name: 'Mukteshwar: Whispering Pines Resort By Casa De Bello',
          location: 'Malla Ramgarh, Mukteshwar Ridge',
          rooms: [
            { id: 'villa', name: '3-BHK Private Alpine Villa (Fireplace & Orchard Lawn)', basePrice: 14999 },
            { id: 'suite', name: 'Deluxe Skylight Mountain Suite (Stargazing Glass Roof)', default: true, basePrice: 3499 },
            { id: 'family', name: 'Family Twin Orchard Room (Ground Floor Ease)', basePrice: 3999 }
          ]
        },
        kainchi: {
          name: 'Casa De Bello Resort- Kainchi Dham',
          location: 'Kehelkwira, Bhowali (9 km / 15 Mins to Ashram)',
          rooms: [
            { id: 'kainchi-room', name: 'Super Deluxe Valley Room (Private Balcony & Cafe)', default: true, basePrice: 2799 },
            { id: 'kainchi-suite', name: 'Executive Valley View Suite (Panoramic Valley Sit-Out)', basePrice: 3499 }
          ]
        },
        anurra: {
          name: 'Anurra Hotel- Kaincho Dham',
          location: 'Niglat Malla, Bhowali-Almora Highway (3.3 km / 6 Mins to Ashram)',
          rooms: [
            { id: 'anurra-deluxe', name: 'Deluxe Hill View Room (Private Balcony & Fast Wi-Fi)', default: true, basePrice: 3199 },
            { id: 'anurra-family', name: 'Grand Valley Family Room (Pure Veg Dining)', basePrice: 3999 }
          ]
        }
      };

      const hotelSelect = document.getElementById('calc-hotel');
      const roomSelect = document.getElementById('calc-room');
      const checkInInput = document.getElementById('calc-checkin');
      const checkOutInput = document.getElementById('calc-checkout');
      const guestsSelect = document.getElementById('calc-guests');
      const hotelDisplay = document.getElementById('calc-display-hotel');
      const roomDisplay = document.getElementById('calc-display-room');
      const nightsDisplay = document.getElementById('calc-display-nights');
      const whatsappBtn = document.getElementById('btn-whatsapp-submit');
      const mobileStickyWhatsapp = document.getElementById('mobile-sticky-whatsapp');

      // Initialize default dates: tomorrow and day after
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(today.getDate() + 1);
      const dayAfter = new Date(tomorrow);
      dayAfter.setDate(tomorrow.getDate() + 1);

      const toDateInputValue = (d) => d.toISOString().split('T')[0];
      if (checkInInput && checkOutInput) {
        checkInInput.value = toDateInputValue(tomorrow);
        checkOutInput.value = toDateInputValue(dayAfter);
        checkInInput.min = toDateInputValue(today);
        checkOutInput.min = toDateInputValue(tomorrow);
      }

      // Populate room dropdown according to selected hotel
      function populateRooms(hotelKey, preselectRoomId) {
        if (!roomSelect) return;
        roomSelect.innerHTML = '';
        const hotel = hotelOptions[hotelKey] || hotelOptions.mukteshwar;
        hotel.rooms.forEach(r => {
          const opt = document.createElement('option');
          opt.value = r.name;
          opt.textContent = r.name;
          if (preselectRoomId ? r.id === preselectRoomId : r.default) {
            opt.selected = true;
          }
          roomSelect.appendChild(opt);
        });
      }

      function updateCalculation() {
        if (!hotelSelect || !roomSelect || !checkInInput || !checkOutInput) return;

        const hotelKey = hotelSelect.value;
        const hotelInfo = hotelOptions[hotelKey] || hotelOptions.mukteshwar;
        const selectedRoom = roomSelect.value;
        const guests = guestsSelect ? guestsSelect.value : '2 Adults';

        const checkInVal = checkInInput.value;
        const checkOutVal = checkOutInput.value;

        let nights = 1;
        if (checkInVal && checkOutVal) {
          const diffMs = new Date(checkOutVal) - new Date(checkInVal);
          const calculated = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
          if (calculated > 0) nights = calculated;
        }

        if (hotelDisplay) hotelDisplay.textContent = `${hotelInfo.name} (${hotelInfo.location})`;
        if (roomDisplay) roomDisplay.textContent = selectedRoom;
        if (nightsDisplay) nightsDisplay.textContent = `${nights} night${nights > 1 ? 's' : ''} • ${guests}`;

        // Parse Ad & Campaign UTM Attribution (Session Storage + Live URL)
        let attributionTag = '';
        try {
          const rawAttr = sessionStorage.getItem('wpr_ads_attribution');
          const saved = rawAttr ? JSON.parse(rawAttr) : null;
          const urlParams = new URLSearchParams(window.location.search);
          const utmSource = urlParams.get('utm_source') || (saved && saved.utm_source);
          const utmCampaign = urlParams.get('utm_campaign') || (saved && saved.utm_campaign);
          const gclid = urlParams.get('gclid') || (saved && saved.gclid);
          if (utmSource || gclid) {
            attributionTag = `\n🏷️ *Source:* ${utmSource || 'Google Ads'}${utmCampaign ? ` (${utmCampaign})` : ''}${gclid ? ' [Verified Ad Click]' : ''}`;
          }
        } catch (e) {}

        // Build Structured Pre-Filled WhatsApp Payload
        const message = 
`Hi! I would like to check availability and direct booking rates at Casa De Bello Hospitality:

🏨 *Selected Hotel:* ${hotelInfo.name}
📍 *Location:* ${hotelInfo.location}
🏡 *Residence Option:* ${selectedRoom}
📅 *Check-In:* ${checkInVal || 'Flexible'}
📅 *Check-Out:* ${checkOutVal || 'Flexible'} (${nights} night${nights > 1 ? 's' : ''})
👥 *Guests:* ${guests}${attributionTag}

Please confirm live availability and share your best direct host tariff & photos!`;

        const encodedUrl = 'https://wa.me/917505029696?text=' + encodeURIComponent(message);

        // Calculate dynamic conversion value for Smart Bidding
        const currentRoomDef = hotelInfo.rooms.find(r => r.name === selectedRoom);
        const dynamicUnitPrice = currentRoomDef && currentRoomDef.basePrice ? currentRoomDef.basePrice : 3500;
        const totalEstimatedTariff = dynamicUnitPrice * nights;

        if (whatsappBtn) {
          whatsappBtn.onclick = function () {
            if (typeof window.trackBookingConversion === 'function') {
              window.trackBookingConversion('generate_lead', 'booking', 'calculator_whatsapp_submit', {
                conversion_type: 'whatsapp',
                hotel: hotelInfo.name,
                room: selectedRoom,
                nights: nights,
                value: totalEstimatedTariff,
                currency: 'INR'
              });
            } else if (typeof window.gtag === 'function') {
              window.gtag('event', 'generate_lead', {
                event_category: 'booking',
                event_label: 'calculator_whatsapp_submit',
                value: totalEstimatedTariff,
                currency: 'INR'
              });
            }
            window.open(encodedUrl, '_blank', 'noopener,noreferrer');
          };
        }

        if (mobileStickyWhatsapp) {
          mobileStickyWhatsapp.href = encodedUrl;
        }

        const desktopFloatingWhatsapp = document.getElementById('desktop-floating-whatsapp');
        if (desktopFloatingWhatsapp) {
          desktopFloatingWhatsapp.href = encodedUrl;
        }
      }

      if (hotelSelect) {
        hotelSelect.addEventListener('change', function () {
          populateRooms(hotelSelect.value);
          updateCalculation();
        });
      }
      if (roomSelect) roomSelect.addEventListener('change', updateCalculation);
      if (checkInInput) checkInInput.addEventListener('change', updateCalculation);
      if (checkOutInput) checkOutInput.addEventListener('change', updateCalculation);
      if (guestsSelect) guestsSelect.addEventListener('change', updateCalculation);

      // Initialize default dropdown state
      populateRooms('mukteshwar');
      updateCalculation();

      // Section 3 Property Tab Filtering Logic
      const tabs = document.querySelectorAll('#property-tabs .property-tab-btn');
      const cards = document.querySelectorAll('.accommodation-card');

      function filterCards(propertyKey) {
        tabs.forEach(btn => {
          if (btn.getAttribute('data-tab') === propertyKey) {
            btn.classList.add('bg-[#C9A832]', 'text-[#07150C]', 'shadow-lg');
            btn.classList.remove('bg-[#102618]', 'text-[#FAF7F2]');
          } else {
            btn.classList.remove('bg-[#C9A832]', 'text-[#07150C]', 'shadow-lg');
            btn.classList.add('bg-[#102618]', 'text-[#FAF7F2]');
          }
        });

        cards.forEach(card => {
          const cardProp = card.getAttribute('data-property');
          if (propertyKey === 'all' || cardProp === propertyKey) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }

      tabs.forEach(tab => {
        tab.addEventListener('click', function () {
          const target = this.getAttribute('data-tab');
          filterCards(target);
        });
      });

      // Section 2 Hotel Jump Buttons (Clicking "Explore ... Rooms ↓" activates corresponding tab & syncs form)
      const jumpButtons = document.querySelectorAll('.hotel-jump-btn');
      jumpButtons.forEach(btn => {
        btn.addEventListener('click', function () {
          const hotelKey = this.getAttribute('data-hotel-jump');
          if (hotelKey) {
            filterCards(hotelKey);
            if (hotelSelect) {
              hotelSelect.value = hotelKey;
              populateRooms(hotelKey);
              updateCalculation();
            }
          }
        });
      });

    })();
  </script>
</Layout>
