---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';

// Image Assets
import heroImgSrc from '../assets/images/Whispering-pines-balcony-view-nanital.avif';
import villaImgSrc from '../assets/images/villa_in_nanital.avif';
import suiteImgSrc from '../assets/images/Delux_room_Whispering_pines_mukteshwar.avif';
import familyImgSrc from '../assets/images/Family_Twin_Room_Near_nainital.avif';
import diningImgSrc from '../assets/images/Restaurant-cafe-ramgarh.avif';
import bathroomImgSrc from '../assets/images/delux-room-bathroom.avif';
import viewImgSrc from '../assets/images/outside-view-from-resort-hotel.avif';
import kainchiImgSrc from '../assets/images/casa-de-bello-kainchi-dham.avif';
import anurraImgSrc from '../assets/images/stay-near-kainchi-dham.avif';

const heroImage = await getImage({ src: heroImgSrc, format: 'webp', width: 1800, quality: 82 });
const heroMobile = await getImage({ src: heroImgSrc, format: 'webp', width: 800, quality: 78 });
const villaImg = await getImage({ src: villaImgSrc, format: 'webp', width: 900, quality: 80 });
const suiteImg = await getImage({ src: suiteImgSrc, format: 'webp', width: 900, quality: 80 });
const familyImg = await getImage({ src: familyImgSrc, format: 'webp', width: 900, quality: 80 });
const diningImg = await getImage({ src: diningImgSrc, format: 'webp', width: 900, quality: 80 });
const bathroomImg = await getImage({ src: bathroomImgSrc, format: 'webp', width: 900, quality: 80 });
const viewImg = await getImage({ src: viewImgSrc, format: 'webp', width: 900, quality: 80 });
const kainchiImg = await getImage({ src: kainchiImgSrc, format: 'webp', width: 900, quality: 80 });
const anurraImg = await getImage({ src: anurraImgSrc, format: 'webp', width: 900, quality: 80 });

const RESORT_PHONE_DISPLAY = "075050 29696";
const RESORT_PHONE_TEL = "+917505029696";
const BOOKING_ENGINE_URL = "https://casadebello-book.whisperingpinesresort.in/";
---

<Layout
  title="Direct Booking & Best Rates | Whispering Pines Resort Ramgarh"
  description="Book direct at Whispering Pines Resort Ramgarh to save 15–20% vs MakeMyTrip. Enjoy 180° Himalayan views, 24/7 hot geysers, fiber Wi-Fi & direct host perks."
  canonical="https://whisperingpinesresort.in/book-now/"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroMobile.src} media="(max-width: 768px)" fetchpriority="high" type="image/webp" />
    <link rel="preload" as="image" href={heroImage.src} media="(min-width: 769px)" fetchpriority="high" type="image/webp" />
    
    <!-- Schema.org Hotel, Offers & FAQ Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Hotel",
          "@id": "https://whisperingpinesresort.in/#hotel",
          "name": "Whispering Pines Resort by Casa De Bello",
          "url": "https://whisperingpinesresort.in/book-now/",
          "image": "https://whisperingpinesresort.in/og-image.webp",
          "telephone": "+91-7505029696",
          "priceRange": "₹2,799 - ₹15,999",
          "currenciesAccepted": "INR",
          "paymentAccepted": "Cash, Credit Card, UPI, Bank Transfer",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Road",
            "addressLocality": "Mukteshwar, Nainital",
            "postalCode": "263137",
            "addressRegion": "Uttarakhand",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 29.4385,
            "longitude": 79.5532
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.6",
            "reviewCount": "412",
            "bestRating": "5",
            "worstRating": "1"
          },
          "amenityFeature": [
            { "@type": "LocationFeatureSpecification", "name": "24/7 Instant Hot Geyser Water", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "100% Uninterrupted Power Backup", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "100 Mbps High Speed Fiber Wi-Fi", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Private Paved Drive-in Car Parking", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Fresh Farm-to-Table Kumaoni Dining", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "180° Panoramic Himalayan Snow Peak Views", "value": true }
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://whisperingpinesresort.in/book-now/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Why is booking directly on WhatsApp or Call cheaper than MakeMyTrip or Booking.com?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Third-party booking platforms (OTAs) charge hotels between 18% to 22% in commission fees plus convenience fees. When you book directly with our front desk, we bypass middleman fees entirely and transfer 100% of those savings to you, guaranteeing a 15% to 20% lower tariff along with complimentary Kumaoni welcome tea."
              }
            },
            {
              "@type": "Question",
              "name": "Is the road to Whispering Pines Resort suitable for hatchbacks and luxury sedans?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, absolutely. Unlike secluded cottages that require hazardous off-roading down dirt tracks, Whispering Pines Resort is situated directly on the smooth, paved Bhowali-Ramgarh-Mukteshwar highway. Any hatchback, luxury sedan, or SUV can easily drive right up to our gated private parking area."
              }
            },
            {
              "@type": "Question",
              "name": "Is there reliable hot water and power backup during cold mountain days?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Every private room and suite features a dedicated high-capacity electric geyser for 24/7 instant hot water. In addition, the property is backed by an automated 100% generator power backup system that operates heaters, lighting, and 100 Mbps optical fiber Wi-Fi throughout any regional power outages."
              }
            }
          ]
        }
      ]
    })} />

    <!-- Google Ads Conversion Mapping & Session Attribution Engine -->
    <script is:inline>
      (function() {
        var ADS_ID = 'AW-18226439390';
        var ADS_PHONE = 'AW-18226439390/Vc_dCNLMo_UcEN7JhfND';

        // 1. Session-Level Attribution Store
        try {
          var params = new URLSearchParams(window.location.search);
          var gclid = params.get('gclid') || params.get('gbraid') || params.get('wbraid');
          var utmSource = params.get('utm_source');
          var utmCampaign = params.get('utm_campaign');
          var utmMedium = params.get('utm_medium');
          var utmContent = params.get('utm_content');

          if (gclid || utmSource || utmCampaign) {
            var attribution = {
              gclid: gclid || '',
              utm_source: utmSource || '',
              utm_campaign: utmCampaign || '',
              utm_medium: utmMedium || '',
              utm_content: utmContent || '',
              timestamp: Date.now()
            };
            sessionStorage.setItem('wpr_ads_attribution', JSON.stringify(attribution));
          }
        } catch (e) {}

        // 2. Global Universal Conversion Dispatcher
        window.trackBookingConversion = function(action, category, label, extra) {
          extra = extra || {};
          window.dataLayer = window.dataLayer || [];

          // Enrich with stored attribution if available
          try {
            var rawAttr = sessionStorage.getItem('wpr_ads_attribution');
            if (rawAttr) {
              var saved = JSON.parse(rawAttr);
              if (saved.gclid && !extra.gclid) extra.gclid = saved.gclid;
              if (saved.utm_source && !extra.utm_source) extra.utm_source = saved.utm_source;
              if (saved.utm_campaign && !extra.utm_campaign) extra.utm_campaign = saved.utm_campaign;
            }
          } catch (e) {}

          var payload = Object.assign({
            event: action,
            event_category: category || 'booking',
            event_label: label || 'direct_booking',
          }, extra);

          // Push to GTM dataLayer
          window.dataLayer.push(payload);

          // Dispatch to Google Tag (gtag)
          if (typeof window.gtag === 'function') {
            window.gtag('event', action, payload);

            if (action === 'generate_lead') {
              window.gtag('event', 'conversion', {
                send_to: ADS_ID,
                value: extra.value,
                currency: extra.currency || (extra.value ? 'INR' : undefined),
                transaction_id: 'lead_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7)
              });
            } else if (action === 'phone_call_click') {
              window.gtag('event', 'conversion', {
                send_to: ADS_PHONE,
                phone_conversion_number: extra.phone_number || '7505029696'
              });
            } else if (action === 'begin_checkout') {
              window.gtag('event', 'conversion', {
                send_to: ADS_ID,
                value: extra.value,
                currency: extra.currency || (extra.value ? 'INR' : undefined)
              });
            }
          }
        };

        // Backward compatibility alias
        window.trackAdsConversion = window.trackBookingConversion;
      })();
    </script>
  </Fragment>

  <!-- =========================================================================
       SECTION 0: PRE-HEADER ROYAL EMBLEM RIBBON (TAJ & CLUB MAHINDRA BENCHMARK)
       ========================================================================= -->
  <aside aria-label="Direct host privilege banner" class="bg-[#07150C] text-[#FAF7F2] border-b border-[#C9A832]/30 py-2.5 px-4 text-xs font-sans tracking-wide relative z-20">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-center sm:text-left">
      <!-- Left: Prestigious Status -->
      <div class="flex items-center gap-2 mx-auto sm:mx-0">
        <span class="inline-flex items-center gap-1.5 text-[#C9A832] font-mono uppercase tracking-[0.2em] text-[10px] font-bold">
          <span class="w-2 h-2 rounded-full bg-[#C9A832] animate-pulse"></span>
          Direct Resident Privilege
        </span>
        <span class="text-[#FAF7F2]/40 hidden md:inline">|</span>
        <span class="text-[#FAF7F2]/80 text-[11px] hidden md:inline">
          Save 15%–20% vs. MakeMyTrip & Agoda • Zero Commission Markups • Priority Suite Allocation
        </span>
      </div>

      <!-- Right: Direct WhatsApp & Phone Desk -->
      <div class="flex items-center gap-2.5 sm:gap-3 mx-auto sm:mx-0">
        <span class="hidden lg:inline-flex items-center gap-1.5 text-[11px] text-[#FAF7F2]/75 font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Host Desk Active Now
        </span>
        <a
          href="https://wa.me/917505029696?text=Hi!%20I%20am%20viewing%20your%20direct%20booking%20page%20for%20Whispering%20Pines%20Resort.%20Could%20you%20please%20share%20room%20availability%20and%20your%20best%20direct%20rates%3F"
          target="_blank"
          rel="noopener noreferrer"
          onclick="if(typeof window.trackBookingConversion==='function'){window.trackBookingConversion('generate_lead','booking','top_ribbon_whatsapp',{conversion_type:'whatsapp'});}"
          class="inline-flex items-center gap-1.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-mono text-[11px] font-bold px-3 py-1 rounded-full shadow-sm active:scale-95 transition-all"
          title="Chat directly on WhatsApp with front desk"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>WhatsApp Concierge</span>
        </a>
        <a
          href={`tel:${RESORT_PHONE_TEL}`}
          onclick="if(typeof window.trackBookingConversion==='function'){window.trackBookingConversion('phone_call_click','engagement','top_ribbon_phone_call',{conversion_type:'phone',phone_number:'7505029696'});}"
          class="inline-flex items-center gap-1.5 font-mono text-xs font-bold text-[#E5C365] hover:text-[#FAF7F2] transition-colors underline decoration-[#C9A832]/50 underline-offset-4"
        >
          <svg class="w-3.5 h-3.5 text-[#C9A832]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="hidden sm:inline">Direct Desk:</span> {RESORT_PHONE_DISPLAY}
        </a>
      </div>
    </div>
  </aside>

  <!-- =========================================================================
       SECTION 1: HERO ENCLAVE — THE HIMALAYAN SANCTUARY (ARISTOCRATIC RESTRAINT)
       ========================================================================= -->
  <section class="relative min-h-[94vh] flex items-center justify-center bg-[#07150C] text-[#FAF7F2] overflow-hidden">
    <!-- Cinematic Panoramic Background with Subtle Vignette -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <picture>
        <source srcset={heroMobile.src} media="(max-width: 768px)" type="image/webp" />
        <img
          src={heroImage.src}
          alt="Panoramic private balcony view of Nanda Devi Himalayan mountain range from Whispering Pines Resort Ramgarh"
          class="w-full h-full object-cover opacity-35 scale-105 motion-safe:animate-[pulse_10s_ease-in-out_infinite] motion-safe:duration-[10000ms]"
          loading="eager"
          decoding="async"
          width="1800"
          height="1200"
        />
      </picture>
      <!-- Dual Atmospheric Vignette for Editorial Elegance -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#07150C] via-[#07150C]/65 to-[#07150C]/40"></div>
      <div class="absolute inset-0 bg-radial from-transparent via-[#07150C]/30 to-[#07150C]/90"></div>
    </div>

    <!-- Aristocratic Watermark Filigree Border -->
    <div class="absolute inset-4 sm:inset-8 border border-[#C9A832]/20 pointer-events-none z-10 hidden sm:block">
      <div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-[#C9A832]"></div>
      <div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-[#C9A832]"></div>
      <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-[#C9A832]"></div>
      <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-[#C9A832]"></div>
    </div>

    <!-- Main Hero Presentation Container -->
    <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-14 pb-24">
      
      <!-- Taj Imperial Crest & Verified Google Rating Badge -->
      <div class="inline-flex flex-col sm:flex-row items-center gap-2 bg-[#0E2316]/90 border border-[#C9A832]/40 backdrop-blur-xl px-5 py-2 rounded-full mb-8 shadow-2xl">
        <div class="flex items-center gap-1 text-[#E5C365]">
          <span class="text-sm tracking-tighter">★★★★★</span>
        </div>
        <span class="font-mono text-xs text-[#FAF7F2] font-semibold tracking-wider uppercase">
          4.6★ Excellence Score (400+ Verified Google Reviews)
        </span>
        <span class="hidden sm:inline text-[#C9A832]/60">•</span>
        <span class="text-[11px] text-[#FAF7F2]/80 font-sans tracking-wide">
          Malla Ramgarh, Mukteshwar (1,780m Altitude)
        </span>
      </div>

      <!-- Main Benefit-Driven Royal Headline -->
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight text-[#FAF7F2] leading-[1.12] max-w-4xl mx-auto mb-6 text-balance">
        The Mountain Serenity of Ramgarh. <br class="hidden sm:inline" />
        <span class="italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#FAF7F2] via-[#E5C365] to-[#FAF7F2]">
          Direct Host Privileges, Zero Middleman Fees.
        </span>
      </h1>

      <!-- Editorial Subcopy (Concrete, Grounded, Zero AI Slop) -->
      <p class="font-sans text-base sm:text-lg md:text-xl text-[#FAF7F2]/85 font-light max-w-2xl mx-auto leading-relaxed mb-10 text-pretty">
        Positioned directly on the smooth, paved Mukteshwar highway with 180° unobstructed Nanda Devi vistas. Enjoy pristine sanitised rooms, 24/7 high-pressure hot water geysers, 100 Mbps fiber Wi-Fi, and authentic home-style Kumaoni culinary heritage.
      </p>

      <!-- The Taj-Inspired "Direct Resident Privilege Pass" (Price Disparity Card) -->
      <div class="max-w-xl mx-auto mb-10 bg-[#0E2316]/85 backdrop-blur-md border border-[#C9A832]/40 rounded-xl p-5 sm:p-6 text-left shadow-[0_12px_40px_rgba(0,0,0,0.6)] relative overflow-hidden">
        <!-- Subtle Top Gold Trim -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#C9A832] to-transparent"></div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-[#FAF7F2]/10 pb-4 mb-4">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#FAF7F2]/60 block">Third-Party Portals (MakeMyTrip / Agoda)</span>
            <span class="text-sm line-through text-[#FAF7F2]/50 font-sans">₹3,499 – ₹18,999 + taxes & platform surcharges</span>
          </div>
          <span class="bg-red-500/15 text-red-300 border border-red-500/30 text-[10px] font-mono uppercase tracking-wider px-2.5 py-1 rounded">
            +18% OTA Commission Markups
          </span>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#E5C365] font-bold block">Direct Host Resident Rate (WhatsApp / Call)</span>
            <div class="flex items-baseline gap-2 mt-0.5">
              <span class="text-2xl sm:text-3xl font-bold font-sans text-white">From ₹2,799 / night</span>
              <span class="text-xs text-[#FAF7F2]/70 font-mono">all-inclusive</span>
            </div>
          </div>
          <span class="bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs font-mono font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-md flex items-center gap-1.5 shadow-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Save ~₹700 to ₹3,200 Direct
          </span>
        </div>
      </div>

      <!-- High-Intent Primary Conversion CTAs (BookingJini + WhatsApp + Call Desk) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 max-w-2xl mx-auto mb-8">
        <!-- BookingJini Instant Online Booking CTA -->
        <a
          href={BOOKING_ENGINE_URL}
          target="_blank"
          rel="noopener noreferrer"
          onclick="if(typeof window.trackBookingConversion==='function'){window.trackBookingConversion('begin_checkout','booking','hero_bookingjini_checkout',{conversion_type:'bookingjini'});}"
          class="w-full sm:w-auto flex-1 bg-[#C9A832] hover:bg-[#E5C365] text-[#07150C] font-bold py-4 px-6 rounded-md shadow-2xl flex items-center justify-center gap-2 text-sm uppercase tracking-wider active:scale-[0.98] transition-all btn-shimmer text-center"
        >
          <svg class="w-4 h-4 text-[#07150C]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Book Online (BookingJini)</span>
        </a>

        <!-- WhatsApp Concierge CTA (Primary Hero Driver) -->
        <a
          href="https://wa.me/917505029696?text=Hi!%20I%20am%20viewing%20your%20direct%20booking%20page%20for%20Whispering%20Pines%20Resort.%20Could%20you%20please%20share%20room%20availability%20and%20your%20best%20direct%20rates%20for%20an%20upcoming%20stay%3F"
          target="_blank"
          rel="noopener noreferrer"
          onclick="if(typeof window.trackBookingConversion==='function'){window.trackBookingConversion('generate_lead','booking','hero_whatsapp_direct',{conversion_type:'whatsapp',value:3500,currency:'INR'});}"
          class="w-full sm:w-auto flex-1 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold py-4 px-6 rounded-md shadow-[0_10px_35px_rgba(37,211,102,0.4)] flex items-center justify-center gap-2.5 text-sm uppercase tracking-wider active:scale-[0.98] transition-all ring-4 ring-[#25D366]/30 border border-white/20 text-center relative group"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-85"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
