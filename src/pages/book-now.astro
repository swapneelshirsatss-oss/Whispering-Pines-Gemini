---
import LandingLayout from '../layouts/LandingLayout.astro';
import DirectBookingCalculator from '../components/DirectBookingCalculator.astro';
import { Image, getImage } from 'astro:assets';

// Image Assets
import heroImgSrc from '../assets/images/Whispering-pines-balcony-view-nanital.avif';
// Phones get the valley view: the terrace shot crops to the chimney and floor tiles
// on a tall screen, which is the opposite of the 180-degree view the H1 promises.
import heroMobileSrc from '../assets/images/whispering-pines-balcony-valley-view.jpg';
import diningImgSrc from '../assets/images/Restaurant-cafe-ramgarh.avif';
import bathroomImgSrc from '../assets/images/delux-room-bathroom.avif';
import viewImgSrc from '../assets/images/outside-view-from-resort-hotel.avif';
// Room photography supplied by the client, matched to the BookingJini room names.
import deluxeRoomImgSrc from '../assets/images/rooms/Deluxe-Rooms-with-Himalayan-View.avif';
import premiumRoomImgSrc from '../assets/images/rooms/Premium-room-with-Himalayan-view.avif';
import cottageRoomImgSrc from '../assets/images/rooms/Cottage-Room-With-Himalayan-View.avif';
import familyRoomImgSrc from '../assets/images/rooms/Family-Twin-Bed-Room-With-Himalayan-View.avif';
// Low-detail cloud-sea frame: the one photo in the library that stays readable behind text.
import quoteImgSrc from '../assets/images/view-from-resort-cloud-sea.jpg';

// Hero renders at opacity-30 behind two gradient scrims, so quality/width are tuned down:
// the preloaded LCP bytes drop sharply with no visible difference.
const heroImage = await getImage({ src: heroImgSrc, format: 'webp', width: 1440, quality: 62 });
const heroMobile = await getImage({ src: heroMobileSrc, format: 'webp', width: 760, quality: 64 });
const diningImg = await getImage({ src: diningImgSrc, format: 'webp', width: 900, quality: 80 });
const bathroomImg = await getImage({ src: bathroomImgSrc, format: 'webp', width: 900, quality: 80 });
const viewImg = await getImage({ src: viewImgSrc, format: 'webp', width: 900, quality: 80 });
const quoteImg = await getImage({ src: quoteImgSrc, format: 'webp', width: 1600, quality: 62 });
const quoteImgMobile = await getImage({ src: quoteImgSrc, format: 'webp', width: 800, quality: 58 });

// Rooms ordered entry tariff -> flagship. Names, images and tariffs mirror the live
// BookingJini engine (url.bookingjini.com/be/8811, read 27 Nov 2026): price = CP
// (room + daily breakfast), mapPrice = MAP (room + breakfast + dinner), both ex-GST.
// The rest of the site still carries the older room names and tariffs.
const ROOM_CARDS = [
  {
    id: 'deluxe', name: 'Deluxe Rooms with Himalayan View', price: '₹3,500', mapPrice: '₹4,000', value: 3500,
    img: deluxeRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Malla Ramgarh • Entry Himalayan-View Room',
    alt: 'Deluxe Room with Himalayan view at Whispering Pines Resort, Malla Ramgarh, Mukteshwar',
    text: 'Our entry tariff among hotels near Mukteshwar: a king-bed room facing the snow line, en-suite bath with 24/7 hot water and radiator heating. Limited inventory, so it goes first on weekends.',
    tags: ['King Bed', 'Himalayan View', 'En-Suite Bath'],
  },
  {
    id: 'premium', name: 'Premium room with Himalayan view', price: '₹5,500', mapPrice: '₹6,500', value: 5500,
    img: premiumRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Malla Ramgarh • Himalayan-View Premium Room',
    alt: 'Premium Room with queen bed and Himalayan view at Whispering Pines Resort, Mukteshwar',
    text: 'Our most-booked room among hotels near Mukteshwar: cedar-panelled walls, a heated queen-bed room facing the Himalayas and an en-suite bath with 24/7 hot water. The easiest way into a 4-star resort stay at 1,780 m.',
    tags: ['Heated Room', '180° Snow View', 'En-Suite Bath'],
  },
  {
    id: 'cottage', name: 'Cottage Room With Himalayan View', price: '₹7,500', mapPrice: '₹8,500', value: 7500,
    img: cottageRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Malla Ramgarh • Garden Cottage Room',
    alt: 'Cottage Room with garden sit-out and Himalayan view at Whispering Pines Resort, Mukteshwar',
    text: 'A standalone cottage-style room with its own garden sit-out, a king bed, an en-suite bath with 24/7 hot water and the same 180° Himalayan view every room at the resort enjoys.',
    tags: ['Garden Sit-out', 'King Bed', 'Himalayan View'],
  },
  {
    id: 'familysuite', name: 'Family Twin-Bed Room With Himalayan View', price: '₹10,000', mapPrice: '₹12,000', value: 10000,
    img: familyRoomImgSrc, sleeps: 'Sleeps 4 Guests', featured: true,
    eyebrow: 'Malla Ramgarh • Family Twin-Bed Room',
    alt: 'Family Twin-Bed Room with Himalayan view and private balcony at Whispering Pines Resort, Mukteshwar',
    text: 'Cedar pine panels, twin king beds and a valley-view balcony facing Nanda Devi — one room that takes a family of four without a rollaway or a second booking.',
    tags: ['Twin King Beds', 'Valley Balcony', 'Himalayan View'],
  },
];

const RESORT_PHONE_DISPLAY = "075050 29696";
const RESORT_PHONE_TEL = "+917505029696";
---

<LandingLayout
  title="4-Star Resort Near Mukteshwar | Hotels in Mukteshwar ₹5,500+"
  description="Official direct booking for Whispering Pines Resort in Malla Ramgarh — a 4-star resort & luxury hotel near Mukteshwar. 180° Himalayan views, rooms from ₹5,500 incl. breakfast. Save up to 20% direct."
  canonical="https://whisperingpinesresort.in/book-now/"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroMobile.src} media="(max-width: 768px)" fetchpriority="high" type="image/webp" />
    <link rel="preload" as="image" href={heroImage.src} media="(min-width: 769px)" fetchpriority="high" type="image/webp" />
    
    <!-- Schema.org Hotel, Offers & FAQ Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Hotel",
          "@id": "https://whisperingpinesresort.in/#hotel",
          "name": "Whispering Pines Resort by Casa De Bello Mukteshwar Road",
          "url": "https://whisperingpinesresort.in/",
          "image": "https://whisperingpinesresort.in/og-image.webp",
          "telephone": "+91-7505029696",
          "priceRange": "₹5,500 - ₹12,000",
          "currenciesAccepted": "INR",
          "paymentAccepted": "Cash, Credit Card, UPI, Bank Transfer",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd, Mukteshwar, Nainital, Uttarakhand 263137",
            "addressLocality": "Mukteshwar",
            "postalCode": "263137",
            "addressRegion": "Uttarakhand",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 29.4260969,
            "longitude": 79.5506794
          },
          "hasMap": "https://maps.google.com/?cid=8386667112972057918",
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.6",
            "reviewCount": "428",
            "bestRating": "5",
            "worstRating": "1"
          },
          "amenityFeature": [
            { "@type": "LocationFeatureSpecification", "name": "24/7 Instant Hot Geyser Water", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "100% Uninterrupted Power Backup", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "150 Mbps Enterprise Fiber Wi-Fi", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Private Paved Drive-in Car Parking", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Fresh Farm-to-Table Kumaoni Dining", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "180° Panoramic Himalayan Snow Peak Views", "value": true }
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://whisperingpinesresort.in/book-now/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Is Whispering Pines one of the hotels in Mukteshwar, and how far is Mukteshwar Dham?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Whispering Pines Resort is 25 km from Mukteshwar Dham, about a 45 minute drive along the smooth, paved Bhowali–Ramgarh–Mukteshwar highway, in Malla Ramgarh at 1,780 m. Compared with a room in the town centre, you get unobstructed 180° Nanda Devi and Trishul snow-peak views, no narrow town traffic jams, gated drive-in parking for 25+ cars, 24/7 hot water, 100% power backup, 150 Mbps fiber Wi-Fi, and 100% pet-friendly orchard lawns with a ₹0 pet surcharge. The trade-off is honest: Mukteshwar town’s shops and the Dham itself are a 45 minute drive away rather than a short walk."
              }
            },
            {
              "@type": "Question",
              "name": "Why is booking directly on WhatsApp or by phone cheaper than a booking site?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Booking sites charge the hotel a commission and add a convenience fee at checkout. Book with the front desk on WhatsApp or by phone and neither applies, which is where the saving of up to 20% comes from. Welcome tea is on the house either way."
              }
            },
            {
              "@type": "Question",
              "name": "Is the road to Whispering Pines Resort suitable for hatchbacks and luxury sedans?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The resort is on the paved Bhowali-Ramgarh-Mukteshwar road, with no unpaved stretch at the end. The driveway runs straight into gated parking that takes hatchbacks, sedans and SUVs."
              }
            },
            {
              "@type": "Question",
              "name": "Is there reliable hot water and power backup during cold mountain days?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Every private room and suite features a dedicated high-capacity electric geyser for 24/7 instant hot water. In addition, the property is backed by an automated 100% generator power backup system that operates heaters, lighting, and 150 Mbps optical fiber Wi-Fi throughout any regional power outages."
              }
            },
            {
              "@type": "Question",
              "name": "What are the cancellation, refund and GST terms?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Cancellation and refund terms follow standard hotel industry practice and depend on your stay dates and how far ahead you cancel. Our booking desk confirms the exact terms for your dates on WhatsApp or phone before you pay anything. GST is charged on room tariffs as per Government of India rules and is shown on your booking confirmation and invoice."
              }
            }
          ]
        }
      ]
    })} />

  </Fragment>

  <!-- =========================================================================
       SECTION 1: HERO — mobile-first.
       Phones: the photo is its own 170px band at full brightness (no scrim), and
       the copy sits below it on cream. Separating them is what makes the photo
       visible at all — text over a photo on a phone needs a scrim so heavy it
       was rendering the image at ~6% effective visibility.
       sm+ : the photo goes back to full-bleed behind the copy, with scrims.
       Order is conversion-first: badge, H1, promise, price, CTAs — then the
       long keyword copy and the OTA comparison, which cost 543px and do not
       belong above the fold.
       ========================================================================= -->
  <section class="relative bg-[#FAF9F6] sm:bg-[#03110B] sm:min-h-[88svh] sm:flex sm:items-center sm:justify-center overflow-hidden">

    <div class="relative h-[170px] sm:absolute sm:inset-0 sm:h-auto sm:z-0 pointer-events-none">
      <picture>
        <source srcset={heroMobile.src} media="(max-width: 768px)" type="image/webp" />
        <img
          src={heroImage.src}
          alt="180° view of the Nanda Devi Himalayan range from a private balcony at Whispering Pines Resort, Malla Ramgarh"
          class="w-full h-full object-cover sm:opacity-60"
          loading="eager" fetchpriority="high"
          width="1800" height="1200"
        />
      </picture>
      {/* Scrims exist only where text sits on the photo, i.e. sm and up */}
      <div class="hidden sm:block absolute inset-0 bg-gradient-to-t from-[#03110B] via-[#03110B]/60 to-[#03110B]/40"></div>
      <div class="hidden sm:block absolute inset-0 bg-radial from-[#03110B]/20 via-[#03110B]/45 to-[#03110B]/90"></div>
    </div>

    <div class="hidden sm:block absolute inset-8 border border-[#B0966D]/20 pointer-events-none z-10">
      <div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-[#B0966D]"></div>
      <div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-[#B0966D]"></div>
      <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-[#B0966D]"></div>
      <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-[#B0966D]"></div>
    </div>

    <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-7 pb-12 sm:pt-14 sm:pb-24">

      <!-- Proof: one line on phones, where the old three-line badge cost 103px -->
      <p class="inline-flex flex-wrap items-center justify-center gap-x-2 text-xs sm:text-sm font-sans font-semibold text-[#7A6038] sm:text-[#C4A77D] mb-3 sm:mb-6">
        <span class="tracking-tighter text-[#B0966D]">★★★★★</span>
        <span>4.6 from 428 Google reviews</span>
        <span class="text-[#8A6F4A]/60 sm:text-[#B0966D]/60">•</span>
        <span class="font-normal text-[#44564E] sm:text-[#FAF7F2]/80">Malla Ramgarh, 1,780 m</span>
      </p>

      <h1 class="font-display text-[27px] leading-[1.14] sm:text-5xl md:text-6xl lg:text-7xl sm:leading-[1.12] font-semibold tracking-tight text-[#0E2C21] sm:text-[#FAF7F2] max-w-4xl mx-auto mb-3 sm:mb-5 text-balance sm:drop-shadow-[0_2px_14px_rgba(0,0,0,0.7)]">
        4-Star Resort Near Mukteshwar
      </h1>

      <!-- Was an <h1> span rendering at the full 36px, which alone cost ~130px -->
      <p class="font-sans text-[15px] sm:text-lg text-[#44564E] sm:text-[#FAF7F2]/90 max-w-xl mx-auto leading-snug mb-4 sm:mb-6 text-pretty">
        Luxury hotel &amp; villa • 180° Nanda Devi snow views • 25 km (45 min) from Mukteshwar Dham • Save up to 20% direct
      </p>

      <!-- Compact price line. The full OTA comparison still exists, lower down. -->
      <p class="font-sans text-[15px] sm:text-base text-[#0E2C21] sm:text-[#FAF7F2] mb-5 sm:mb-7">
        <span class="font-bold">From ₹5,500 / night</span>&nbsp;<span class="text-[#44564E] sm:text-[#FAF7F2]/75">incl. breakfast</span>
      </p>

      <!-- CTAs, now above the fold on a 360px phone -->
      <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 max-w-3xl mx-auto mb-5 sm:mb-8">
        <a
          href={`tel:${RESORT_PHONE_TEL}`}
          data-track-fn="trackBookingConversion" data-track-args='["phone_call_click","engagement","hero_phone_call",{"conversion_type":"phone","phone_number":"7505029696"}]'
          class="w-full sm:w-auto sm:flex-1 bg-[#03110B] sm:bg-[#FAF7F2] hover:bg-[#051E14] sm:hover:bg-[#E5CFA0] text-[#FAF7F2] sm:text-[#03110B] border-2 border-[#B0966D] font-bold min-h-14 py-4 px-5 rounded-sm shadow-[0_8px_24px_rgba(0,0,0,0.25)] flex items-center justify-center gap-2 text-sm uppercase tracking-wider active:scale-[0.98] transition-all text-center"
        >
          <svg class="w-4 h-4 text-[#E5CFA0] sm:text-[#03110B] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call {RESORT_PHONE_DISPLAY}</span>
        </a>

        <a
          href="https://wa.me/917505029696?text=Hi!%20I%20am%20viewing%20your%20direct%20booking%20page%20for%20Whispering%20Pines%20Resort.%20Could%20you%20please%20share%20room%20availability%20and%20your%20best%20direct%20rates%20for%20an%20upcoming%20stay%3F"
          target="_blank"
          rel="noopener noreferrer"
          data-track-fn="trackBookingConversion" data-track-args='["generate_lead","booking","hero_whatsapp_direct",{"conversion_type":"whatsapp","value":5500,"currency":"INR"}]'
          class="w-full sm:w-auto sm:flex-1 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold min-h-14 py-4 px-6 rounded-sm shadow-[0_8px_24px_rgba(10,18,15,0.28)] flex items-center justify-center gap-2.5 text-sm uppercase tracking-wider active:scale-[0.98] transition-all border border-white/20 text-center"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span class="tracking-wide">WhatsApp (Up to 20% Off)</span>
        </a>
      </div>

      <div class="flex flex-wrap justify-center items-center gap-y-2 gap-x-5 text-xs text-[#44564E] sm:text-[#FAF7F2]/80 font-sans mb-8 sm:mb-0">
        <span class="flex items-center gap-1.5"><span class="text-[#7A6038]">✓</span> Reply in &lt; 5 minutes</span>
        <span class="flex items-center gap-1.5"><span class="text-[#7A6038]">✓</span> 100% pet-friendly · ₹0 pet fee</span>
        <a href="#accommodations" class="flex items-center gap-1.5 underline decoration-[#8A6F4A]/40 underline-offset-4"><span class="text-[#7A6038]">✓</span> Cottage &amp; family rooms</a>
      </div>

      <!-- Keyword copy and the OTA comparison: below the CTAs, where their 543px is affordable -->
      <p class="font-sans text-[15px] sm:text-lg md:text-xl text-[#44564E] sm:text-[#FAF7F2]/95 font-light max-w-2xl mx-auto leading-relaxed mt-0 sm:mt-10 mb-7 text-pretty sm:drop-shadow-[0_1px_6px_rgba(0,0,0,0.6)]">
        Whispering Pines Resort is one of the hotels in Mukteshwar that sits on the open ridge instead of the town centre: we are in Malla Ramgarh on the Bhowali–Ramgarh–Mukteshwar Rd, 25 km (45 min) from Mukteshwar Dham, at 1,780 m. Heated Himalayan-view Deluxe and Premium Rooms, a garden Cottage Room and a Family Twin-Bed Room for four, plus a complimentary evening bonfire setup, gated parking for 25+ cars and 150 Mbps fiber Wi-Fi.
      </p>

      <div class="max-w-xl mx-auto bg-[#051E14] sm:bg-[#051E14]/85 sm:backdrop-blur-md border border-[#B0966D]/40 rounded-sm p-5 sm:p-6 text-left shadow-[0_12px_40px_rgba(0,0,0,0.3)] relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#B0966D] to-transparent"></div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-[#FAF7F2]/10 pb-4 mb-4">
          <div>
            <span class="text-xs font-sans uppercase tracking-[0.18em] text-[#FAF7F2]/70 block">On a booking site</span>
            <span class="text-sm line-through text-[#FAF7F2]/50 font-sans">Higher rate, plus tax and the booking fee</span>
          </div>
          <span class="bg-red-500/15 text-red-300 border border-red-500/30 text-xs font-mono uppercase tracking-wider px-2.5 py-1 rounded-sm">
            Commission + fees
          </span>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div>
            <span class="text-xs font-sans uppercase tracking-[0.18em] text-[#C4A77D] font-bold block">Booking direct, on WhatsApp or by phone</span>
            <div class="flex items-baseline gap-2 mt-0.5">
              <span class="text-2xl sm:text-3xl font-bold font-sans text-white">From ₹5,500 / night</span>
              <span class="text-xs text-[#FAF7F2]/70 font-sans">incl. breakfast</span>
            </div>
          </div>
          <span class="bg-[#B0966D]/20 text-[#E5CFA0] border border-[#B0966D]/50 text-xs font-sans font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-sm flex items-center gap-1.5 shadow-md">
            <span class="w-2 h-2 rounded-full bg-[#C4A77D]"></span>
            Save up to 20% Direct
          </span>
        </div>
      </div>

    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: ROOMS
       ========================================================================= -->
  <section id="accommodations" class="py-20 lg:py-28 bg-[#FAF9F6] text-[#2C3531] border-b border-[#8A6F4A]/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-sans font-bold tracking-[0.1em] text-[#7A6038] uppercase block mb-3">
          Deluxe, Premium, Cottage &amp; Family Rooms
        </span>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-semibold text-[#0E2C21] leading-tight">
          Rooms, Cottage &amp; Family Rooms at Our Resort in Mukteshwar
        </h2>
        <div class="w-16 h-0.5 bg-[#B0966D] mx-auto my-4"></div>
        <p class="text-sm text-[#44564E] leading-relaxed">
          Every room below is at Whispering Pines Resort, Malla Ramgarh (Mukteshwar Rd). CP is the room with daily breakfast; MAP adds dinner. Rates are before GST.
        </p>
      </div>

      <!-- Accommodations Grid (Grouped & Filterable by Hotel) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12" id="accommodations-grid">
        
        {ROOM_CARDS.map((room) => (
        <div class={`accommodation-card bg-white rounded-sm overflow-hidden shadow-md flex flex-col group ${room.featured ? 'border border-[#8A6F4A]/40 relative ring-2 ring-[#B0966D]/45' : 'border border-[#8A6F4A]/25'}`}>
          <div class="relative h-64 overflow-hidden">
            <Image
              src={room.img}
              alt={room.alt}
              widths={[400, 700, 900]}
              sizes="(max-width: 767px) 92vw, (max-width: 1200px) 46vw, 560px"
              quality={70}
