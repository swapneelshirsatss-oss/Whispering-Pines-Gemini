---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ReviewsHeader from "../components/ReviewsHeader.astro";
import TestimonialList from "../components/TestimonialList";
import RecentBookingNotification from "../components/RecentBookingNotification";
---

<Layout 
  title="Guest Reviews (4.6★ / 433+) | Whispering Pines Mukteshwar" 
  description="Read 433+ verified guest reviews for Whispering Pines Resort near Mukteshwar (Malla Ramgarh). See why families, couples, and groups rate our 180° views 4.6★."
>
  {/* No page-level schema: Layout prints the sitewide #hotel with the 4.6 / 433 Google rating. Self-serving
     Review markup was removed 28 Nov 2026 (Google ignores it; the three names were not in TESTIMONIALS). */}

  <div class="relative w-full bg-[#FAF9F6] text-[#0E2C21] overflow-x-hidden selection:bg-[#B0966D] selection:text-[#0E2C21]">
    <Breadcrumbs />
    
    <div class="pt-24 bg-[#0E2C21]">
      <ReviewsHeader />

      <div class="border-t border-[#FAF9F6]/10 pt-4 pb-20">
        <TestimonialList layout="grid" client:visible />
      </div>
    </div>
    <RecentBookingNotification client:idle />
  </div>
</Layout>
