---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RoomInventoryList from "../components/RoomInventoryList";
import BookingInteractiveForm from "../components/BookingInteractiveForm";
import WhatsAppButton from "../components/WhatsAppButton";
import RecentBookingNotification from "../components/RecentBookingNotification";
---

<Layout 
  title="Suites & Cottages in Ramgarh | Whispering Pines by Casa De Bello Mukteshwar" 
  description="Book luxury suites, deluxe rooms, and private 3-BHK villas at Whispering Pines Resort Ramgarh. 180° Himalayan snow views, fireplaces, 150 Mbps Wi-Fi & orchard balconies."
>
  <div class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#c9a832] selection:text-[#1B3322]">
    <Breadcrumbs />
    
    <main class="pt-8">
      <RoomInventoryList 
        title="Suites, Deluxe Rooms & Private Villas" 
        isH1={true}
        client:visible
      />
      
      {/* Featured Travel Guides Section */}
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="bg-white rounded-3xl p-8 border border-[#EAE8E3] shadow-sm text-center space-y-4">
          <span class="text-xs font-mono text-[#c9a832] uppercase tracking-widest font-semibold block">Himalayan Travel Journal</span>
          <h2 class="font-display text-2xl font-bold text-[#1B3322]">Explore Our Travel & Destination Guides</h2>
          <p class="text-sm text-gray-600 font-light max-w-2xl mx-auto">Learn more about planning your stay near Mukteshwar & Nainital with our comprehensive 2026 travel guides.</p>
          <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
            <a href="/blog/resort-near-nainital/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#1B3322] text-[#c9a832] font-semibold text-xs rounded-full hover:bg-[#c9a832] hover:text-[#1B3322] transition-colors">
              Resort near Nainital Guide →
            </a>
            <a href="/blog/resort-near-mukteshwar/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#FAF9F6] text-[#1B3322] font-semibold text-xs rounded-full border border-[#EAE8E3] hover:border-[#c9a832] transition-colors">
              Resort near Mukteshwar Guide →
            </a>
          </div>
        </div>
      </section>

      <div id="book" class="bg-[#1B3322] text-[#FAF9F6] py-16 px-4">
        <div class="max-w-4xl mx-auto">
          <BookingInteractiveForm title="Complete Your Vacation Booking" client:visible />
        </div>
      </div>
    </main>

    <WhatsAppButton client:idle />
    <RecentBookingNotification client:idle />
  </div>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Resort",
    "@id": "https://whisperingpinesresort.in/suites-cottages-ramgarh-resort/#resort",
    "name": "Whispering Pines Resort by Casa De Bello",
    "url": "https://whisperingpinesresort.in/suites-cottages-ramgarh-resort/",
    "telephone": "+91-7505029696",
    "priceRange": "₹3000 - ₹15999",
    "hasMap": "https://maps.google.com/?cid=8386667112972057918",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd, Mukteshwar, Nainital, Uttarakhand 263137",
      "addressLocality": "Mukteshwar",
      "addressRegion": "Uttarakhand",
      "postalCode": "263137",
      "addressCountry": "IN"
    },
    "containsPlace": [
      {
        "@type": "HotelRoom",
        "name": "Deluxe Himalayan View Room",
        "description": "Spacious mountain-facing room with private balcony offering 180° views of Nanda Devi and Trishul, king bed, heating, and modern en-suite bath.",
        "occupancy": { "@type": "QuantitativeValue", "maxValue": 3, "unitText": "Person" },
        "bed": { "@type": "BedDetails", "numberOfBeds": 1, "typeOfBed": "King" }
      },
      {
        "@type": "HotelRoom",
        "name": "Executive Cedar Suite",
        "description": "Hand-crafted cedar wood suite with sitting lounge, stone fireplace, private balcony, and panoramic Himalayan vistas.",
        "occupancy": { "@type": "QuantitativeValue", "maxValue": 4, "unitText": "Person" },
        "bed": { "@type": "BedDetails", "numberOfBeds": 1, "typeOfBed": "King" }
      },
      {
        "@type": "HotelRoom",
        "name": "Family Orchard Suite",
        "description": "Multi-bed family accommodation directly overlooking our private peach and plum orchards with separate children seating area.",
        "occupancy": { "@type": "QuantitativeValue", "maxValue": 5, "unitText": "Person" },
        "bed": { "@type": "BedDetails", "numberOfBeds": 2, "typeOfBed": "Queen" }
      },
      {
        "@type": "Accommodation",
        "name": "3-BHK Alpine Heritage Villa",
        "description": "Full standalone private villa sleeping up to 10 guests with 3 king bedrooms, attic loft, living room fireplace, kitchen, and private enclosed garden.",
        "occupancy": { "@type": "QuantitativeValue", "maxValue": 10, "unitText": "Person" },
        "numberOfBedrooms": 3
      }
    ]
  })} />
</Layout>
