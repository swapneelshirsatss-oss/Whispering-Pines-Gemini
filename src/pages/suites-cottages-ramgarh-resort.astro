---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RoomInventoryList from "../components/RoomInventoryList";
import BookingInteractiveForm from "../components/BookingInteractiveForm";
import WhatsAppButton from "../components/WhatsAppButton";
import RecentBookingNotification from "../components/RecentBookingNotification";
---

<Layout 
  title="Suites & Cottages | Whispering Pines Resort Ramgarh" 
  description="Explore luxury suites, deluxe rooms & private villas at Whispering Pines Resort Ramgarh. Panoramic Himalayan peak views, fireplaces & 150 Mbps Wi-Fi."
>
  <div class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#c9a832] selection:text-[#1B3322]">
    <Breadcrumbs />
    
    <main class="pt-8">
      <RoomInventoryList 
        title="Suites, Deluxe Rooms & Private Villas" 
        isH1={true}
        client:visible
      />
      
      <div id="book" class="bg-[#1B3322] text-[#FAF9F6] py-16 px-4">
        <div class="max-w-4xl mx-auto">
          <BookingInteractiveForm title="Complete Your Vacation Booking" client:visible />
        </div>
      </div>
    </main>

    <WhatsAppButton client:idle />
    <RecentBookingNotification client:idle />
  </div>
</Layout>
