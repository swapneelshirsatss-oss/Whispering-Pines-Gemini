---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RecentBookingNotification from "../components/RecentBookingNotification";
import DirectVsOtaTable from "../components/DirectVsOtaTable.astro";
import FAQAccordion from "../components/FAQAccordion";
import { Image } from 'astro:assets';
import { BOOKING_ENGINE_URL, generateWhatsAppLink } from '../data';
import deluxeRoomImgSrc from '../assets/images/rooms/Deluxe-Rooms-with-Himalayan-View.avif';
import premiumRoomImgSrc from '../assets/images/rooms/Premium-room-with-Himalayan-view.avif';
import cottageRoomImgSrc from '../assets/images/rooms/Cottage-Room-With-Himalayan-View.avif';
import familyRoomImgSrc from '../assets/images/rooms/Family-Twin-Bed-Room-With-Himalayan-View.avif';
// Rendered at build time to static SVG (no client directive, no JS shipped).
import { Dumbbell, UtensilsCrossed, Users, Presentation,MapPinned, Clock, ConciergeBell, SquareParking, Wifi, Stethoscope, BriefcaseMedical, ToyBrick, Dices, Bike, PawPrint } from 'lucide-react';

const SERVICES = [
  { Icon: Dumbbell, title: 'Fitness Space', text: 'Keep up your routine in the fitness space on the estate.' },
  { Icon: UtensilsCrossed, title: 'In-House Restaurant', text: 'Kumaoni, Punjabi, North Indian and multi-cuisine meals, cooked fresh.' },
  { Icon: Users, title: 'Banquet Hall', text: 'Seats up to 80 guests for meetings, offsites and celebrations.' },
  { Icon: Presentation, title: 'Meeting Room', text: 'A quiet room for team meetings and small offsites, with 150 Mbps fibre Wi-Fi.' },
  { Icon: MapPinned, title: 'Travel Desk', text: 'Cabs and day trips for Uttarakhand sightseeing: Kainchi Dham, Mukteshwar Dham, Nainital and more.' },
  { Icon: Clock, title: 'Front Desk', text: 'Open 24 hours, day and night.' },
  { Icon: ConciergeBell, title: 'Butler Service', text: 'Available on request.' },
  { Icon: SquareParking, title: 'Parking', text: 'Complimentary parking on the estate.' },
  { Icon: Wifi, title: 'Wi-Fi', text: 'Complimentary Wi-Fi in every room.' },
  { Icon: Stethoscope, title: 'Doctor on Call', text: 'A doctor is on call during your stay.' },
  { Icon: BriefcaseMedical, title: 'First Aid Kit', text: 'A first aid kit is kept on the estate.' },
  { Icon: ToyBrick, title: "Kids' Play Area", text: 'Open 7:00 AM - 8:00 PM.' },
  { Icon: Dices, title: 'Indoor Games', text: 'All day: billiards table, chess and table tennis.' },
  { Icon: Bike, title: 'Outdoor Games', text: 'Until 8:00 PM: archery, cycling, football and cricket, with equipment on request.' },
  { Icon: PawPrint, title: 'Pet Friendly', text: 'Pets are welcome under a clear house policy, with no pet fee. Please tell us before you travel.' },
];

// Same four room types and photos as /book-now/ (BookingJini names), but no rates here:
// rates live on /book-now/. Copy is written fresh for this URL to avoid duplicate content.
const ROOMS = [
  {
    id: 'deluxe', name: 'Deluxe Room with Himalayan View', bookingName: 'Deluxe Rooms with Himalayan View',
    img: deluxeRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Couples • Himalayan View Room',
    alt: 'Deluxe room with king bed and Himalayan view at Whispering Pines Resort, Mukteshwar near Nainital',
    text: 'A warm king-bed room in Mukteshwar for couples who want the snow peaks without the fuss. Wake to Nanda Devi from the window, then step into an en-suite bath with round-the-clock hot water and radiator heating on cold Kumaon nights.',
    tags: ['King Bed', 'Himalayan View', 'Radiator Heating'],
  },
  {
    id: 'premium', name: 'Premium Cedar Room in Mukteshwar', bookingName: 'Premium room with Himalayan view',
    img: premiumRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Couples • Cedar-Panelled Room',
    alt: 'Premium cedar-panelled room with queen bed and Himalayan view at Whispering Pines Resort, Mukteshwar',
    text: 'Cedar-panelled walls, a heated queen bed and a wide view of the Himalayan range: the room our guests pick most for a couples getaway near Nainital. Quiet, cosy and 1,780 m above the plains.',
    tags: ['Queen Bed', 'Cedar Panels', '180° Snow View'],
  },
  {
    id: 'cottage', name: 'Cottage Room with Garden Sit-out', bookingName: 'Cottage Room With Himalayan View',
    img: cottageRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Couples & Pets • Cottage Room',
    alt: 'Cottage room with garden sit-out and Himalayan view at Whispering Pines Resort, Malla Ramgarh',
    text: 'A cottage-style room in Ramgarh with its own garden sit-out for morning tea under the pines. King bed, en-suite bath and the same Himalayan view as every room at the resort. Well suited to couples travelling with a pet.',
    tags: ['Garden Sit-out', 'King Bed', 'Pet-Friendly'],
  },
  {
    id: 'family', name: 'Family Room in Mukteshwar for 4 Guests', bookingName: 'Family Twin-Bed Room With Himalayan View',
    img: familyRoomImgSrc, sleeps: 'Sleeps 4', featured: true,
    eyebrow: 'Families • Twin-Bed Room',
    alt: 'Family twin-bed room with valley balcony facing Nanda Devi at Whispering Pines Resort, Mukteshwar',
    text: 'Two king beds, cedar pine panels and a valley balcony facing Nanda Devi. One family room in Mukteshwar that fits parents and two children together, so there is no second booking and no rollaway bed.',
    tags: ['Twin King Beds', 'Valley Balcony', 'Family of 4'],
  },
];

// Side-by-side facts for answer engines; must match ROOMS above.
const ROOM_COMPARE = [
  { id: 'deluxe', room: 'Deluxe Room', bed: '1 King', sleeps: '2', bestFor: 'Couples', standout: 'Nanda Devi from the window' },
  { id: 'premium', room: 'Premium Cedar Room', bed: '1 Queen', sleeps: '2', bestFor: "Couples' getaway", standout: 'Cedar panels, 180° snow view' },
  { id: 'cottage', room: 'Cottage Room', bed: '1 King', sleeps: '2', bestFor: 'Couples with a pet', standout: 'Private garden sit-out' },
  { id: 'family', room: 'Family Twin-Bed Room', bed: '2 King', sleeps: '4', bestFor: 'Family of 4', standout: 'Valley balcony, one booking for all four' },
];

// Visible FAQs; Layout prints the matching FAQPage schema from the same array.
const roomFaqs = [
  {
    question: 'What room types does Whispering Pines Resort in Mukteshwar have?',
    answer: 'Whispering Pines has 25 rooms in four types: Deluxe Room, Premium Cedar Room, Cottage Room with garden sit-out, and Family Twin-Bed Room. Every room faces the Himalayas, with Nanda Devi and Trishul in view.',
  },
  {
    question: 'Which room is best for a family of 4 in Mukteshwar?',
    answer: 'The Family Twin-Bed Room. It has two king beds and a valley balcony facing Nanda Devi, so parents and two children stay together in one room, with no second booking and no rollaway bed.',
  },
  {
    question: 'Do all rooms at Whispering Pines have a Himalayan view?',
    answer: 'Yes. All four room types at Whispering Pines face the Himalayan range, including Nanda Devi and Trishul, from Malla Ramgarh at 1,780 m.',
  },
  {
    question: 'What is the room tariff at Whispering Pines Resort?',
    answer: "Room rates change by season and date, and include breakfast. For today's rate, message the front desk on WhatsApp at +91 75050 29696. Booking direct gets up to 20% off compared with OTA prices, plus direct-only perks.",
  },
  {
    question: 'What are the check-in and check-out times?',
    answer: 'Check-in is at 1:00 PM and check-out is at 11:00 AM. The front desk is open 24 hours. Early check-in can be requested when you book direct, subject to availability.',
  },
  {
    question: 'Are pets allowed in the rooms?',
    answer: 'Yes. Pets are welcome under our house policy with no pet fee. Please tell us before you travel. The Cottage Room, with its own garden sit-out, suits couples travelling with a pet.',
  },
  {
    question: 'Is there a charge for an extra guest?',
    answer: 'Yes. An extra guest in a room is charged from ₹1,000 per night. Message the front desk on WhatsApp to confirm the rate for your dates.',
  },
  {
    question: 'How far are the rooms from Nainital and Mukteshwar?',
    answer: 'Whispering Pines is in Malla Ramgarh, 26 km (about 55 minutes) from Nainital and 25 km (about 45 minutes) from Mukteshwar Dham, on the Bhowali-Ramgarh-Mukteshwar Road.',
  },
];
---

<Layout
  title="Rooms in Mukteshwar near Nainital | Himalayan Views"
  description="Family & Couples rooms in Mukteshwar near Nainital: Deluxe, Premium, Cottage and Family, all facing Nanda Devi from Malla Ramgarh. Save up to 20% direct."
  faqs={roomFaqs}
>
  <div class="relative w-full bg-[#FAF9F6] text-[#0E2C21] overflow-x-hidden selection:bg-[#B0966D] selection:text-[#0E2C21]">
    <Breadcrumbs />

    <div class="pt-8">
      <section id="rooms" class="py-16 lg:py-24 bg-[#FAF9F6] border-b border-[#E6E0D6]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="text-xs font-sans font-bold tracking-[0.1em] text-[#7A6038] uppercase block mb-3">
              Deluxe, Premium, Cottage &amp; Family Rooms
            </span>
            <h1 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-[#0E2C21] leading-tight">
              Himalayan-View Rooms for Family &amp; Couples in Mukteshwar near Nainital
            </h1>
            <div class="w-16 h-0.5 bg-[#B0966D] mx-auto my-5"></div>
            <p class="aeo-direct-answer text-sm sm:text-base text-[#44564E] leading-relaxed">
              Whispering Pines has 25 Himalayan-view rooms at Malla Ramgarh, 1,780 m up, 25 km (45 min) from Mukteshwar and 26 km (55 min) from Nainital. Deluxe, Premium, Cottage and Family Twin-Bed rooms all face Nanda Devi and Trishul. Families, couples and pets are welcome, and booking direct on WhatsApp saves up to 20%.
            </p>
            <p class="mt-4 inline-block text-xs sm:text-sm font-sans text-[#7A6038] bg-white border border-[#8A6F4A]/30 px-4 py-2 rounded-sm">
              Room prices change by season and rates are dynamic. Availability is confirmed by our reception team only.
            </p>
          </div>

          <div class="max-w-4xl mx-auto mb-12">
            <h2 class="font-display text-2xl font-semibold text-[#0E2C21] text-center mb-4">Compare the 4 room types</h2>
            <div class="overflow-x-auto rounded-sm border border-[#8A6F4A]/25 bg-white">
              <table class="w-full min-w-[560px] text-left text-sm">
                <caption class="sr-only">Room types at Whispering Pines Resort, Mukteshwar: bed, guests, best for and stand-out feature</caption>
                <thead class="bg-[#0E2C21] text-[#FAF9F6] font-sans text-xs uppercase tracking-wider">
                  <tr>
                    <th scope="col" class="px-4 py-3">Room</th>
                    <th scope="col" class="px-4 py-3">Bed</th>
                    <th scope="col" class="px-4 py-3">Sleeps</th>
                    <th scope="col" class="px-4 py-3">Best for</th>
                    <th scope="col" class="px-4 py-3">Stand-out</th>
                  </tr>
                </thead>
                <tbody class="text-[#44564E]">
                  {ROOM_COMPARE.map((r) => (
                    <tr class="border-t border-[#8A6F4A]/15">
                      <th scope="row" class="px-4 py-3 font-semibold text-[#0E2C21]">{r.room}</th>
                      <td class="px-4 py-3">{r.bed}</td>
                      <td class="px-4 py-3">{r.sleeps}</td>
                      <td class="px-4 py-3">{r.bestFor}</td>
                      <td class="px-4 py-3">{r.standout}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {ROOMS.map((room) => (
            <article class={`bg-white rounded-sm overflow-hidden shadow-md flex flex-col group ${room.featured ? 'border border-[#8A6F4A]/40 ring-2 ring-[#B0966D]/45' : 'border border-[#8A6F4A]/25'}`}>
              <div class="relative h-64 overflow-hidden">
                <Image
                  src={room.img}
                  alt={room.alt}
                  widths={[400, 700, 900]}
                  sizes="(max-width: 767px) 92vw, (max-width: 1200px) 46vw, 560px"
                  quality={70}
                  format="webp"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute bottom-3 right-3 bg-[#03110B]/85 text-[#E5CFA0] border border-[#B0966D]/40 font-sans text-xs font-bold px-2.5 py-0.5 rounded-sm">
                  {room.sleeps}
                </div>
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <span class="text-xs font-sans text-[#7A6038] uppercase tracking-[0.1em] block mb-1">{room.eyebrow}</span>
                  <h2 class="font-display text-2xl font-semibold text-[#0E2C21] mb-2">{room.name}</h2>
                  <p class="text-sm text-[#44564E] leading-relaxed mb-4">{room.text}</p>
                  <div class="flex flex-wrap gap-2 text-xs font-sans text-[#7A6038] mb-6">
                    {room.tags.map((tag) => (
                      <span class="bg-[#FAF9F6] px-2.5 py-1 rounded-sm border border-[#8A6F4A]/25">{tag}</span>
                    ))}
                  </div>
                </div>
                <div class="pt-4 border-t border-[#8A6F4A]/15 flex flex-wrap items-center gap-3">
                  <a
                    href={generateWhatsAppLink({ roomName: room.bookingName, source: "Rooms Page Card" })}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track-fn="trackBookingConversion"
                    data-track-args={JSON.stringify(["generate_lead", "booking", `rooms_page_whatsapp_${room.id}`, { conversion_type: "whatsapp" }])}
                    class="inline-flex items-center justify-center bg-[#0E2C21] hover:bg-[#193F30] text-[#FAF9F6] font-sans text-xs font-bold uppercase tracking-wider px-5 py-3 rounded-sm transition-colors"
                  >
                    Ask today's rate on WhatsApp
                  </a>
                  <a
                    href={BOOKING_ENGINE_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center text-[#0E2C21] hover:text-[#7A6038] font-sans text-xs font-semibold uppercase tracking-wider px-3 py-3 transition-colors"
                  >
                    Book online →
                  </a>
                </div>
              </div>
            </article>
            ))}
          </div>
        </div>
      </section>

      {/* Services & Facilities: cream cards on sand (DESIGN.md tokens) */}
      <section id="services" class="py-16 lg:py-24 bg-[#E6E0D6]">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center max-w-3xl mx-auto mb-10">
            <span class="text-xs font-sans font-bold tracking-[0.1em] text-[#7A6038] uppercase block mb-3">Included With Your Stay</span>
            <h2 class="font-display text-3xl sm:text-4xl font-semibold text-[#0E2C21] leading-tight">Services &amp; Facilities at Our Resort in Mukteshwar</h2>
          </div>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {SERVICES.map(({ Icon, title, text }) => (
              <li class="bg-[#FAF9F6] rounded-2xl p-7 shadow-sm border border-[#8A6F4A]/10">
                <Icon className="w-8 h-8 text-[#0E2C21] mb-4" strokeWidth={1.5} aria-hidden="true" />
                <h3 class="font-display text-2xl text-[#0E2C21] mb-2">{title}</h3>
                <p class="text-sm text-[#44564E] leading-relaxed">{text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* Direct vs OTA Booking Comparison */}
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <DirectVsOtaTable
          title="Direct Booking Advantage vs Third-Party OTAs"
          subtitle="Reserve directly through our official website or WhatsApp concierge to unlock up to 20% off, priority for 180° Nanda Devi view rooms, and zero pet fees."
        />
      </section>

      {/* Room FAQs (visible; Layout prints the matching FAQPage schema) */}
      <FAQAccordion
        client:visible
        faqs={roomFaqs}
        title="Rooms in Mukteshwar: Questions We Get Asked"
        description="Room types, family rooms, tariff, check-in, pets and distances."
      />

      {/* Featured Travel Guides Section */}
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="bg-white rounded-sm p-8 border border-[#EAE8E3] shadow-sm text-center space-y-4">
          <span class="text-xs font-sans text-[#7A6038] uppercase tracking-[0.1em] font-semibold block">Himalayan Travel Journal</span>
          <h2 class="font-display text-2xl font-bold text-[#0E2C21]">Explore Our Travel & Destination Guides</h2>
          <p class="text-sm text-gray-600 font-light max-w-2xl mx-auto">Learn more about planning your stay near Mukteshwar & Nainital with our comprehensive 2026 travel guides.</p>
          <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
            <a href="/blog/resort-near-nainital/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#0E2C21] text-[#B0966D] font-semibold text-xs rounded-full hover:bg-[#B0966D] hover:text-[#0E2C21] transition-colors">
              Resort near Nainital Guide →
            </a>
            <a href="/blog/best-resort-to-stay-near-mukteshwar/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#FAF9F6] text-[#0E2C21] font-semibold text-xs rounded-full border border-[#EAE8E3] hover:border-[#8A6F4A] transition-colors">
              Best resorts in Mukteshwar →
            </a>
            <a href="/book-now/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#FAF9F6] text-[#0E2C21] font-semibold text-xs rounded-full border border-[#EAE8E3] hover:border-[#8A6F4A] transition-colors">
              Check room rates &amp; book direct →
            </a>
          </div>
        </div>
      </section>

    </div>
    <RecentBookingNotification client:idle />
  </div>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    // Rooms as standalone HotelRoom nodes linked back via containedInPlace. Putting them in the Hotel's
    // containsPlace makes Google validate the Hotel as hotel-listing markup and flag it invalid.
    "@graph": [
      {
        "@type": "HotelRoom",
        "name": "Deluxe Room with Himalayan View",
        "description": "King-bed room with Nanda Devi view, radiator heating and en-suite bath with 24/7 hot water. Suited to couples.",
        "occupancy": { "@type": "QuantitativeValue", "maxValue": 2, "unitText": "Person" },
        "bed": { "@type": "BedDetails", "numberOfBeds": 1, "typeOfBed": "King" }
      },
      {
        "@type": "HotelRoom",
        "name": "Premium Room with Himalayan View",
        "description": "Cedar-panelled heated room with queen bed and a 180° view of the Himalayan range.",
        "occupancy": { "@type": "QuantitativeValue", "maxValue": 2, "unitText": "Person" },
        "bed": { "@type": "BedDetails", "numberOfBeds": 1, "typeOfBed": "Queen" }
      },
      {
        "@type": "HotelRoom",
        "name": "Cottage Room with Himalayan View",
        "description": "Cottage-style room with private garden sit-out, king bed, en-suite bath and Himalayan view. Pet-friendly.",
        "occupancy": { "@type": "QuantitativeValue", "maxValue": 2, "unitText": "Person" },
        "bed": { "@type": "BedDetails", "numberOfBeds": 1, "typeOfBed": "King" }
      },
      {
        "@type": "HotelRoom",
        "name": "Family Twin-Bed Room with Himalayan View",
        "description": "Family room with two king beds, cedar panels and a valley balcony facing Nanda Devi. Fits a family of four.",
        "occupancy": { "@type": "QuantitativeValue", "maxValue": 4, "unitText": "Person" },
        "bed": { "@type": "BedDetails", "numberOfBeds": 2, "typeOfBed": "King" }
      }
    ].map((room) => ({ ...room, "containedInPlace": { "@id": "https://whisperingpinesresort.in/#hotel" } }))
  })} />
</Layout>
