---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RoomInventoryList from "../components/RoomInventoryList";
import BookingInteractiveForm from "../components/BookingInteractiveForm";
import WhatsAppButton from "../components/WhatsAppButton";
import RecentBookingNotification from "../components/RecentBookingNotification";
---

<Layout 
  title="Suites & Cottages | Whispering Pines Resort Ramgarh" 
  description="Explore luxury suites, deluxe rooms & private villas at Whispering Pines Resort Ramgarh. Panoramic Himalayan peak views, fireplaces & 150 Mbps Wi-Fi."
>
  <div class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#c9a832] selection:text-[#1B3322]">
    <Breadcrumbs />
    
    <main class="pt-8">
      <RoomInventoryList 
        title="Suites, Deluxe Rooms & Private Villas" 
        isH1={true}
        client:visible
      />
      
      {/* Featured Travel Guides Section */}
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="bg-white rounded-3xl p-8 border border-[#EAE8E3] shadow-sm text-center space-y-4">
          <span class="text-xs font-mono text-[#c9a832] uppercase tracking-widest font-semibold block">Himalayan Travel Journal</span>
          <h2 class="font-display text-2xl font-bold text-[#1B3322]">Explore Our Travel & Destination Guides</h2>
          <p class="text-sm text-gray-600 font-light max-w-2xl mx-auto">Learn more about planning your stay near Mukteshwar & Nainital with our comprehensive 2026 travel guides.</p>
          <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
            <a href="/blog/resort-near-nainital/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#1B3322] text-[#c9a832] font-semibold text-xs rounded-full hover:bg-[#c9a832] hover:text-[#1B3322] transition-colors">
              Resort near Nainital Guide →
            </a>
            <a href="/blog/resort-near-mukteshwar/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#FAF9F6] text-[#1B3322] font-semibold text-xs rounded-full border border-[#EAE8E3] hover:border-[#c9a832] transition-colors">
              Resort near Mukteshwar Guide →
            </a>
          </div>
        </div>
      </section>

      <div id="book" class="bg-[#1B3322] text-[#FAF9F6] py-16 px-4">
        <div class="max-w-4xl mx-auto">
          <BookingInteractiveForm title="Complete Your Vacation Booking" client:visible />
        </div>
      </div>
    </main>

    <WhatsAppButton client:idle />
    <RecentBookingNotification client:idle />
  </div>
</Layout>
