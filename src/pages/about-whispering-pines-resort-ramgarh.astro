---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AboutSection from "../components/AboutSection.astro";
import HostFieldNote from "../components/HostFieldNote.astro";
import SEOAboutContent from "../components/SEOAboutContent.astro";
import RecentBookingNotification from "../components/RecentBookingNotification";
import FAQAccordion from "../components/FAQAccordion";

import balconyViewImg from "../assets/images/Whispering-pines-balcony-view-nanital.avif?url";
import villaImg from "../assets/images/villa_in_nanital.avif?url";

const siteBase = 'https://whisperingpinesresort.in';
const balconyUrl = new URL(balconyViewImg, siteBase).href;
const villaUrl = new URL(villaImg, siteBase).href;

// Visible FAQs; Layout prints the matching FAQPage schema from the same array.
const aboutFaqs = [
  {
    question: 'Is Whispering Pines the same resort as Clarks Exotica Mukteshwar?',
    answer: 'Yes. Whispering Pines Resort is the former Clarks Exotica Mukteshwar (also listed as Clarks Exotica Ramgarh), rebranded and upgraded under Casa De Bello management. It is the same property in Malla Ramgarh on the Bhowali-Ramgarh-Mukteshwar Road.',
  },
  {
    question: 'Who manages Whispering Pines Resort?',
    answer: 'Whispering Pines is managed by Casa De Bello (CASADEBELLO PRIVATE LIMITED). Gaurav Pandey, Managing Director & Founder, is the host.',
  },
  {
    question: 'Where exactly is Whispering Pines Resort?',
    answer: 'Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd, Mukteshwar, Nainital, Uttarakhand 263137, at 1,780 m. It is 25 km from Mukteshwar Dham, 26 km from Nainital and 43 km from Kathgodam Railway Station.',
  },
  {
    question: 'Is Whispering Pines a 4-star resort?',
    answer: 'Yes. Whispering Pines is a 4-star resort with 25 rooms and suites plus a 3-BHK private villa, rated 4.6★ on Google from 433 reviews.',
  },
  {
    question: 'How do I book Whispering Pines direct?',
    answer: 'Message the front desk on WhatsApp at +91 75050 29696 or use whisperingpinesresort.in/book-now/. Booking direct gets up to 20% off compared with OTA prices, plus direct-only perks.',
  },
];
---

<Layout
  title="About Whispering Pines, Mukteshwar (formerly Clarks Exotica)"
  description="Discover Whispering Pines (formerly Clarks Exotica) in Malla Ramgarh, Mukteshwar. Enjoy Kumaoni hospitality, luxury rooms, and 180° Himalayan views."
  faqs={aboutFaqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Hotel",
          // Same @id as Layout's sitewide Hotel node: this page enriches the one entity instead of creating a second.
          "@id": "https://whisperingpinesresort.in/#hotel",
          "name": "Whispering Pines Resort by Casa De Bello Mukteshwar Road",
          "alternateName": [
            "Whispering pines resort by casa de bello Mukteshwar road",
            "Whispering Pines Resort by Casa De Bello",
            "Clarks Exotica Mukteshwar",
            "Clarks Exotica Ramgarh",
            "Whispering Pines Ramgarh",
            "Casa De Bello Whispering Pines",
            "Casa De Bello - Whispering Pines Mukteshwar Road",
            "Casa De bello - Whsipering pines Mukteshwar Road",
            "Casa De Bello Mukteshwar - ramgarh",
            "Casa De Bello Mukteshwar - Ramgarh"
          ],
          "logo": {
            "@type": "ImageObject",
            "url": "https://whisperingpinesresort.in/logo.svg",
            "name": "Whispering Pines Resort by Casa De Bello — Logo"
          },
          "image": [
            {
              "@type": "ImageObject",
              "url": balconyUrl,
              "name": "Whispering Pines Resort — 180 Degree Balcony View of Nanda Devi and Trishul Peaks, Malla Ramgarh",
              "description": "Panoramic 180 degree view of Nanda Devi and Trishul Himalayan snow peaks from the balcony of Whispering Pines Resort by Casa De Bello in Malla Ramgarh, Uttarakhand"
            },
            {
              "@type": "ImageObject",
              "url": villaUrl,
              "name": "Stone and Cedar Heritage Architecture — Whispering Pines Resort Private Villa near Nainital",
              "description": "Artisanal stone masonry and cedar wood heritage villa exterior at Whispering Pines Resort, Malla Ramgarh — built by native Kumaoni craftsmen"
            },
            {
              "@type": "ImageObject",
              "url": "https://whisperingpinesresort.in/og-image.webp",
              "name": "Whispering Pines Resort by Casa De Bello — 4-Star Resort in Ramgarh Uttarakhand",
              "description": "Exterior view of Whispering Pines Resort, formerly Clarks Exotica, on the Bhowali-Ramgarh-Mukteshwar Road, Malla Ramgarh, Uttarakhand"
            }
          ],
          "description": "Whispering Pines Resort by Casa De Bello is a 4-star boutique heritage mountain resort built as the upgraded successor to Clarks Exotica Mukteshwar. Located on the Bhowali-Ramgarh-Mukteshwar Road in Malla Ramgarh, Uttarakhand at 1,780 metres altitude, the property features artisanal hand-crafted stone walls and solid cedar pine wood architecture built by native Kumaoni craftsmen. The 25-room resort and standalone private villa offer 180 degree panoramic views of the Nanda Devi and Trishul Himalayan peaks, set within active peach, plum, apple and apricot orchards and dense pine canopies. Under Casa De Bello management, the property delivers upgraded boutique hospitality while preserving the authentic Kumaoni mountain character that made it a beloved destination during the Clarks Exotica era.",
          "telephone": "+91-7505029696",
          "email": "booking@whisperingpinesresort.in",
          "currenciesAccepted": "INR",
          "paymentAccepted": "Cash, Credit Card, Debit Card, UPI, Net Banking",
          "numberOfRooms": 25,
          "checkinTime": "13:00",
          "checkoutTime": "11:00",
          "petsAllowed": true,
          "starRating": {
            "@type": "Rating",
            "ratingValue": "4",
            "bestRating": "5",
            "worstRating": "1"
          },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd, Mukteshwar, Nainital, Uttarakhand 263137",
            "addressLocality": "Mukteshwar",
            "addressRegion": "Uttarakhand",
            "postalCode": "263137",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 29.4260969,
            "longitude": 79.5506794,
            "elevation": "1780"
          },
          "hasMap": "https://maps.google.com/?cid=8386667112972057918",
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": [
                "Monday",
                "Tuesday",
                "Wednesday",
                "Thursday",
                "Friday",
                "Saturday",
                "Sunday"
              ],
              "opens": "00:00",
              "closes": "23:59"
            }
          ],
          "amenityFeature": [
            { "@type": "LocationFeatureSpecification", "name": "Free High-Speed Wi-Fi 150 Mbps Fiber", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Multi-Cuisine Restaurant", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "In-Room Dining 24 Hours", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Stone Fireplace Rooms", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Outdoor Bonfire and BBQ Area", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Pet Friendly", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Free Private Parking", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Private Fruit Orchards", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Banquet and Event Hall", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "180 Degree Himalayan Mountain View", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "24-Hour Front Desk", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Daily Housekeeping", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Travel Desk and Cab Service", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Backup Generator Power", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Pine Forest Nature Trails", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Private Villa", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Workcation Setup Remote Work Ready", "value": true }
          ],
          "founder": {
            "@type": "Person",
            "name": "Gaurav Pandey",
            "jobTitle": "Managing Director & Founder",
            "image": "https://whisperingpinesresort.in/images/Gaurav-pandey-casa-de-bello.webp",
            "description": "Leading hospitality entrepreneur and expert hotelier managing multiple boutique properties in Uttarakhand including Whispering Pines Resort Ramgarh and Anurra Kainchidham Hotel.",
            "worksFor": {
              "@type": "Organization",
              "name": "Casa De Bello Pvt Ltd",
              "url": "https://casadebello.com"
            },
            "url": "https://casadebello.com/",
            "sameAs": ["https://casadebello.com/"]
          },
          "sameAs": [
            "https://www.facebook.com/whisperingpinesbycasadebello",
            "https://www.instagram.com/whisperingpines.casa",
            "https://x.com/WhiperingPines",
            "https://www.youtube.com/channel/UC7WARaMtVTj9QS57zMX3yZw",
            "https://www.tripadvisor.in/Hotel_Review-g1049689-d34470070-Reviews-Whispering_Pines_Resort_Mukteshwar-Ramgarh_Nainital_District_Uttarakhand.html",
            "https://maps.google.com/?cid=8386667112972057918",
            "https://www.google.com/travel/hotels/entity/ChgIvvqZseCp27F0GgwvZy8xaGR6ejNrcDcQAQ",
            "https://casadebello.com",
            "https://www.makemytrip.com/hotels/whispering_pines_resort_mukteshwar-details-bhowali.html",
            "https://www.goibibo.com/hotels/whispering-pines-resort-mukteshwar-hotel-in-bhowali-5090504030524027434/"
          ]
        },
        {
          "@type": "WebPage",
          "@id": "https://whisperingpinesresort.in/about-whispering-pines-resort-ramgarh/#webpage",
          "url": "https://whisperingpinesresort.in/about-whispering-pines-resort-ramgarh/",
          "name": "4-Star Resort in Uttarakhand | About Whispering Pines by Casa De Bello, Mukteshwar",
          "isPartOf": {
            "@id": "https://whisperingpinesresort.in/#website"
          },
          "about": {
            "@id": "https://whisperingpinesresort.in/#hotel"
          },
          "inLanguage": "en-IN",
          "description": "About Whispering Pines Resort by Casa De Bello — the upgraded successor to Clarks Exotica Mukteshwar. A 4-star boutique heritage mountain resort in Malla Ramgarh, Uttarakhand with 180 degree Himalayan views, private orchards and luxury alpine suite architecture."
        }
      ]
    })} />
  </Fragment>

  <div class="relative w-full text-[#0E2C21] overflow-x-hidden pb-20 md:pb-0 selection:bg-[#B0966D] selection:text-[#0E2C21]">
    <Breadcrumbs />
    
    <div class="pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <AboutSection 
        hideLink={true}
        asH1={true}
        title="About Whispering Pines: Formerly Clarks Exotica, Mukteshwar"
      />
      <HostFieldNote className="my-8" />
      <SEOAboutContent />
      <FAQAccordion
        client:visible
        faqs={aboutFaqs}
        title="About Whispering Pines: Questions We Get Asked"
        description="Clarks Exotica, management, location, star rating and direct booking."
      />
    </div>
    <RecentBookingNotification client:idle />
  </div>
</Layout>
