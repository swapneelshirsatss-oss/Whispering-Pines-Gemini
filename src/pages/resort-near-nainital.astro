---
// Paid-search landing page for the Nainital ad group (Google Ads only).
// noindex + excluded from sitemap/IndexNow in astro.config.mjs and absent from nav/footer/llms.txt,
// so /private-villas-near-nainital/ and the Nainital blog posts keep the organic rankings for
// this keyword set. Whispering Pines Resort only — no sister-property mentions anywhere here.
// Palette, section rhythm and CTA rules follow src/pages/book-now.astro; the copy is written
// fresh for Nainital intent, since no two URLs may carry the same landing copy.
import LandingLayout from '../layouts/LandingLayout.astro';
import DirectBookingCalculator from '../components/DirectBookingCalculator.astro';
import { Image, getImage } from 'astro:assets';

import heroImgSrc from '../assets/images/Whispering-pines-balcony-view-nanital.avif';
// Phones get the valley view: the terrace shot crops to the chimney on a tall screen.
import heroMobileSrc from '../assets/images/whispering-pines-balcony-valley-view.jpg';
import ridgeImgSrc from '../assets/images/resort-near-nanital.avif';
// Low-detail cloud-sea frame: the one photo in the library that stays readable behind text.
import quoteImgSrc from '../assets/images/view-from-resort-cloud-sea.jpg';

// Room photography, matched to the names the booking engine uses.
import deluxeRoomImgSrc from '../assets/images/rooms/Deluxe-Rooms-with-Himalayan-View.avif';
import premiumRoomImgSrc from '../assets/images/rooms/Premium-room-with-Himalayan-view.avif';
import cottageRoomImgSrc from '../assets/images/rooms/Cottage-Room-With-Himalayan-View.avif';
import familyRoomImgSrc from '../assets/images/rooms/Family-Twin-Bed-Room-With-Himalayan-View.avif';

// Hero sits behind two scrims at reduced opacity, so quality/width are tuned down: the
// preloaded LCP bytes drop sharply with no visible difference.
const heroImage = await getImage({ src: heroImgSrc, format: 'webp', width: 1440, quality: 62 });
const heroMobile = await getImage({ src: heroMobileSrc, format: 'webp', width: 760, quality: 64 });
const ridgeImg = await getImage({ src: ridgeImgSrc, format: 'webp', width: 900, quality: 80 });
const quoteImg = await getImage({ src: quoteImgSrc, format: 'webp', width: 1600, quality: 62 });
const quoteImgMobile = await getImage({ src: quoteImgSrc, format: 'webp', width: 800, quality: 58 });

const RESORT_PHONE_DISPLAY = "075050 29696";
const RESORT_PHONE_TEL = "+917505029696";

const waLink = (text: string) => `https://wa.me/917505029696?text=${encodeURIComponent(text)}`;
const WA_HERO = waLink(
  'Hi! I am looking for a resort near Nainital and found Whispering Pines in Malla Ramgarh. Please share room availability and your best direct rate.'
);
const WA_PETS = waLink(
  'Hi! We are travelling to Nainital with our pet. Could you confirm availability at Whispering Pines Resort and anything we should bring along?'
);
const WA_FAMILY = waLink(
  'Hi! We are a family planning a Nainital trip. Please share which rooms at Whispering Pines Resort suit four of us and the direct rate for our dates.'
);

// Names, photos and tariffs mirror the live booking engine (read 27 Nov 2026):
// price = CP (room + daily breakfast), mapPrice = MAP (room + breakfast + dinner), both ex-GST.
const ROOM_CARDS = [
  {
    id: 'deluxe', name: 'Deluxe Rooms with Himalayan View', price: '₹3,500', mapPrice: '₹4,000',
    img: deluxeRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Malla Ramgarh • Entry Himalayan-View Room',
    alt: 'Deluxe Room with a king bed and Himalayan view at Whispering Pines Resort, 26 km from Nainital',
    text: 'The cheapest way to swap a Mall Road hotel room for a view of the snow line. King bed, en-suite bath with 24/7 hot water, radiator heating for winter nights. Few of these, and they go first.',
    tags: ['King Bed', 'Himalayan View', 'En-Suite Bath'],
  },
  {
    id: 'premium', name: 'Premium room with Himalayan view', price: '₹5,500', mapPrice: '₹6,500',
    img: premiumRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Malla Ramgarh • Himalayan-View Premium Room',
    alt: 'Premium Room with cedar panelling and a Himalayan view at Whispering Pines Resort near Nainital',
    text: 'What most couples book. Cedar-panelled walls, a heated room facing the Nanda Devi range and a bath with hot water at any hour — at 1,780 m, roughly 780 m higher than Nainital itself.',
    tags: ['Heated Room', '180° Snow View', 'En-Suite Bath'],
  },
  {
    id: 'cottage', name: 'Cottage Room With Himalayan View', price: '₹7,500', mapPrice: '₹8,500',
    img: cottageRoomImgSrc, sleeps: 'Sleeps 2',
    eyebrow: 'Malla Ramgarh • Garden Cottage Room',
    alt: 'Cottage Room with a private garden sit-out and Himalayan view at Whispering Pines Resort near Nainital',
    text: 'A standalone cottage with its own garden sit-out, so your morning tea happens outside rather than in a corridor. King bed, en-suite bath, the same 180° view as every other room here.',
    tags: ['Garden Sit-out', 'King Bed', 'Himalayan View'],
  },
  {
    id: 'familytwin', name: 'Family Twin-Bed Room With Himalayan View', price: '₹10,000', mapPrice: '₹12,000',
    img: familyRoomImgSrc, sleeps: 'Sleeps 4 Guests', featured: true,
    eyebrow: 'Malla Ramgarh • Family Twin-Bed Room',
    alt: 'Family Twin-Bed Room with a valley balcony at Whispering Pines Resort, a family resort near Nainital',
    text: 'Twin king beds, cedar panels and a balcony facing Nanda Devi. Four people in one room, no rollaway bed and no second booking — which is why families searching near Nainital end up here.',
    tags: ['Twin King Beds', 'Valley Balcony', 'Himalayan View'],
  },
];

// Driving distances from the resort gate, from src/data/transitMatrix.ts.
const NEARBY = [
  { place: 'Bhowali (bazaar and the Nainital junction)', gap: '12 km · 25 min' },
  { place: 'Nainital, Mall Road & Naini Lake', gap: '26 km · 55 min' },
  { place: 'Bhimtal lake', gap: '26 km · 50 min' },
  { place: 'Kainchi Dham (Neem Karoli Baba ashram)', gap: '22 km · 45 min' },
  { place: 'Mukteshwar Dham temple & Chauli Ki Jali', gap: '25 km · 45 min' },
  { place: 'Kathgodam railway station', gap: '43 km · 1 hr 30 min' },
];

const FAQS = [
  {
    q: 'How far is the resort from Nainital?',
    a: 'Malla Ramgarh is 26 km from Mall Road, about 55 minutes by car via Bhowali on paved road the whole way. You are close enough to spend a day at Naini Lake and be back for dinner, and far enough that the evenings are quiet and the snow peaks are not blocked by other buildings.',
  },
  {
    q: 'Why stay in Ramgarh instead of inside Nainital town?',
    a: 'Three practical reasons. The ridge here faces the Nanda Devi and Trishul range with nothing in the way, which a town room cannot offer. Parking is gated, level and outside your door, instead of a paid lot and a walk. And at 1,780 m the air is clearer and the nights colder than in town. The trade-off is honest: the lake, the boating and the Mall Road shops are a 55 minute drive, not a stroll.',
  },
  {
    q: 'Is this a good resort near Nainital for families?',
    a: 'The Family Twin-Bed Room takes four in one room with twin king beds and a balcony, so there is no rollaway and no second booking. Parking is level and right outside, the lawns are open and fenced by the orchard, and the kitchen will cook plain food for children on request. Bonfire in the evening is included.',
  },
  {
    q: 'Do you allow pets?',
    a: 'Yes, at no charge. Pets are welcome in the rooms and on the orchard lawns, and there are trails from the gate to walk them on. We do not cap the size or the breed. Tell us on WhatsApp beforehand so we put you in a ground-floor room with the easiest access to the lawn.',
  },
  {
    q: 'Can a hatchback make the drive up?',
    a: 'Yes. The resort is on the Bhowali–Ramgarh–Mukteshwar road itself, so there is no unpaved stretch at the end and no steep village track. The driveway runs straight into gated parking that holds 25+ cars.',
  },
  {
    q: 'What do the rates include, and how do I get the direct rate?',
    a: `CP is the room with daily breakfast; MAP adds dinner. Rates are before GST. Call or WhatsApp the front desk on ${RESORT_PHONE_DISPLAY} and you get the direct rate, which runs up to 20% under the travel sites because there is no commission and no convenience fee in it.`,
  },
];
---

<LandingLayout
  noindex={true}
  title="Resort Near Nainital, Ramgarh | Pet-Friendly Family Rooms ₹3,500+"
  description="Whispering Pines Resort, 26 km from Nainital in Malla Ramgarh via Bhowali. 180° Nanda Devi views, family rooms for four, pets free, gated parking. Rooms from ₹3,500 with breakfast."
  canonical="https://whisperingpinesresort.in/resort-near-nainital/"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroMobile.src} media="(max-width: 768px)" fetchpriority="high" type="image/webp" />
    <link rel="preload" as="image" href={heroImage.src} media="(min-width: 769px)" fetchpriority="high" type="image/webp" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Hotel",
          "@id": "https://whisperingpinesresort.in/#hotel",
          "name": "Whispering Pines Resort by Casa De Bello",
          "url": "https://whisperingpinesresort.in/resort-near-nainital/",
          "image": "https://whisperingpinesresort.in/og-image.webp",
          "telephone": "+91-7505029696",
          "starRating": { "@type": "Rating", "ratingValue": "4" },
          "priceRange": "₹3,500 - ₹12,000",
          "currenciesAccepted": "INR",
          "paymentAccepted": "Cash, Credit Card, UPI, Bank Transfer",
          "petsAllowed": true,
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd",
            "addressLocality": "Ramgarh, Nainital",
            "postalCode": "263137",
            "addressRegion": "Uttarakhand",
            "addressCountry": "IN"
          },
          "geo": { "@type": "GeoCoordinates", "latitude": 29.4260969, "longitude": 79.5506794 },
          "hasMap": "https://maps.google.com/?cid=8386667112972057918",
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.6",
            "reviewCount": "428",
            "bestRating": "5",
            "worstRating": "1"
          },
          "amenityFeature": [
            { "@type": "LocationFeatureSpecification", "name": "Pet-Friendly at No Extra Charge", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Family Rooms Sleeping Four", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "Gated Drive-in Parking for 25+ Cars", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "24/7 Instant Hot Geyser Water", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "100% Generator Power Backup", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "150 Mbps Fiber Wi-Fi", "value": true },
            { "@type": "LocationFeatureSpecification", "name": "180° Nanda Devi & Trishul Snow-Peak Views", "value": true }
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://whisperingpinesresort.in/resort-near-nainital/#faq",
          "mainEntity": FAQS.map((f) => ({
            "@type": "Question",
            "name": f.q,
            "acceptedAnswer": { "@type": "Answer", "text": f.a }
          }))
        }
      ]
    })} />
  </Fragment>

  <!-- =========================================================================
       SECTION 1: HERO — mobile-first, same pattern as /book-now/.
       Phones get the photo as its own band above the copy; sm+ puts it
       full-bleed behind the text with two scrims.
       ========================================================================= -->
  <section class="relative bg-[#FAF9F6] sm:bg-[#03110B] sm:min-h-[88svh] sm:flex sm:items-center sm:justify-center overflow-hidden">

    <div class="relative h-[170px] sm:absolute sm:inset-0 sm:h-auto sm:z-0 pointer-events-none">
      <picture>
        <source srcset={heroMobile.src} media="(max-width: 768px)" type="image/webp" />
        <img
          src={heroImage.src}
          alt="The valley seen from a balcony at Whispering Pines Resort, Malla Ramgarh, 26 km from Nainital"
          class="w-full h-full object-cover sm:opacity-60"
          loading="eager" fetchpriority="high"
          width="1800" height="1200"
        />
      </picture>
      <div class="hidden sm:block absolute inset-0 bg-gradient-to-t from-[#03110B] via-[#03110B]/60 to-[#03110B]/40"></div>
      <div class="hidden sm:block absolute inset-0 bg-radial from-[#03110B]/20 via-[#03110B]/45 to-[#03110B]/90"></div>
    </div>

    <div class="hidden sm:block absolute inset-8 border border-[#B0966D]/20 pointer-events-none z-10">
      <div class="absolute -top-1 -left-1 w-3 h-3 border-t-2 border-l-2 border-[#B0966D]"></div>
      <div class="absolute -top-1 -right-1 w-3 h-3 border-t-2 border-r-2 border-[#B0966D]"></div>
      <div class="absolute -bottom-1 -left-1 w-3 h-3 border-b-2 border-l-2 border-[#B0966D]"></div>
      <div class="absolute -bottom-1 -right-1 w-3 h-3 border-b-2 border-r-2 border-[#B0966D]"></div>
    </div>

    <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-7 pb-12 sm:pt-14 sm:pb-24">

      <p class="inline-flex flex-wrap items-center justify-center gap-x-2 text-xs sm:text-sm font-sans font-semibold text-[#7A6038] sm:text-[#C4A77D] mb-3 sm:mb-6">
        <span class="tracking-tighter text-[#B0966D]">★★★★★</span>
        <span>4.6 from 428 Google reviews</span>
        <span class="text-[#8A6F4A]/60 sm:text-[#B0966D]/60">•</span>
        <span class="font-normal text-[#44564E] sm:text-[#FAF7F2]/80">Malla Ramgarh, 1,780 m</span>
      </p>

      <h1 class="font-display text-[27px] leading-[1.14] sm:text-5xl md:text-6xl lg:text-7xl sm:leading-[1.12] font-semibold tracking-tight text-[#0E2C21] sm:text-[#FAF7F2] max-w-4xl mx-auto mb-3 sm:mb-5 text-balance sm:drop-shadow-[0_2px_14px_rgba(0,0,0,0.7)]">
        Resort Near Nainital, Up on the Ramgarh Ridge
      </h1>

      <p class="font-sans text-[15px] sm:text-lg text-[#44564E] sm:text-[#FAF7F2]/90 max-w-xl mx-auto leading-snug mb-4 sm:mb-6 text-pretty">
        26 km from Mall Road via Bhowali • 180° Nanda Devi views • family rooms for four • pets free
      </p>

      <p class="font-sans text-[15px] sm:text-base text-[#0E2C21] sm:text-[#FAF7F2] mb-5 sm:mb-7">
        <span class="font-bold">From ₹3,500 / night</span>&nbsp;<span class="text-[#44564E] sm:text-[#FAF7F2]/75">incl. breakfast</span>
      </p>

      <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 max-w-2xl mx-auto mb-5 sm:mb-8">
        <a
          href={`tel:${RESORT_PHONE_TEL}`}
          data-track-fn="trackBookingConversion" data-track-args='["phone_call_click","engagement","nainital_hero_phone_call",{"conversion_type":"phone","phone_number":"7505029696"}]'
          class="w-full sm:w-auto sm:flex-1 bg-[#03110B] sm:bg-[#FAF7F2] hover:bg-[#051E14] sm:hover:bg-[#E5CFA0] text-[#FAF7F2] sm:text-[#03110B] border-2 border-[#B0966D] font-bold min-h-14 py-4 px-5 rounded-sm shadow-[0_8px_24px_rgba(0,0,0,0.25)] flex items-center justify-center gap-2 text-sm uppercase tracking-wider active:scale-[0.98] transition-all text-center"
        >
          <svg class="w-4 h-4 text-[#E5CFA0] sm:text-[#03110B] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Call {RESORT_PHONE_DISPLAY}</span>
        </a>

        <a
          href={WA_HERO}
          target="_blank"
          rel="noopener noreferrer"
          data-track-fn="trackBookingConversion" data-track-args='["generate_lead","booking","nainital_hero_whatsapp",{"conversion_type":"whatsapp","value":3500,"currency":"INR"}]'
          class="w-full sm:w-auto sm:flex-1 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold min-h-14 py-4 px-6 rounded-sm shadow-[0_8px_24px_rgba(10,18,15,0.28)] flex items-center justify-center gap-2.5 text-sm uppercase tracking-wider active:scale-[0.98] transition-all border border-white/20 text-center"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span class="tracking-wide">WhatsApp for rates</span>
        </a>
      </div>

      <div class="flex flex-wrap justify-center items-center gap-y-2 gap-x-5 text-xs text-[#44564E] sm:text-[#FAF7F2]/80 font-sans mb-8 sm:mb-0">
        <span class="flex items-center gap-1.5"><span class="text-[#7A6038]">✓</span> Reply in &lt; 5 minutes</span>
        <span class="flex items-center gap-1.5"><span class="text-[#7A6038]">✓</span> Pets free, no size limit</span>
        <a href="#rooms" class="flex items-center gap-1.5 underline decoration-[#8A6F4A]/40 underline-offset-4"><span class="text-[#7A6038]">✓</span> Rooms for four</a>
      </div>

      <p class="font-sans text-[15px] sm:text-lg md:text-xl text-[#44564E] sm:text-[#FAF7F2]/95 font-light max-w-2xl mx-auto leading-relaxed mt-0 sm:mt-10 text-pretty sm:drop-shadow-[0_1px_6px_rgba(0,0,0,0.6)]">
        Most people searching for a resort near Nainital are picturing the lake and end up in traffic. Whispering Pines sits 26 km past it in Malla Ramgarh, 780 m higher, on the Bhowali–Ramgarh–Mukteshwar road — snow peaks from every room, an orchard instead of a corridor, and your car parked outside your door.
      </p>

    </div>
  </section>

  <!-- =========================================================================
       SECTION 2: WHY THE RIDGE RATHER THAN THE TOWN
       ========================================================================= -->
  <section class="py-20 lg:py-28 bg-[#FAF9F6] text-[#2C3531] border-b border-[#8A6F4A]/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-sans font-bold tracking-[0.1em] text-[#7A6038] uppercase block">
            26 km past the lake
          </span>
          <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#03110B] leading-tight text-balance">
            What You Get for Driving Another Hour From Nainital
          </h2>
          <div class="w-16 h-0.5 bg-[#B0966D]"></div>
          <p class="font-sans text-sm sm:text-base text-[#44564E] leading-relaxed">
            Nainital town is built around the lake, which means rooms look at other rooms and the car goes in a paid lot somewhere down the hill. Ramgarh is a fruit-growing ridge at 1,780 m with the Nanda Devi and Trishul range in front of it and nothing in between.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="border border-[#151E1A]/10 bg-white p-5 rounded-sm shadow-sm">
              <span class="font-sans text-xs text-[#7A6038] uppercase font-bold block mb-1">The view</span>
              <strong class="text-base text-[#03110B] block">Snow peaks from every room</strong>
              <span class="text-xs text-[#44564E]">180° of the range from the beds and the balconies, not a partial glimpse between rooftops.</span>
            </div>
            <div class="border border-[#151E1A]/10 bg-white p-5 rounded-sm shadow-sm">
              <span class="font-sans text-xs text-[#7A6038] uppercase font-bold block mb-1">The car</span>
              <strong class="text-base text-[#03110B] block">Parked outside your door</strong>
              <span class="text-xs text-[#44564E]">Gated, level and free, with space for 25+ cars. No lot, no shuttle, no hill steps with luggage.</span>
            </div>
            <div class="border border-[#151E1A]/10 bg-white p-5 rounded-sm shadow-sm">
              <span class="font-sans text-xs text-[#7A6038] uppercase font-bold block mb-1">The evening</span>
              <strong class="text-base text-[#03110B] block">A bonfire, not a bazaar</strong>
              <span class="text-xs text-[#44564E]">Bonfire set up on the lawn at no charge, with the BBQ fired up on request.</span>
            </div>
            <div class="border border-[#151E1A]/10 bg-white p-5 rounded-sm shadow-sm">
              <span class="font-sans text-xs text-[#7A6038] uppercase font-bold block mb-1">The honest part</span>
              <strong class="text-base text-[#03110B] block">The lake is a 55 min drive</strong>
              <span class="text-xs text-[#44564E]">Fine as a day out, wrong if you want to walk to Mall Road after dinner.</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-white border border-[#151E1A]/10 rounded-sm overflow-hidden shadow-md p-3">
            <img
              src={ridgeImg.src}
              alt="The Nanda Devi and Trishul snow line seen from Malla Ramgarh, 26 km from Nainital"
              class="w-full h-72 object-cover rounded-sm"
              loading="lazy" decoding="async" width="900" height="600"
            />
            <div class="p-3">
              <span class="text-[10px] font-sans text-[#7A6038] uppercase tracking-wider font-bold">Malla Ramgarh, 1,780 m</span>
              <p class="text-sm text-[#44564E] mt-1">The ridge faces the Nanda Devi and Trishul peaks. On a clear winter morning the snow line is the first thing you see from bed.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: ROOMS
       ========================================================================= -->
  <section id="rooms" class="py-20 lg:py-28 bg-[#E6E0D6] text-[#2C3531] border-b border-[#8A6F4A]/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

