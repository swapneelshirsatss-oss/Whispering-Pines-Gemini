---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from "../components/WhatsAppButton";
import RecentBookingNotification from "../components/RecentBookingNotification";
import { RESORT_CONTACT, generateWhatsAppLink } from '../data';

const pageTitle = "Clarks Exotica Resort Ramgarh Mukteshwar — Now Whispering Pines by Casa De Bello (2026 Guide)";
const pageDescription = "Clarks Exotica Resort Ramgarh Mukteshwar is now Whispering Pines by Casa De Bello. Same iconic location, fully upgraded. 4.6★ Google. Pool, villa, 180° Himalayan views. Book direct on WhatsApp.";
const canonicalUrl = "https://whisperingpinesresort.in/clarks-exotica-resort-ramgarh-mukteshwar/";
const ogImageUrl = "https://whisperingpinesresort.in/images/clarks-exotica-resort-ramgarh-mukteshwar-whispering-pines-casa-de-bello-2026.avif";
const ogAltText = "Clarks Exotica Resort Ramgarh Mukteshwar — now Whispering Pines by Casa De Bello, Malla Ramgarh Uttarakhand 2026";

const breadcrumbs = [
  { name: "Home", item: "https://whisperingpinesresort.in/" },
  { name: "Blog", item: "https://whisperingpinesresort.in/blog/" },
  { name: "Clarks Exotica Ramgarh Guide", item: canonicalUrl }
];

// Speakable Schema for AEO (Answer Engine Optimization) & Voice Search
const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".aeo-direct-answer", "#aeo-quick-facts", "#geo-entity-matrix"]
  }
};

// GEO Place Schema for AI Overviews & Perplexity AI
const geoPlaceSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Whispering Pines Resort (Formerly Clarks Exotica Ramgarh)",
  "description": "Iconic mountain resort estate in Malla Ramgarh on Bhowali-Ramgarh-Mukteshwar Road, previously operating as Clarks Exotica Ramgarh, now upgraded under Casa De Bello management with swimming pool, 3-BHK villa, and 180° Himalayan views.",
  "hasMap": "https://maps.app.goo.gl/hieeCQ2Ymc1vKNxj7",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 29.4264111,
    "longitude": 79.5505355,
    "elevation": "1780"
  },
  "geoContains": [
    { "@type": "Place", "name": "Mukteshwar Dham Temple", "distance": "25 km" },
    { "@type": "Place", "name": "Kainchi Dham Neem Karoli Baba Ashram", "distance": "22 km" },
    { "@type": "Place", "name": "Bhalu Gaad Waterfall", "distance": "12 km" },
    { "@type": "Place", "name": "Nainital Mall Road", "distance": "26 km" }
  ]
};

// BlogPosting Schema
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "headline": pageTitle,
  "description": pageDescription,
  "image": ogImageUrl,
  "datePublished": "2026-08-13T10:00:00+05:30",
  "dateModified": "2026-08-13T10:00:00+05:30",
  "author": {
    "@type": "Person",
    "name": "Gaurav Pandey",
    "jobTitle": "Director of Casa De Bello Pvt Ltd",
    "description": "Traveller Host, Hospitality Entrepreneur, and Director at Casa De Bello Pvt Ltd.",
    "url": "https://casadebello.com/",
    "sameAs": ["https://casadebello.com/"]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
    "url": "https://whisperingpinesresort.in/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://whisperingpinesresort.in/logo.svg"
    }
  }
};

// Google Site Name & SERP Branding Rules Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://whisperingpinesresort.in/#website",
  "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
  "alternateName": [
    "Whispering Pines Resort by Casa De Bello",
    "Whispering Pines Resort Mukteshwar",
    "Whispering Pines Resort near Mukteshwar",
    "Whispering Pines by Casa De Bello"
  ],
  "url": "https://whisperingpinesresort.in/"
};

// Resort / Local Business Schema
const resortLocalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["Resort", "Hotel", "LocalBusiness"],
  "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
  "alternateName": [
    "Clarks Exotica Resort Ramgarh Mukteshwar",
    "Clarks Exotica Ramgarh",
    "Whispering Pines Resort Ramgarh"
  ],
  "description": "Luxury 4-star mountain resort in Malla Ramgarh near Mukteshwar (formerly Clarks Exotica). Features 25 premium rooms, 3-BHK private villa, outdoor pool, 150 Mbps Wi-Fi, and 180° Nanda Devi Himalayan views.",
  "url": "https://whisperingpinesresort.in/",
  "telephone": "+91-7505029696",
  "email": "booking@whisperingpinesresort.in",
  "priceRange": "₹3000 - ₹15999",
  "image": ogImageUrl,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd, Mukteshwar, Nainital, Uttarakhand 263137",
    "addressLocality": "Mukteshwar",
    "addressRegion": "Uttarakhand",
    "postalCode": "263137",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 29.4264111,
    "longitude": 79.5505355,
    "elevation": "1780m"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.6",
    "reviewCount": "320"
  }
};

// FAQPage Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is Clarks Exotica Resort Ramgarh Mukteshwar still open?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Clarks Exotica Resort at Ramgarh on the Mukteshwar Road is now operating as Whispering Pines Resort by Casa De Bello. The property is fully open — same address, fully upgraded facilities. Direct bookings via WhatsApp at +91-7505029696."
      }
    },
    {
      "@type": "Question",
      "name": "What happened to Clarks Exotica Ramgarh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The property was taken over and elevated by Casa De Bello — a boutique mountain hospitality brand. The physical address in Malla Ramgarh on the Bhowali-Ramgarh-Mukteshwar Road is unchanged. New additions include a swimming pool, standalone private villa, 150 Mbps fiber Wi-Fi, enhanced room interiors, and personalised Casa De Bello management."
      }
    },
    {
      "@type": "Question",
      "name": "Is Whispering Pines better than Clarks Exotica was?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Returning Clarks Exotica guests consistently say yes. The views, orchards, and location they loved are unchanged — but the room quality, amenities (pool, villa, fiber Wi-Fi), and service level are significantly elevated under Casa De Bello management."
      }
    },
    {
      "@type": "Question",
      "name": "Do returning Clarks Exotica guests get special rates?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Returning Clarks Exotica guests receive exclusive retention rates on direct WhatsApp booking at +91-7505029696. Mention you are a returning Clarks Exotica guest when you message."
      }
    },
    {
      "@type": "Question",
      "name": "How far is it from Mukteshwar Dham?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "25 km — approximately 45 minutes on the Bhowali-Ramgarh-Mukteshwar Road. Same distance as during the Clarks Exotica era. The in-house travel desk now coordinates cab departures directly from the resort."
      }
    },
    {
      "@type": "Question",
      "name": "How far is it from Kainchi Dham?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "22 km — approximately 45 minutes. The travel desk manages cab coordination and early morning darshan departures. Pure vegetarian and Satvik meals available on request before departure."
      }
    },
    {
      "@type": "Question",
      "name": "Does the resort have a swimming pool now?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — this is new since the Clarks Exotica era. Whispering Pines has an on-site swimming pool surrounded by pine forest, one of the very few resorts near Mukteshwar to offer this alongside 180° Himalayan views."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Wi-Fi speed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "150 Mbps enterprise fiber optic — full property coverage. This is completely new infrastructure installed under Casa De Bello — a significant upgrade from the Clarks Exotica era."
      }
    },
    {
      "@type": "Question",
      "name": "Is the resort pet-friendly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — fully pet-friendly with enclosed garden lawns, pine forest trail access, and no additional pet charges. Dogs and cats welcome."
      }
    },
    {
      "@type": "Question",
      "name": "How do I book at the best price?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Book directly via WhatsApp at +91-7505029696. Save up to 20% versus OTA platforms. Returning Clarks Exotica guests receive additional exclusive rates — mention your history with the property when you message."
      }
    }
  ]
};

const jsonLdSchemas = [
  websiteSchema,
  blogPostingSchema,
  resortLocalBusinessSchema,
  faqSchema,
  geoPlaceSchema,
  speakableSchema
];
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <meta property="og:site_name" content="Whispering Pines Resort by Casa De Bello - Near Mukteshwar" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogAltText} />
    <meta property="twitter:image" content={ogImageUrl} />
    {jsonLdSchemas.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <div class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#c9a832] selection:text-[#1B3322]">
    
    {/* Hero Banner Header */}
    <header class="relative bg-[#1B3322] text-white pt-28 pb-16 px-4 sm:px-6 lg:px-8 border-b border-[#c9a832]/20 overflow-hidden">
      <div class="absolute inset-0 z-0 opacity-25">
        <img 
          src={ogImageUrl}
          alt={ogAltText}
          class="w-full h-full object-cover"
          loading="eager"
          width="1400"
          height="800"
        />
      </div>
      <div class="relative z-10 max-w-4xl mx-auto text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#c9a832]/10 border border-[#c9a832]/30 text-[#c9a832] text-xs font-mono uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-[#c9a832] animate-pulse"></span>
          Official 2026 Transition Guide
        </div>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold font-display tracking-tight text-white leading-tight">
          Clarks Exotica Resort Ramgarh Mukteshwar — Now Whispering Pines by Casa De Bello
        </h1>
        <p class="text-base sm:text-lg text-gray-200 font-light max-w-2xl mx-auto leading-relaxed">
          Same iconic address on the Bhowali-Ramgarh-Mukteshwar Road. Fully upgraded with a brand-new swimming pool, 3-BHK private villa, 150 Mbps fiber Wi-Fi, and 180° Nanda Devi snow views.
        </p>
        
        <div class="pt-4 flex flex-wrap items-center justify-center gap-4 text-xs font-medium text-gray-300">
          <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-full">
            <svg class="w-4 h-4 text-[#c9a832]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            4.6★ Google Verified
          </span>
          <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-full">
            <svg class="w-4 h-4 text-[#c9a832]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Malla Ramgarh Ridge (1,780m)
          </span>
          <span class="flex items-center gap-1.5 bg-white/10 px-3 py-1.5 rounded-full">
            <svg class="w-4 h-4 text-[#c9a832]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            Updated August 2026
          </span>
        </div>
      </div>
    </header>

    {/* Main Article Content Container */}
    <main class="py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-10">

      {/* Author EEAT Banner */}
      <div class="bg-white p-6 rounded-2xl border border-[#EAE8E3] shadow-sm flex flex-col md:flex-row items-center gap-5">
        <div class="w-16 h-16 rounded-full bg-[#1B3322] text-[#c9a832] flex items-center justify-center text-xl font-bold border-2 border-[#c9a832] shrink-0 shadow-inner">
          GP
        </div>
        <div class="space-y-1 text-center md:text-left">
          <div class="text-xs font-bold text-[#c9a832] uppercase tracking-wider">Author & Verified Property Host</div>
          <h2 class="text-base font-bold text-[#1B3322]">Gaurav Pandey — Managing Director, Casa De Bello Pvt Ltd</h2>
          <p class="text-xs text-gray-600 font-light leading-relaxed">
            Leading boutique Himalayan hospitality at <a href="https://casadebello.com/" target="_blank" rel="noreferrer" className="text-[#1B3322] font-semibold underline">Casa De Bello Pvt Ltd</a>. Overseeing the full restoration and management of Whispering Pines Resort (formerly Clarks Exotica) in Malla Ramgarh near Mukteshwar.
          </p>
        </div>
      </div>

      {/* AEO Quick Summary / Direct Answer Box */}
      <section className="bg-[#1B3322]/5 p-6 rounded-2xl border border-[#1B3322]/15 space-y-3 aeo-direct-answer">
        <h2 className="text-xs font-bold text-[#1B3322] uppercase tracking-widest flex items-center gap-2">
          <span className="w-2 h-2 rounded-full bg-[#c9a832]"></span>
          Quick Executive Summary for Travellers
        </h2>
        <p className="text-sm text-gray-800 leading-relaxed font-normal">
          <strong>Clarks Exotica Resort Ramgarh Mukteshwar</strong> is now operating as <strong><a href="/" className="text-[#1B3322] font-bold underline">Whispering Pines Resort by Casa De Bello</a></strong>. The property maintains its exact geographical address in Malla Ramgarh on the Bhowali-Ramgarh-Mukteshwar Road (Uttarakhand 263137), offering unchanged 180° Himalayan views of Nanda Devi and Trishul. Under Casa De Bello management, it features a brand-new pine forest swimming pool, a 3-BHK standalone private villa, 150 Mbps fiber Wi-Fi, Kumaoni stone cottage architecture, and direct WhatsApp reservations at +91-7505029696.
        </p>
      </section>

      {/* Article Body Section 1 */}
      <div className="space-y-6 text-gray-800 leading-relaxed text-base font-light">
        <p className="text-lg text-gray-700 leading-relaxed font-light">
          If you have been searching for <strong>Clarks Exotica Resort Ramgarh Mukteshwar</strong> and finding yourself confused by what has changed — you are in exactly the right place.
        </p>

        <p>
          Clarks Exotica Resort on the Bhowali-Ramgarh-Mukteshwar Road in Malla Ramgarh is now operating as <strong><a href="/about-whispering-pines-resort-ramgarh/" className="text-[#1B3322] font-semibold underline">Whispering Pines Resort by Casa De Bello</a>.</strong> The iconic location has not moved. The spectacular 180° Himalayan views of Nanda Devi and Trishul that guests loved are unchanged. The same winding Mukteshwar Road, the same ridge altitude, the same pine canopy and fruit orchards that made this address one of the most beloved mountain stays in Nainital district — all of it remains.
        </p>

        <p>
          What has changed is everything else — and it has changed for the better.
        </p>

        <p>
          This guide tells you exactly what happened to Clarks Exotica Ramgarh, what is different now under Casa De Bello management, what has stayed the same, and why returning Clarks Exotica guests consistently say this is the best version this property has ever been.
        </p>

        {/* Direct WhatsApp Callout Banner */}
        <div className="bg-[#1B3322] text-white p-6 rounded-2xl text-center space-y-3 my-8 shadow-md border border-[#c9a832]/30">
          <h3 className="text-xl font-bold text-white">Returning Clarks Exotica Guests — Save 20% Direct</h3>
          <p className="text-xs text-gray-300 max-w-xl mx-auto">
            Book Direct on WhatsApp: <strong>+91-7505029696</strong> — Returning Clarks Exotica Guests Receive Exclusive Retention Rates & Best Price Guarantee versus MakeMyTrip or Booking.com.
          </p>
          <a 
            href="https://wa.me/917505029696?text=Hi!%20I'm%20a%20returning%20Clarks%20Exotica%20guest%20inquiring%20about%20retention%20rates." 
            target="_blank" 
            rel="noreferrer" 
            className="inline-block px-6 py-3 bg-[#c9a832] text-[#1B3322] font-bold text-xs uppercase tracking-wider rounded-xl hover:bg-yellow-400 transition-all shadow-sm"
          >
            WhatsApp +91-7505029696 — Claim Retention Rates
          </a>
        </div>
      </div>

      {/* H2: What Happened to Clarks Exotica Resort Ramgarh Mukteshwar? */}
      <section className="space-y-4 pt-4 border-t border-[#EAE8E3]">
        <h2 className="text-2xl sm:text-3xl font-bold text-[#1B3322] font-display">
          What Happened to Clarks Exotica Resort Ramgarh Mukteshwar?
        </h2>
        <p className="text-gray-700 leading-relaxed font-light">
          Clarks Exotica Resort Ramgarh was one of the most recognised mountain resort addresses in the Nainital district for years — a trusted name for Delhi NCR families, corporate groups, and Himalayan nature lovers seeking a comfortable stay near Mukteshwar and Kainchi Dham.
        </p>
        <p className="text-gray-700 leading-relaxed font-light">
          The property has now been taken over, fully renovated, and elevated under <strong>Casa De Bello</strong> — a boutique hospitality brand focused on curated mountain experiences. The new identity is <strong>Whispering Pines Resort by Casa De Bello.</strong>
        </p>
        <p className="text-gray-700 leading-relaxed font-light">
          This is not a rebranding in the marketing sense. It is a genuine physical and operational upgrade — new stone cottage architecture, a brand-new <a href="/resort-amenities-mukteshwar/" className="text-[#1B3322] font-semibold underline">swimming pool</a>, enhanced room interiors, a standalone <a href="/private-villas-near-nainital/" className="text-[#1B3322] font-semibold underline">private villa</a> added to the property, 150 Mbps enterprise fiber optic Wi-Fi installed across the estate, and a completely new management team focused on personalised boutique hospitality.
        </p>
        <p className="text-gray-700 leading-relaxed font-light font-semibold text-[#1B3322]">
          The Clarks Exotica name is no longer operational at this address. Whispering Pines Resort by Casa De Bello is the property you are looking for.
        </p>
      </section>

      {/* H2: Same Location — Everything You Loved Is Still Here */}
      <section className="space-y-6 pt-6 border-t border-[#EAE8E3]">
        <h2 className="text-2xl sm:text-3xl font-bold text-[#1B3322] font-display">
          Same Location — Everything You Loved Is Still Here
        </h2>
        <p className="text-gray-700 leading-relaxed font-light">
          For guests who visited Clarks Exotica Ramgarh and are planning a return trip, here is what has remained completely unchanged:
        </p>

        {/* Comparison Table 1 */}
        <div className="overflow-x-auto rounded-2xl border border-[#EAE8E3] shadow-sm bg-white">
          <table className="w-full text-left text-xs sm:text-sm">
            <thead className="bg-[#1B3322] text-white">
              <tr>
                <th className="p-3.5 font-bold">What You Remember from Clarks Exotica</th>
                <th className="p-3.5 font-bold">Still Here at Whispering Pines</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-[#EAE8E3] text-gray-700">
              <tr className="hover:bg-[#FAF9F6]">
                <td className="p-3.5 font-medium">Bhowali-Ramgarh-Mukteshwar Road address</td>
                <td className="p-3.5">✅ Same address — House No. 23-13/4, Malla Ramgarh</td>
              </tr>
              <tr className="hover:bg-[#FAF9F6]">
                <td className="p-3.5 font-medium">180° Himalayan views of Nanda Devi and Trishul</td>
                <td className="p-3.5">✅ Unchanged — unobstructed from every balcony</td>
              </tr>
              <tr className="hover:bg-[#FAF9F6]">
                <td className="p-3.5 font-medium">Pine forest surroundings</td>
                <td className="p-3.5">✅ Unchanged — deodar and pine canopy throughout</td>
              </tr>
              <tr className="hover:bg-[#FAF9F6]">
                <td className="p-3.5 font-medium">Private apple and peach orchards</td>
                <td className="p-3.5">✅ Unchanged — active working orchards on the property</td>
              </tr>
              <tr className="hover:bg-[#FAF9F6]">
                <td className="p-3.5 font-medium">Scenic drive from Bhowali through Ramgarh</td>
                <td className="p-3.5">✅ Unchanged — same winding mountain approach road</td>
              </tr>
              <tr className="hover:bg-[#FAF9F6]">
                <td className="p-3.5 font-medium">Easy base for Kainchi Dham and Mukteshwar Dham</td>
                <td className="p-3.5">✅ Same distances — 22 km Kainchi, 25 km Mukteshwar</td>
              </tr>
              <tr className="hover:bg-[#FAF9F6]">
                <td className="p-3.5 font-medium">6–8 hour drive from Delhi/NCR</td>
                <td className="p-3.5">✅ Same route — NH9 via Haldwani and Bhowali</td>
              </tr>
              <tr className="hover:bg-[#FAF9F6]">
                <td className="p-3.5 font-medium">Kathgodam railway connectivity</td>
                <td className="p-3.5">✅ Same — 40 minutes from Kathgodam station</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p className="text-xs text-gray-500 italic text-center">
          The address, the views, the location advantages — all exactly as returning guests remember them.
        </p>
      </section>

      {/* H2: What Is New at Whispering Pines — Upgraded from Clarks Exotica */}
      <section className="space-y-6 pt-6 border-t border-[#EAE8E3]">
        <h2 className="text-2xl sm:text-3xl font-bold text-[#1B3322] font-display">
          What Is New at Whispering Pines — Upgraded from Clarks Exotica
        </h2>
        <p className="text-gray-700 leading-relaxed font-light">
          Now here is what has been significantly elevated since the Clarks Exotica era:
        </p>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-5 my-6">
          <div className="bg-white p-5 rounded-2xl border border-[#EAE8E3] shadow-sm space-y-2">
            <h3 className="font-bold text-[#1B3322] text-lg flex items-center gap-2">
              <span>🏊</span> Swimming Pool — Brand New Addition
