// Rich JSON-LD Structured Data
const venueSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Hotel", "EventVenue"],
      "@id": "https://whisperingpinesresort.in/destination-wedding-uttarakhand/#venue",
      "name": "Whispering Pines Resort by Casa De Bello - Destination Wedding Uttarakhand",
      "url": "https://whisperingpinesresort.in/destination-wedding-uttarakhand/",
      "image": "https://whisperingpinesresort.in/images/destination-wedding/destination-weddings-uttarkahnd.avif",
      "telephone": "+917505029696",
      "priceRange": "₹₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd",
        "addressLocality": "Mukteshwar",
        "addressRegion": "Nainital, Uttarakhand",
        "postalCode": "263137",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 29.4262052,
        "longitude": 79.5506314
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.6",
        "reviewCount": "388",
        "bestRating": "5",
        "worstRating": "1"
      },
      "maximumAttendeeCapacity": 100,
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "180° Panoramic Himalayan Snow Peak Views", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Complete Estate Buyout up to 70 guests", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "2,200 Sq. Ft. Peak-Facing Wedding Lawn", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Private 3-BHK Alpine Bridal Villa", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Pine Forest Pool Deck", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "150 Mbps High-Speed Wi-Fi for Live Streaming", "value": true }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Himalayan Destination Wedding Planning Services",
        "itemListElement": WEDDING_SERVICES.map(s => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": s.title,
            "description": `${s.tagline} — ${s.description}`
          }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://whisperingpinesresort.in/destination-wedding-uttarakhand/#faq",
      "mainEntity": FAQS.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout
  title="Destination Wedding in Uttarakhand | Whispering Pines Resort Ramgarh"
  description="Plan your intimate destination wedding in Uttarakhand at Whispering Pines Resort by Casa De Bello. 180° Nanda Devi snow peaks, private estate buyout up to 70 guests, 2,200 sq. ft. wedding lawn."
  canonical="/destination-wedding-uttarakhand/"
  image="/images/destination-wedding/destination-weddings-uttarkahnd.avif"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(venueSchema)} />
  </Fragment>

  <div class="relative w-full bg-[#FAF9F6] text-[#2C3531] overflow-x-hidden selection:bg-[#c9a832] selection:text-[#1B3322]">
    
    {/* ========================================================================= */}
    {/* [SECTION 1: HERO] */}
    {/* ========================================================================= */}
    <header class="relative min-h-[92vh] flex items-center justify-center bg-[#1B3322] text-[#FAF9F6] pt-12 pb-20 sm:pb-24 overflow-hidden border-b border-[#c9a832]/20">
      {/* Background Imagery with Subtle Editorial Vignette */}
      <div class="absolute inset-0 z-0">
        <img
          src="/images/destination-wedding/destination-weddings-uttarkahnd.avif"
          alt="Real Himalayan destination wedding mandap overlooking snow peaks at Whispering Pines Resort"
          class="w-full h-full object-cover object-center filter brightness-[0.32]"
          loading="eager"
          fetchpriority="high"
        />
        {/* Multi-layered dark forest scrims for razor-sharp typography contrast */}
        <div class="absolute inset-0 bg-gradient-to-t from-[#1B3322] via-[#1B3322]/70 to-[#1B3322]/85" />
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#1B3322]/80 via-[#1B3322]/55 to-[#1B3322]/95 pointer-events-none" />
      </div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {/* Eyebrow Badge */}
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#1B3322]/80 backdrop-blur-md border border-[#c9a832]/45 mb-8 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#c9a832]"></span>
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#c9a832] font-semibold">
            HIMALAYAN DESTINATION WEDDINGS · Uttarakhand
          </span>
        </div>

        {/* Main Title (H1) with Optical Drop Shadow */}
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-normal text-[#FAF9F6] tracking-tight leading-[1.1] mb-6 max-w-4xl mx-auto text-balance drop-shadow-[0_2px_14px_rgba(0,0,0,0.7)]">
          Say Goodbye to Stressful Planning for Your Dream Destination Wedding
        </h1>

        {/* Editorial Gold Hairline Rule */}
        <div class="w-20 h-[1.5px] bg-[#c9a832] mx-auto mb-6 opacity-90 shadow-xs" />

        {/* Lead Paragraph with High-Contrast Legibility */}
        <p class="font-sans text-base sm:text-lg lg:text-xl text-[#FAF9F6]/95 font-light leading-relaxed max-w-3xl mx-auto mb-10 text-pretty drop-shadow-[0_1px_6px_rgba(0,0,0,0.5)]">
          Exchange sacred vows amidst fragrant pine forests and 180° unobstructed panoramic views of the Nanda Devi and Trishul snow peaks. Whispering Pines Resort by Casa De Bello offers an intimate 4-star mountain sanctuary where refined alpine architecture meets timeless family celebrations.
        </p>

        {/* CTA Buttons */}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 mb-14">
          {/* Primary CTA: WhatsApp */}
          <a
            href="https://wa.me/917505029696"
            target="_blank"
            rel="noopener noreferrer"
            onclick="window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: 'generate_lead', event_category: 'wedding', event_label: 'hero_whatsapp_click' });"
            class="w-full sm:w-auto btn-shimmer inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#1EBE5D] text-white font-mono text-xs uppercase tracking-[0.16em] font-semibold transition-all duration-300 shadow-luxury-md hover:scale-[1.02]"
          >
            {/* Authentic WhatsApp SVG Logo */}
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Inquire via WhatsApp</span>
          </a>

          {/* Secondary CTA: Scroll to Proposal Form */}
          <a
            href="#wedding-inquiry"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-[#FAF9F6]/10 hover:bg-[#FAF9F6]/20 text-[#FAF9F6] border border-[#FAF9F6]/25 font-mono text-xs uppercase tracking-[0.16em] font-semibold transition-all duration-300 backdrop-blur-sm"
          >
            <span>Request Custom Proposal</span>
            <ArrowUpRight className="w-4 h-4 text-[#c9a832]" />
          </a>
        </div>

        {/* Trust Indicators Bar (4 clean stats) */}
        <div class="border-t border-[#FAF9F6]/15 pt-8 mt-4">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-left sm:text-center">
            {/* Stat 1 */}
            <div class="space-y-1">
              <span class="font-mono text-xl sm:text-2xl font-normal text-[#c9a832] block tnum">
                180°
              </span>
              <p class="font-sans text-xs text-[#FAF9F6]/80 leading-snug">
                Panoramic Himalayan Snow Peak Views
              </p>
            </div>

            {/* Stat 2 */}
            <div class="space-y-1 sm:border-l sm:border-[#FAF9F6]/15 sm:pl-4">
              <span class="font-mono text-xl sm:text-2xl font-normal text-[#c9a832] block tnum">
                70 Guests
              </span>
              <p class="font-sans text-xs text-[#FAF9F6]/80 leading-snug">
                Complete Estate Buyout (Up to 70 Residential Guests)
              </p>
            </div>

            {/* Stat 3 */}
            <div class="space-y-1 sm:border-l sm:border-[#FAF9F6]/15 sm:pl-4">
              <span class="font-mono text-xl sm:text-2xl font-normal text-[#c9a832] block tnum">
                2,200 Sq. Ft.
              </span>
              <p class="font-sans text-xs text-[#FAF9F6]/80 leading-snug">
                Peak-Facing Wedding Lawn
              </p>
            </div>

            {/* Stat 4 */}
            <div class="space-y-1 sm:border-l sm:border-[#FAF9F6]/15 sm:pl-4">
              <div class="flex items-center sm:justify-center gap-1 text-[#c9a832]">
                <Star className="w-4 h-4 fill-current text-[#c9a832]" />
                <span class="font-mono text-xl sm:text-2xl font-normal text-[#c9a832] tnum">
                  4.6/5
                </span>
              </div>
              <p class="font-sans text-xs text-[#FAF9F6]/80 leading-snug">
                Rated on Google (388+ Verified Reviews)
              </p>
            </div>
          </div>
        </div>

      </div>
    </header>

    {/* ========================================================================= */}
    {/* [SECTION 2: THE DESTINATION ESSENCE] */}
    {/* ========================================================================= */}
    <section class="py-24 sm:py-32 bg-[#FAF9F6] border-b border-[#1B3322]/10 relative">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          {/* Narrative Column */}
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-2">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-[#C27847] font-semibold block">
                THE EXPERIENCE
              </span>
              <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-normal text-[#1B3322] leading-tight text-balance">
                An Intimate Mountain Sanctuary for Your Inner Circle
              </h2>
              <div class="w-16 h-[1.5px] bg-[#c9a832] mt-4" />
            </div>

            {/* Narrative Copy with Editorial Drop Cap */}
            <p class="font-sans text-base sm:text-lg text-[#2C3531]/85 font-light leading-relaxed drop-cap-editorial">
              A wedding is a sacred gathering of two families celebrating new beginnings. Moving away from crowded city banquet halls and rushed schedules, Whispering Pines Resort transforms into your family’s private mountain estate. Located at 1,780 metres in Malla Ramgarh along the Bhowali-Mukteshwar corridor—just 45 minutes from Kainchi Dham and 25 km from Mukteshwar Dham—our property offers 100% exclusive privacy, artisanal hospitality, and panoramic Himalayan vistas for up to 100 event guests.
            </p>

            {/* Editorial Coordinates / Highlight Bar */}
            <div class="hairline-y py-5 mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono text-[#2C3531]/75">
