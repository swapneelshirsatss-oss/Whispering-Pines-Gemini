---
// Homepage redesign 2026-11-18: editorial layout in components/home/LuxuryHome.astro.
// Amenities, services, booking form and nearby-sights list moved off the homepage (they have
// their own pages and are linked from the new sections). Their components are unchanged.
// Previous version: git show HEAD:src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ResortLodgingSchema from '../components/ResortLodgingSchema.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import LuxuryHome from "../components/home/LuxuryHome.astro";
import HostFieldNote from "../components/HostFieldNote.astro";
import BlogCarousel from "../components/BlogCarousel";
import { BLOG_CARDS } from "../data/blogPosts";
import FAQAccordion from "../components/FAQAccordion";
---

<Layout
  title="Resort in Mukteshwar | 180° Himalayan Views & Private Villa"
  description="4-star resort in Mukteshwar at 1,780 m: 25 rooms and a 10-guest villa, Nanda Devi views from every room, orchards, 150 Mbps Wi-Fi. Book direct, save up to 20%."
>
  <ResortLodgingSchema slot="head" />

  <div class="relative w-full text-[#0E2C21] overflow-x-hidden pb-20 md:pb-0 selection:bg-[#B0966D] selection:text-[#0E2C21]">
    <Breadcrumbs />

    <div>
      <LuxuryHome />

      {/* Verified resident host note (E-E-A-T) */}
      <HostFieldNote />

      <BlogCarousel posts={BLOG_CARDS} client:visible />

      <FAQAccordion client:visible />
    </div>
  </div>
</Layout>
