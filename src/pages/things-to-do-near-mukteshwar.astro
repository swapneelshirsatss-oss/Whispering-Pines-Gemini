---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import LocalExperiencesList from "../components/LocalExperiencesList.astro";
import SlowLivingRhythm from "../components/SlowLivingRhythm.astro";
import SEOExperiencesContent from "../components/SEOExperiencesContent.astro";
import DistanceTransitMatrix from "../components/DistanceTransitMatrix.astro";
import RecentBookingNotification from "../components/RecentBookingNotification";
import FAQAccordion from "../components/FAQAccordion";

const intro = "The top things to do near Mukteshwar and Ramgarh are Kainchi Dham Ashram (22 km, about 45 min from Whispering Pines), Mukteshwar Dham temple and Chauli Ki Jali (25 km, 45–50 min), Bhalu Gaad Waterfall (16 km, 35 min), Naini Lake in Nainital (26 km, 55 min) and Bhimtal Lake (26 km, 50 min), plus Ramgarh's fruit orchards.";

// Visible FAQs; Layout prints the matching FAQPage schema from the same array.
const thingsFaqs = [
  {
    question: 'What are the best places to visit near Mukteshwar?',
    answer: 'The most visited are Mukteshwar Dham temple and Chauli Ki Jali, Kainchi Dham Ashram, Bhalu Gaad Waterfall, Naini Lake and Mall Road in Nainital, Bhimtal Lake, and the fruit orchards of Ramgarh.',
  },
  {
    question: 'How far is Kainchi Dham from Whispering Pines Resort?',
    answer: 'Kainchi Dham (Neem Karoli Baba Ashram) is 22 km from Whispering Pines in Malla Ramgarh, about a 45-minute drive.',
  },
  {
    question: 'How far is Mukteshwar Dham from the resort?',
    answer: 'Mukteshwar Dham temple and Chauli Ki Jali are 25 km from Whispering Pines, about a 45 to 50-minute drive along the Bhowali-Ramgarh-Mukteshwar Road.',
  },
  {
    question: 'Is there a waterfall near Ramgarh?',
    answer: 'Yes. Bhalu Gaad Waterfall is 16 km from Whispering Pines, about a 35-minute drive, followed by a forest trek through pine and oak to the falls.',
  },
  {
    question: 'How far are Nainital and Bhimtal from the resort?',
    answer: 'Naini Lake and Mall Road in Nainital are 26 km away (about 55 minutes). Bhimtal Lake is also 26 km away (about 50 minutes).',
  },
  {
    question: 'Can the resort arrange day trips?',
    answer: 'Yes. The travel desk at Whispering Pines books cabs and day trips to Kainchi Dham, Mukteshwar Dham, Nainital and other sights. Message the front desk on WhatsApp at +91 75050 29696.',
  },
];
---

<Layout
  title="Things to Do Near Mukteshwar & Ramgarh | Sightseeing Guide 2026"
  description="Discover the best things to do near Mukteshwar and Ramgarh. Verified driving distances and routes to Kainchi Dham, Mukteshwar Temple, Naini Lake, and Bhimtal."
  faqs={thingsFaqs}
>
  <div class="relative w-full bg-[#FAF9F6] text-[#0E2C21] overflow-x-hidden selection:bg-[#B0966D] selection:text-[#0E2C21]">
    <Breadcrumbs />
    <div class="bg-[#FAF9F6]">
      <LocalExperiencesList
        hideLink={true}
        asH1={true}
        title="Things to Do Near Mukteshwar — Local Sights & Highland Experiences from Ramgarh, Uttarakhand"
        intro={intro}
      />
      
      {/* Distance & Transit Matrix */}
      <DistanceTransitMatrix 
        initialCategory="local_sights"
        className="bg-white border-y border-[#EAE8E3]"
        title="Sightseeing & Transit Distance Matrix — Drive Times from Whispering Pines"
        subtitle="Plan your Kumaon day trips with verified driving distances, estimated durations, and direct Google Maps route navigation from our resort in Malla Ramgarh."
      />

      <SEOExperiencesContent />
      <FAQAccordion
        client:visible
        faqs={thingsFaqs}
        title="Things to Do Near Mukteshwar: Questions We Get Asked"
        description="Distances to Kainchi Dham, Mukteshwar Dham, Bhalu Gaad, Nainital and Bhimtal, and day trips."
      />
    </div>
    <RecentBookingNotification client:idle />
  </div>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ItemList",
        "name": "Top Things to Do Near Mukteshwar & Ramgarh",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Kainchi Dham Ashram (Neem Karoli Baba)",
            "description": "World-renowned spiritual retreat visited by global leaders and spiritual seekers. 22 km (~45 mins drive) from Whispering Pines Resort.",
            "url": "https://whisperingpinesresort.in/blog/resort-stay-near-kainchi-dham/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Mukteshwar Dham & Chauli Ki Jali",
            "description": "350-year-old Shiva temple and dramatic clifftop rock formation offering vertical valley views and sunset panoramas. 25 km (~45-50 mins drive).",
            "url": "https://whisperingpinesresort.in/things-to-do-near-mukteshwar/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Bhalu Gaad Waterfall",
            "description": "Hidden 60-foot cascading mountain waterfall reached via a scenic forest trek through pine and oak canopies. 16 km (~35 mins drive).",
            "url": "https://whisperingpinesresort.in/things-to-do-near-mukteshwar/"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": "Tagore Top & Literary Heritage Trails",
            "description": "Historic ridge in Ramgarh where Rabindranath Tagore composed parts of Gitanjali.",
            "url": "https://whisperingpinesresort.in/things-to-do-near-mukteshwar/"
          },
          {
            "@type": "ListItem",
            "position": 5,
            "name": "Naini Lake & Mall Road, Nainital",
            "description": "Iconic pear-shaped mountain lake, Naina Devi temple, and colonial shopping promenade. 26 km (~55 mins drive).",
            "url": "https://whisperingpinesresort.in/blog/resort-near-nainital/"
          }
        ]
      }
    ]
  })} />
</Layout>
