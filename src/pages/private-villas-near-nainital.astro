---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RoomInventoryList from "../components/RoomInventoryList";
import BookingInteractiveForm from "../components/BookingInteractiveForm";
import RecentBookingNotification from "../components/RecentBookingNotification";
import FAQAccordion from "../components/FAQAccordion";
import { Home, Trees, ShieldCheck, Heart } from "lucide-react";

const villaFaqs = [
  {
    "question": "Is there a 3 BHK villa near Nainital for a family of 10?",
    "answer": "Yes. Our 3-BHK Private Alpine Villa in Malla Ramgarh sleeps up to 10 in three king bedrooms and a loft, with three en-suite bathrooms. You book the whole villa, so your group has it to yourselves.",
    "category": "Private Villa"
  },
  {
    "question": "Is the private villa near Nainital pet-friendly?",
    "answer": "Yes. Pets stay free, and the villa has its own enclosed orchard lawn where dogs can run.",
    "category": "Private Villa"
  },
  {
    "question": "How far is the villa from Nainital?",
    "answer": "26 km, about 55 minutes by road via Bhowali. Mukteshwar Dham is 25 km (about 45 minutes) and Kainchi Dham 22 km (about 45 minutes).",
    "category": "Private Villa"
  },
  {
    "question": "How much does the private villa cost per night?",
    "answer": "₹15,999 a night including breakfast, with ₹1,200 a night for each extra guest. Rates change with the season, so message us on WhatsApp for your dates. Booking direct gets you up to 20% off and our best rate guarantee.",
    "category": "Private Villa"
  },
  {
    "question": "Does the villa have a kitchen?",
    "answer": "Yes. It has its own kitchen for self-catering, and you can also order from the resort restaurant.",
    "category": "Private Villa"
  },
  {
    "question": "Is the villa good for a weekend stay near Nainital?",
    "answer": "Yes. It's close enough to Nainital for a day trip to the lake, but quiet, with a fireplace in the living room and bonfire evenings at the resort.",
    "category": "Private Villa"
  }
];
const waVilla = "https://wa.me/917505029696?text=" + encodeURIComponent("Hi, I'd like the private villa. Dates: ___, guests: ___");
---

<Layout 
  title="Private 3-BHK Villa Near Nainital for 10 | Pet-Friendly" 
  description="Private 3-BHK villa 26 km from Nainital in Malla Ramgarh: sleeps 10, own orchard lawn, fireplace, Nanda Devi views, pets free. ₹15,999/night incl. breakfast."
  faqs={villaFaqs}
>
  <div class="relative w-full bg-[#FAF9F6] text-[#0E2C21] overflow-x-hidden selection:bg-[#B0966D] selection:text-[#0E2C21]">
    <Breadcrumbs />
    
    <main class="pt-24">
      {/* Room Inventory List filtered to 'villa' */}
      <RoomInventoryList 
        client:visible
        hideLink={true} 
        initialFilter="villa" 
        title="Private 3-BHK Villa Near Nainital, Sleeps 10 (Malla Ramgarh)"
        categoryIntro="Mukteshwar & Malla Ramgarh's Most Exclusive Nature Retreat — Your Private Alpine Estate"
        isH1={true}
      />

      {/* Quick answer + at a glance + direct booking CTAs */}
      <section class="bg-white border-t border-[#2C3531]/5">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-5">
          <div class="aeo-direct-answer bg-[#FAF9F6] p-6 rounded-sm border-l-4 border-[#8A6F4A] space-y-4">
            <div class="text-xs font-bold text-[#7A6038] uppercase tracking-widest">Quick answer: private villa near Nainital</div>
            <p class="text-sm sm:text-base text-[#2C3531]/85 leading-relaxed font-light">Whispering Pines' 3-BHK Private Alpine Villa is in Malla Ramgarh, 26 km (about 55 min) from Nainital, at 1,780m. It sleeps 10 in three king bedrooms and a loft, with its own orchard lawn, fireplace, kitchen and 180° Nanda Devi views. Pets stay free. ₹15,999 a night incl. breakfast, up to 20% off direct.</p>
            <ul class="flex flex-wrap gap-2 text-xs text-[#0E2C21]">
              <li class="px-3 py-1.5 bg-white border border-[#EAE8E3] rounded-full">Sleeps 10</li>
              <li class="px-3 py-1.5 bg-white border border-[#EAE8E3] rounded-full">3 king bedrooms + loft</li>
              <li class="px-3 py-1.5 bg-white border border-[#EAE8E3] rounded-full">26 km from Nainital</li>
              <li class="px-3 py-1.5 bg-white border border-[#EAE8E3] rounded-full">Pets stay free</li>
              <li class="px-3 py-1.5 bg-white border border-[#EAE8E3] rounded-full">₹15,999 incl. breakfast</li>
            </ul>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href={waVilla} target="_blank" rel="noopener noreferrer"
                data-track-fn="trackBookingConversion" data-track-args='["generate_lead","booking","villa_answer_whatsapp",{"conversion_type":"whatsapp"}]'
                class="inline-flex flex-col items-center justify-center px-6 py-3 bg-[#0E2C21] text-white rounded-sm hover:bg-[#1a4535] transition-colors text-center">
                <span class="text-sm font-bold">WhatsApp for villa dates: up to 20% off</span>
                <span class="text-[11px] text-white/80">Best rate guaranteed + direct-only perks</span>
              </a>
              <a href="tel:+917505029696"
                data-track-fn="trackBookingConversion" data-track-args='["phone_call_click","engagement","villa_answer_phone_call",{"conversion_type":"phone","phone_number":"7505029696"}]'
                class="inline-flex items-center justify-center px-6 py-3 border border-[#0E2C21] text-[#0E2C21] font-bold text-sm rounded-sm hover:bg-[#0E2C21] hover:text-white transition-colors">
                Call 075050 29696
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* Villa Architecture Section */}
      <section class="py-20 lg:py-28 bg-white border-t border-[#2C3531]/5">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-4 flex items-center justify-center">
              <div class="w-16 h-16 bg-[#0E2C21]/5 rounded-full flex items-center justify-center text-[#B0966D]">
                <Home className="w-8 h-8" />
              </div>
            </div>
            <div class="md:col-span-8 space-y-4">
              <h2 class="font-display text-3xl font-bold text-[#0E2C21]">
                Built for the Mountains
              </h2>
              <div class="w-12 h-[2px] bg-[#B0966D]" />
              <p class="text-sm sm:text-base text-[#2C3531]/80 leading-relaxed font-sans font-light">
                Our private villa near Nainital is built for the high-altitude Himalayan environment using hand-hewn mountain stones and solid pine wood finishes. As a signature feature of our Ramgarh retreat, this Kumaoni-inspired architectural design naturally retains cozy warmth during the winter and stays cool during summer fruit harvests.
              </p>
              <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-[#2C3531]/5 pt-6">
                {[
                  "Artisanal Stone Masonry by Native Kumaoni Craftsmen",
                  "Double-Height Cedar Wood Trusses & Warm Timber Flooring",
                  "Glass-Pane Windows Framing Nanda Devi & Trishul Peaks",
                  "Heritage Alpine Design Meets 4-Star Modern Comfort"
                ].map((feat) => (
                  <div class="flex items-start text-xs text-[#2C3531]/80">
                    <span class="w-1.5 h-1.5 bg-[#B0966D] rounded-full mr-2.5 mt-1.5 shrink-0" />
                    <h3 class="font-sans font-light leading-relaxed">{feat}</h3>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Inside the Villa Section */}
      <section class="py-20 lg:py-28 bg-[#0E2C21]/5 border-t border-[#2C3531]/5">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-8 space-y-4 order-2 md:order-1">
              <h2 class="font-display text-3xl font-bold text-[#0E2C21]">
                What's Inside Your Private Villa Near Nainital
              </h2>
              <div class="w-12 h-[2px] bg-[#B0966D]" />
              <p class="text-sm sm:text-base text-[#2C3531]/80 leading-relaxed font-sans font-light">
                Step into the premium interiors of the villa. Designed as a luxury Ramgarh retreat, the property features three grand king bedrooms with dedicated en-suite bathrooms, a wood attic loft, a stone fireplace, and a full kitchen built for self-catering family holidays.
              </p>
              <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-[#0E2C21]/10 pt-6">
                {[
                  "3 Grand King Bedrooms + Loft — Sleeps Up to 10 Guests",
                  "3 Private En-Suite Baths with Hot Showers",
                  "Homestyle Kitchen for Self-Catering Stays",
                  "Luxury Stone Fireplace Living Room for Winter Evenings"
                ].map((feat) => (
                  <div class="flex items-start text-xs text-[#2C3531]/80">
                    <span class="w-1.5 h-1.5 bg-[#B0966D] rounded-full mr-2.5 mt-1.5 shrink-0" />
                    <h3 class="font-sans font-light leading-relaxed">{feat}</h3>
                  </div>
                ))}
              </div>
            </div>
            <div class="md:col-span-4 flex items-center justify-center order-1 md:order-2">
              <div class="w-16 h-16 bg-[#0E2C21]/5 rounded-full flex items-center justify-center text-[#B0966D]">
                <ShieldCheck className="w-8 h-8" />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Orchard & Outdoors Section */}
      <section class="py-20 lg:py-28 bg-white border-t border-[#2C3531]/5">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-4 flex items-center justify-center">
              <div class="w-16 h-16 bg-[#0E2C21]/5 rounded-full flex items-center justify-center text-[#B0966D]">
                <Trees className="w-8 h-8" />
              </div>
            </div>
            <div class="md:col-span-8 space-y-4">
              <h2 class="font-display text-3xl font-bold text-[#0E2C21]">
                Private Fruit Orchard, Pine Trails & Open Himalayan Skies
              </h2>
              <div class="w-12 h-[2px] bg-[#B0966D]" />
              <p class="text-sm sm:text-base text-[#2C3531]/80 leading-relaxed font-sans font-light">
                Enjoy absolute peace at our Ramgarh retreat, surrounded by private working orchards of apple, peach, and plum trees. Villa guests get direct access to deodar walking trails and 180° views of the snow-clad Nanda Devi range.
              </p>
              <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-[#2C3531]/5 pt-6">
                {[
                  "Wake Up Inside a Working Peach, Plum & Apple Orchard",
                  "Bonfire Pit & Outdoor BBQ Grill on Private Lawn",
                  "Direct Access to Deodar & Pine Forest Walking Trails",
                  "180° Unobstructed Himalayan Panorama from Your Balcony"
                ].map((feat) => (
                  <div class="flex items-start text-xs text-[#2C3531]/80">
                    <span class="w-1.5 h-1.5 bg-[#B0966D] rounded-full mr-2.5 mt-1.5 shrink-0" />
                    <h3 class="font-sans font-light leading-relaxed">{feat}</h3>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Who it's For Section */}
      <section class="py-20 lg:py-28 bg-[#0E2C21]/5 border-t border-[#2C3531]/5">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <div class="md:col-span-8 space-y-4 order-2 md:order-1">
              <h2 class="font-display text-3xl font-bold text-[#0E2C21]">
                Perfect For — Families, Honeymooners & Group Nature Retreats
              </h2>
              <div class="w-12 h-[2px] bg-[#B0966D]" />
              <p class="text-sm sm:text-base text-[#2C3531]/80 leading-relaxed font-sans font-light">
                The villa suits multi-generational family getaways, peaceful honeymoons, and corporate groups seeking a Ramgarh retreat with high-speed 150 Mbps fiber connectivity, gated privacy, and dedicated on-site catering.
              </p>
              <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-[#0E2C21]/10 pt-6">
                {[
                  "Multi-Generational Family Holidays Near Nainital",
                  "Honeymoon & Couples' Nature Retreat in Uttarakhand",
                  "Corporate Offsite & Team Workcation Ramgarh Stays",
                  "Pet-Friendly Villa — Safe Enclosed Lawns for Dogs"
                ].map((feat) => (
                  <div class="flex items-start text-xs text-[#2C3531]/80">
                    <span class="w-1.5 h-1.5 bg-[#B0966D] rounded-full mr-2.5 mt-1.5 shrink-0" />
                    <h3 class="font-sans font-light leading-relaxed">{feat}</h3>
                  </div>
                ))}
              </div>
            </div>
            <div class="md:col-span-4 flex items-center justify-center order-1 md:order-2">
              <div class="w-16 h-16 bg-[#0E2C21]/5 rounded-full flex items-center justify-center text-[#B0966D]">
                <Heart className="w-8 h-8" />
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Villa FAQs (visible; Layout prints the matching FAQPage schema) */}
      <FAQAccordion
        client:visible
        faqs={villaFaqs}
        title="Private Villa Near Nainital: Questions We Get Asked"
        description="Capacity, pets, distance from Nainital, price and what's included."
      />

      {/* Travel Guides Link Section */}
      <section class="bg-white rounded-sm p-8 border border-[#EAE8E3] shadow-sm text-center space-y-4">
        <span class="text-xs font-sans text-[#7A6038] uppercase tracking-[0.1em] font-semibold block">Himalayan Travel Journal</span>
        <h2 class="font-display text-2xl font-bold text-[#0E2C21]">Explore Our Detailed Destination & Accommodation Guides</h2>
        <p class="text-sm text-gray-600 font-light max-w-2xl mx-auto">Planning your trip to Nainital or Mukteshwar? Read our official 2026 travel guides authored by Gaurav Pandey.</p>
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a href="/blog/resort-near-nainital/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#0E2C21] text-[#B0966D] font-semibold text-xs rounded-full hover:bg-[#B0966D] hover:text-[#0E2C21] transition-colors">
            Resort near Nainital Guide →
          </a>
          <a href="/blog/best-resort-to-stay-near-mukteshwar/" class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#FAF9F6] text-[#0E2C21] font-semibold text-xs rounded-full border border-[#EAE8E3] hover:border-[#8A6F4A] transition-colors">
            Best resorts in Mukteshwar →
          </a>
        </div>
      </section>

      {/* Booking Section */}
      <BookingInteractiveForm 
        client:visible
        title="Reserve Your Villa Near Nainital — Direct Booking, Best Price" 
        features={[
          "Entire Villa Available on Exclusive Rental Basis",
          "Best Rate Guaranteed on Direct WhatsApp Booking",
          "Secure UPI & Credit Card Payment — Instant Confirmation"
        ]}
      />
    </main>
    <RecentBookingNotification client:idle />
  </div>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Accommodation",
  "@id": "https://whisperingpinesresort.in/private-villas-near-nainital/#villa",
  "name": "3-BHK Private Alpine Villa",
  "description": "Standalone private villa in Malla Ramgarh, 26 km from Nainital and 25 km from Mukteshwar Dham. Three king bedrooms plus a loft, three en-suite bathrooms, living room with fireplace, kitchen and private orchard lawn with 180° Nanda Devi views. Sleeps up to 10.",
  "containedInPlace": {
    "@id": "https://whisperingpinesresort.in/#hotel"
  },
  "occupancy": {
    "@type": "QuantitativeValue",
    "maxValue": 10,
    "unitText": "Person"
  },
  "numberOfBedrooms": 3,
  "numberOfBathroomsTotal": 3,
  "petsAllowed": true,
  "amenityFeature": [
    {
      "@type": "LocationFeatureSpecification",
      "name": "180° Nanda Devi & Trishul Peak Views",
      "value": true
    },
    {
      "@type": "LocationFeatureSpecification",
      "name": "Private Fruit Orchard Lawn",
      "value": true
    },
    {
      "@type": "LocationFeatureSpecification",
      "name": "Fireplace Living Room",
      "value": true
    },
    {
      "@type": "LocationFeatureSpecification",
      "name": "Fully Equipped Kitchen",
      "value": true
    },
    {
      "@type": "LocationFeatureSpecification",
      "name": "150 Mbps Fiber Wi-Fi",
      "value": true
    }
  ]
})} />
</Layout>
