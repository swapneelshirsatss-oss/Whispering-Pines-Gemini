---
interface Props {
  className?: string;
  iconOnly?: boolean;
}

const { className = "", iconOnly = false } = Astro.props;
---

{iconOnly ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="-150 -150 300 300"
    class={`w-10 h-10  transition-transform duration-300 ${className}`}
    fill="none"
    role="img"
    aria-label="Whispering Pines Resort Crest"
  >
    <defs>
      <linearGradient id="astro-gold-crest" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#FFF0BE" />
        <stop offset=".35" stop-color="#C4A77D" />
        <stop offset=".65" stop-color="#7A6038" />
        <stop offset="1" stop-color="#F8E3A3" />
      </linearGradient>

      <path
        id="astro-petal-crest"
        d="M0,0 C-61,-32 -62,-90 0,-137 C62,-90 61,-32 0,0Z"
      />
      <path
        id="astro-innerPetal-crest"
        d="M0,0 C-30,-20 -30,-52 0,-77 C30,-52 30,-20 0,0Z"
      />
    </defs>

    <g
      fill="none"
      stroke="url(#astro-gold-crest)"
      stroke-width="8"
      stroke-linejoin="round"
    >
      <use href="#astro-petal-crest" />
      <use href="#astro-petal-crest" transform="rotate(90)" />
      <use href="#astro-petal-crest" transform="rotate(180)" />
      <use href="#astro-petal-crest" transform="rotate(270)" />

      <g stroke-width="6">
        <use href="#astro-innerPetal-crest" />
        <use href="#astro-innerPetal-crest" transform="rotate(90)" />
        <use href="#astro-innerPetal-crest" transform="rotate(180)" />
        <use href="#astro-innerPetal-crest" transform="rotate(270)" />
      </g>
    </g>
  </svg>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1200 300"
    class={`h-11 sm:h-12 lg:h-14 w-auto max-w-[236px] sm:max-w-[260px] lg:max-w-[300px] select-none hover:opacity-95 transition-opacity duration-300 ${className}`}
    role="img"
    aria-labelledby="wpr-logo-title-astro"
  >
    <title id="wpr-logo-title-astro">Whispering Pines Resort by Casa De Bello — Mukteshwar</title>

    <defs>
      <linearGradient id="astro-gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#FFF0BE" />
        <stop offset=".45" stop-color="#E2C893" />
        <stop offset="1" stop-color="#C4A77D" />
      </linearGradient>

      <path
        id="astro-petal"
        d="M0,0 C-61,-32 -62,-90 0,-137 C62,-90 61,-32 0,0Z"
      />
      <path
        id="astro-innerPetal"
        d="M0,0 C-30,-20 -30,-52 0,-77 C30,-52 30,-20 0,0Z"
      />
    </defs>

    {/* Transparent background; intended for dark backgrounds */}

    <g
      transform="translate(140 150) scale(.82)"
      fill="none"
      stroke="url(#astro-gold)"
      stroke-width="8"
      stroke-linejoin="round"
    >
      <use href="#astro-petal" />
      <use href="#astro-petal" transform="rotate(90)" />
      <use href="#astro-petal" transform="rotate(180)" />
      <use href="#astro-petal" transform="rotate(270)" />

      <g stroke-width="6">
        <use href="#astro-innerPetal" />
        <use href="#astro-innerPetal" transform="rotate(90)" />
        <use href="#astro-innerPetal" transform="rotate(180)" />
        <use href="#astro-innerPetal" transform="rotate(270)" />
      </g>
    </g>

    <path
      d="M285,45 V255"
      stroke="url(#astro-gold)"
      stroke-width="2"
    />

    <g
      text-anchor="middle"
      font-family="Georgia, 'Times New Roman', serif"
    >
      <text
        x="745"
        y="74"
        fill="#FFF9E9"
        font-size="46"
        font-weight="bold"
        letter-spacing="3"
      >
        WHISPERING PINES RESORT
      </text>

      <text
        x="745"
        y="116"
        fill="#E2C893"
        font-size="30"
        font-style="italic"
      >
        by
      </text>

      {/* Dominant brand */}
      <text
        x="745"
        y="190"
        fill="url(#astro-gold)"
        font-size="80"
        font-weight="bold"
        letter-spacing="3"
      >
        CASA DE BELLO
      </text>

      <path
        d="M430,216 H1060"
        fill="none"
        stroke="url(#astro-gold)"
        stroke-width="1.5"
      />

      <text
        x="749"
        y="266"
        fill="#FFF9E9"
        font-size="36"
        letter-spacing="14"
      >
        MUKTESHWAR
      </text>
    </g>
  </svg>
)}
