---
// The "Configure Your Stay" rate calculator shared by the Google Ads landing pages.
// Lifted verbatim out of src/pages/book-now.astro so the second landing page does not
// carry a copy of the same 250 lines. Element ids are fixed, so one instance per page.
//
// The inline script fills the room dropdown, counts nights, builds the pre-filled
// WhatsApp message with Ads attribution, and sets the dynamic conversion value.
interface Props {
  /** Small label above the heading. */
  eyebrow?: string;
  heading?: string;
  intro?: string;
  /** Shown in the summary panel and in the WhatsApp message. */
  location?: string;
  /** Prefix for the GTM event labels, so the two pages stay apart in reporting. */
  source?: string;
  phoneDisplay?: string;
  phoneTel?: string;
}

const {
  eyebrow = 'Direct Booking',
  heading = 'Configure Your Stay',
  intro = 'Pick a room and your dates. The front desk checks what is free for those nights and replies on WhatsApp with photos and the direct rate.',
  location = 'Malla Ramgarh, Mukteshwar Rd (1,780 m)',
  source = 'calculator',
  phoneDisplay = '075050 29696',
  phoneTel = '+917505029696',
} = Astro.props;

// CP (breakfast) and MAP (breakfast + dinner) tariffs, mirroring the booking engine.
const ROOMS = [
  { id: 'deluxe-cp', name: 'Deluxe Room with Himalayan View — CP ₹3,500 / night (breakfast)', basePrice: 3500 },
  { id: 'deluxe-map', name: 'Deluxe Room with Himalayan View — MAP ₹4,000 / night (breakfast + dinner)', basePrice: 4000 },
  { id: 'premium-cp', name: 'Premium Room with Himalayan View — CP ₹5,500 / night (breakfast)', default: true, basePrice: 5500 },
  { id: 'premium-map', name: 'Premium Room with Himalayan View — MAP ₹6,500 / night (breakfast + dinner)', basePrice: 6500 },
  { id: 'cottage-cp', name: 'Cottage Room with Himalayan View — CP ₹7,500 / night (breakfast)', basePrice: 7500 },
  { id: 'cottage-map', name: 'Cottage Room with Himalayan View — MAP ₹8,500 / night (breakfast + dinner)', basePrice: 8500 },
  { id: 'familysuite-cp', name: 'Family Twin-Bed Room, sleeps 4 — CP ₹10,000 / night (breakfast)', basePrice: 10000 },
  { id: 'familysuite-map', name: 'Family Twin-Bed Room, sleeps 4 — MAP ₹12,000 / night (breakfast + dinner)', basePrice: 12000 },
];

const phoneTrackArgs = JSON.stringify([
  'phone_call_click', 'engagement', `${source}_phone_call`,
  { conversion_type: 'phone', phone_number: '7505029696' },
]);
---

<div class="text-center max-w-2xl mx-auto mb-14">
  <span class="text-xs font-sans font-bold tracking-[0.1em] text-[#C4A77D] uppercase block mb-3">
    {eyebrow}
  </span>
  <h2 class="font-display text-3xl sm:text-4xl font-semibold text-white leading-tight">
    {heading}
  </h2>
  <div class="w-16 h-0.5 bg-[#B0966D] mx-auto my-4"></div>
  <p class="text-sm sm:text-sm text-[#FAF7F2]/80 mt-3 leading-relaxed">
    {intro}
  </p>
</div>

<div class="bg-[#051E14] border border-[#B0966D]/40 rounded-sm p-6 sm:p-10 shadow-[0_20px_50px_rgba(0,0,0,0.7)] relative overflow-hidden">

  <form id="direct-booking-calculator" class="space-y-6">

    <div class="grid grid-cols-1 gap-4">
      <div>
        <label for="calc-room" class="block font-mono text-xs uppercase tracking-wider text-[#C4A77D] font-semibold mb-2">
          1. Select your room at Whispering Pines Resort
        </label>
        <select
          id="calc-room"
          class="w-full bg-[#020B07] border border-[#FAF7F2]/20 focus:border-[#B0966D] rounded-sm py-3.5 px-4 text-sm text-[#FAF7F2] focus:outline-none transition-colors cursor-pointer"
        >
          <!-- Populated dynamically via JS -->
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="calc-checkin" class="block font-sans text-xs uppercase tracking-wider text-[#FAF7F2]/70 mb-2">
          Check-In Date
        </label>
        <input
          type="date"
          id="calc-checkin"
          class="w-full bg-[#020B07] border border-[#FAF7F2]/20 focus:border-[#B0966D] rounded-sm py-3.5 px-4 text-sm text-[#FAF7F2] focus:outline-none transition-colors cursor-pointer"
          required
        />
      </div>
      <div>
        <label for="calc-checkout" class="block font-sans text-xs uppercase tracking-wider text-[#FAF7F2]/70 mb-2">
          Check-Out Date
        </label>
        <input
          type="date"
          id="calc-checkout"
          class="w-full bg-[#020B07] border border-[#FAF7F2]/20 focus:border-[#B0966D] rounded-sm py-3.5 px-4 text-sm text-[#FAF7F2] focus:outline-none transition-colors cursor-pointer"
          required
        />
      </div>
    </div>

    <div>
      <label for="calc-guests" class="block font-sans text-xs uppercase tracking-wider text-[#FAF7F2]/70 mb-2">
        Number of Guests &amp; Children
      </label>
      <select
        id="calc-guests"
        class="w-full bg-[#020B07] border border-[#FAF7F2]/20 focus:border-[#B0966D] rounded-sm py-3.5 px-4 text-sm text-[#FAF7F2] focus:outline-none transition-colors cursor-pointer"
      >
        <option value="2 Adults">2 Adults</option>
        <option value="2 Adults + 1 Child">2 Adults + 1 Child</option>
        <option value="4 Guests">4 Guests (Family)</option>
        <option value="5-6 Guests">5 to 6 Guests</option>
        <option value="7-10 Guests (Group Booking)">7 to 10 Guests (Group Booking)</option>
      </select>
    </div>

    <!-- Selected room and rate summary -->
    <div class="p-6 bg-[#020B07] border border-[#B0966D]/30 rounded-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-[10px] font-sans text-[#C4A77D] uppercase tracking-[0.1em] font-semibold block">Your selection</span>
        <div class="flex flex-col gap-1 mt-1">
          <span id="calc-display-hotel" class="text-xs sm:text-sm font-sans text-[#C4A77D] font-bold">Whispering Pines Resort, {location}</span>
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
            <span id="calc-display-room" class="text-xl sm:text-2xl font-bold text-[#FAF7F2]">Premium Room with Himalayan View — CP ₹5,500 / night</span>
            <span id="calc-display-nights" class="text-xs text-[#FAF7F2]/70 font-mono">1 night stay</span>
          </div>
        </div>
        <span class="text-xs text-[#C4A77D] font-sans mt-1.5 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C4A77D]"></span>
          Up to 20% off direct, and you pick the room — not an algorithm
        </span>
      </div>

      <div class="text-left sm:text-right text-xs font-sans text-[#FAF7F2]/70 shrink-0">
        <span class="block text-[#C4A77D] font-bold">No booking fee</span>
        <span>Confirm your dates on WhatsApp</span>
      </div>
    </div>

    <!-- Conversion Actions (WhatsApp + Phone) -->
    <div class="space-y-3 pt-2">
      <div class="grid grid-cols-1 gap-3">
        <button
          type="button"
          id="btn-whatsapp-submit"
          class="w-full bg-[#25D366] hover:bg-[#1EBE5D] text-white font-bold py-4 px-6 rounded-sm shadow-[0_8px_24px_rgba(10,18,15,0.28)] flex items-center justify-center gap-2.5 text-sm uppercase tracking-wider active:scale-[0.98] transition-all cursor-pointer border border-white/20"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
          </span>
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Reserve on WhatsApp (Save up to 20% Direct)</span>
        </button>
      </div>

      <div class="flex items-center justify-center gap-4 pt-1">
        <a
          href={`tel:${phoneTel}`}
          data-track-fn="trackBookingConversion"
          data-track-args={phoneTrackArgs}
          class="inline-flex items-center gap-1.5 text-xs font-sans text-[#FAF7F2]/75 hover:text-[#7A6038] transition-colors"
        >
          <svg class="w-3.5 h-3.5 text-[#7A6038]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Prefer to speak? Call the front desk: {phoneDisplay}</span>
        </a>
      </div>
    </div>

    <div class="text-center text-[11px] text-[#FAF7F2]/65 font-sans pt-2">
      The front desk usually replies within 5 minutes, with a walkthrough video of the room and the payment QR.
    </div>

  </form>
</div>

<script is:inline define:vars={{ CALC_ROOMS: ROOMS, CALC_LOCATION: location, CALC_SOURCE: source }}>
  (function () {
    const hotelInfo = {
      name: 'Whispering Pines Resort by Casa De Bello',
      location: CALC_LOCATION,
      rooms: CALC_ROOMS
    };

    const roomSelect = document.getElementById('calc-room');
    const checkInInput = document.getElementById('calc-checkin');
    const checkOutInput = document.getElementById('calc-checkout');
    const guestsSelect = document.getElementById('calc-guests');
    const hotelDisplay = document.getElementById('calc-display-hotel');
    const roomDisplay = document.getElementById('calc-display-room');
    const nightsDisplay = document.getElementById('calc-display-nights');
    const whatsappBtn = document.getElementById('btn-whatsapp-submit');

    // Initialize default dates: tomorrow and day after
    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(today.getDate() + 1);
    const dayAfter = new Date(tomorrow);
    dayAfter.setDate(tomorrow.getDate() + 1);

    const toDateInputValue = (d) => d.toISOString().split('T')[0];
    if (checkInInput && checkOutInput) {
      checkInInput.value = toDateInputValue(tomorrow);
      checkOutInput.value = toDateInputValue(dayAfter);
      checkInInput.min = toDateInputValue(today);
      checkOutInput.min = toDateInputValue(tomorrow);
    }

    function populateRooms() {
      if (!roomSelect) return;
      roomSelect.innerHTML = '';
      hotelInfo.rooms.forEach(r => {
        const opt = document.createElement('option');
        opt.value = r.name;
        opt.textContent = r.name;
        if (r.default) opt.selected = true;
        roomSelect.appendChild(opt);
      });
    }

    function updateCalculation() {
      if (!roomSelect || !checkInInput || !checkOutInput) return;

      const selectedRoom = roomSelect.value;
      const guests = guestsSelect ? guestsSelect.value : '2 Adults';

      const checkInVal = checkInInput.value;
      const checkOutVal = checkOutInput.value;

      let nights = 1;
      if (checkInVal && checkOutVal) {
        const diffMs = new Date(checkOutVal) - new Date(checkInVal);
        const calculated = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
        if (calculated > 0) nights = calculated;
      }

      if (hotelDisplay) hotelDisplay.textContent = `${hotelInfo.name} (${hotelInfo.location})`;
      if (roomDisplay) roomDisplay.textContent = selectedRoom;
      if (nightsDisplay) nightsDisplay.textContent = `${nights} night${nights > 1 ? 's' : ''} • ${guests}`;

      // Parse Ad & Campaign UTM Attribution (Session Storage + Live URL)
      let attributionTag = '';
      try {
        const rawAttr = sessionStorage.getItem('wpr_ads_attribution');
        const saved = rawAttr ? JSON.parse(rawAttr) : null;
        const urlParams = new URLSearchParams(window.location.search);
        const utmSource = urlParams.get('utm_source') || (saved && saved.utm_source);
        const utmCampaign = urlParams.get('utm_campaign') || (saved && saved.utm_campaign);
        const gclid = urlParams.get('gclid') || (saved && saved.gclid);
        if (utmSource || gclid) {
          attributionTag = `\n🏷️ *Source:* ${utmSource || 'Google Ads'}${utmCampaign ? ` (${utmCampaign})` : ''}${gclid ? ' [Verified Ad Click]' : ''}`;
        }
      } catch (e) {}

      const message =
`Hi! I would like to check availability and direct booking rates at Whispering Pines Resort, ${hotelInfo.location}:

🏨 *Selected Hotel:* ${hotelInfo.name}
📍 *Location:* ${hotelInfo.location}
🏡 *Room:* ${selectedRoom}
📅 *Check-In:* ${checkInVal || 'Flexible'}
📅 *Check-Out:* ${checkOutVal || 'Flexible'} (${nights} night${nights > 1 ? 's' : ''})
👥 *Guests:* ${guests}${attributionTag}

Please confirm availability and share your best direct rate and photos!`;

      const encodedUrl = 'https://wa.me/917505029696?text=' + encodeURIComponent(message);

      // Dynamic conversion value for Smart Bidding
      const currentRoomDef = hotelInfo.rooms.find(r => r.name === selectedRoom);
      const dynamicUnitPrice = currentRoomDef && currentRoomDef.basePrice ? currentRoomDef.basePrice : 3500;
      const totalEstimatedTariff = dynamicUnitPrice * nights;

      if (whatsappBtn) {
        whatsappBtn.onclick = function () {
          if (typeof window.trackBookingConversion === 'function') {
            window.trackBookingConversion('generate_lead', 'booking', `${CALC_SOURCE}_whatsapp_submit`, {
              conversion_type: 'whatsapp',
              hotel: hotelInfo.name,
              room: selectedRoom,
              nights: nights,
              value: totalEstimatedTariff,
              currency: 'INR'
            });
          }
          window.open(encodedUrl, '_blank', 'noopener,noreferrer');
        };
      }

      const desktopFloatingWhatsapp = document.getElementById('desktop-floating-whatsapp');
      if (desktopFloatingWhatsapp) {
        desktopFloatingWhatsapp.href = encodedUrl;
      }
    }

    if (roomSelect) roomSelect.addEventListener('change', updateCalculation);
    if (checkInInput) checkInInput.addEventListener('change', updateCalculation);
    if (checkOutInput) checkOutInput.addEventListener('change', updateCalculation);
    if (guestsSelect) guestsSelect.addEventListener('change', updateCalculation);

    populateRooms();
    updateCalculation();
  })();
</script>
