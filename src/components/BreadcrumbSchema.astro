---
// BreadcrumbSchema.astro
// Dynamic BreadcrumbList JSON-LD Schema for site navigation SEO

export interface BreadcrumbItem {
  name: string;
  item: string;
}

interface Props {
  breadcrumbs?: BreadcrumbItem[];
  title?: string;
}

const { breadcrumbs: customBreadcrumbs, title } = Astro.props;
const siteBase = "https://whisperingpinesresort.in";
const rawPathname = Astro.url.pathname;
const pathname = rawPathname.endsWith('/') ? rawPathname : `${rawPathname}/`;

const pageMap: Record<string, string> = {
  "/": "Home",
  "/about-whispering-pines-resort-ramgarh/": "The Resort",
  "/suites-cottages-ramgarh-resort/": "Cottages and Suites",
  "/private-villas-near-nainital/": "Premium Villas Near Nainital",
  "/resort-amenities-mukteshwar/": "Resort Amenities",
  "/resort-services-ramgarh/": "Premium Services",
  "/things-to-do-near-mukteshwar/": "Things to Do Near Mukteshwar",
  "/gallery/": "Photo Gallery",
  "/reviews/": "Guest Reviews",
  "/blog/": "Journal",
  "/contact-whispering-pines-resort-mukteshwar/": "Contact Us",
  "/privacy-policy/": "Privacy Policy",
  "/terms/": "Terms & Conditions",
  "/sitemap/": "Sitemap"
};

let breadcrumbItems: BreadcrumbItem[] = [];

if (customBreadcrumbs && customBreadcrumbs.length > 0) {
  breadcrumbItems = customBreadcrumbs;
} else if (pathname === "/") {
  breadcrumbItems = [{ name: "Home", item: "https://whisperingpinesresort.in/" }];
} else if (pathname.startsWith("/blog/") && pathname !== "/blog/") {
  // Clean title for blog post breadcrumb if passed with brand suffix
  const cleanTitle = title ? title.split(" | ")[0] : "Article";
  breadcrumbItems = [
    { name: "Home", item: "https://whisperingpinesresort.in/" },
    { name: "Journal", item: "https://whisperingpinesresort.in/blog/" },
    { name: cleanTitle, item: `${siteBase}${pathname}` }
  ];
} else {
  const pageName = pageMap[pathname] || (title ? title.split(" | ")[0] : "Page");
  breadcrumbItems = [
    { name: "Home", item: "https://whisperingpinesresort.in/" },
    { name: pageName, item: `${siteBase}${pathname}` }
  ];
}

const schemaData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((b, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": b.name,
    "item": b.item
  }))
};
---
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
