---
// Compact footer (2026-11-18). Was 2,958px tall on a phone (3.6 screens).
// Kept: every unique internal link (SEO), the schema.org/Resort microdata with exact GBP NAP, phone tracking, socials.
// Removed: duplicate links to the same URL, the embedded Google Map (heavy; the Contact page has the map),
// internal labels ("Verified Resort NAP", "Conversion Optimized..."), decorative glow and pill badge.
// Phones: link groups are <details> (collapsed but in the HTML for crawlers); desktop opens them via the script below.
import { MapPin, Phone, Mail, ArrowUpRight } from 'lucide-react';
import { RESORT_CONTACT } from "../data";
import { siFacebook, siInstagram, siYoutube, siTripadvisor } from 'simple-icons';
import Logo from "./Logo.astro";

const currentYear = new Date().getFullYear();

const groups = [
  {
    title: 'Stay',
    links: [
      ['/suites-cottages-ramgarh-resort/', 'Rooms & suites'],
      ['/private-villas-near-nainital/', '3-BHK villa (sleeps 10)'],
      ['/resort-amenities-mukteshwar/', 'Amenities'],
      ['/resort-services-ramgarh/', 'Dining & services'],
      ['/destination-wedding-uttarakhand/', 'Weddings in Uttarakhand'],
      ['/corporate-offsite-resort-mukteshwar/', 'Corporate retreats'],
      ['/book-now/', 'Book direct (save up to 20%)'],
    ],
  },
  {
    title: 'Explore',
    links: [
      ['/things-to-do-near-mukteshwar/', 'Things to do near Mukteshwar'],
      ['/blog/best-resort-to-stay-near-mukteshwar/', 'Best resorts in Mukteshwar'],
      ['/blog/resort-near-nainital/', 'Resort near Nainital'],
      ['/blog/himalayan-view-resort-uttarakhand/', 'Himalayan view resort, Uttarakhand'],
      ['/blog/resort-stay-near-kainchi-dham/', 'Stay near Kainchi Dham'],
      ['/blog/ramgarh-fruit-bowl-of-kumaon/', 'Ramgarh, fruit bowl of Kumaon'],
      ['/blog/winter-in-the-himalayas/', 'Winter in the Himalayas'],
      ['/blog/destination-wedding-uttarakhand-cost/', 'Uttarakhand wedding cost guide'],
      ['/blog/', 'All guides →'],
    ],
  },
  {
    title: 'About',
    links: [
      ['/about-whispering-pines-resort-ramgarh/', 'About us (formerly Clarks Exotica)'],
      ['/reviews/', 'Guest reviews (4.6★)'],
      ['/gallery/', 'Photo gallery'],
      ['/contact-whispering-pines-resort-mukteshwar/', 'Contact & directions'],
    ],
  },
];

// Official brand marks (simple-icons), inlined at build time: no runtime JS or image requests.
const socials = [
  { icon: siFacebook, url: RESORT_CONTACT.socials?.facebook },
  { icon: siInstagram, url: RESORT_CONTACT.socials?.instagram },
  { icon: siYoutube, url: RESORT_CONTACT.socials?.youtube },
  { icon: siTripadvisor, url: RESORT_CONTACT.socials?.tripadvisor },
].filter((s) => s.url);

// Sister properties (websites from the client profiles; logos from each client's 03_Raw-Media).
const ourHotels = [
  { name: 'Anurra', place: 'Kainchi Dham', url: 'https://anurrakainchidhamhotel.in/', logo: '/images/our-hotels/anurra-kainchi-dham.webp', w: 238, h: 180 },
  { name: 'Casa De Bello', place: 'Kainchi Dham', url: 'https://casadebello.com/', logo: '/images/our-hotels/casa-de-bello-kainchi-dham.webp', w: 360, h: 111 },
  { name: 'Hotel Vikrant', place: 'Nainital', url: 'https://vikranthotelnainital.in/', logo: '/images/our-hotels/hotel-vikrant-nainital.webp', w: 180, h: 180 },
];
---
<footer class="wp-pine-surface text-[#FAF9F6] pt-12 pb-8 border-t border-[#B0966D]/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid gap-6 md:gap-10 md:grid-cols-[1.2fr_2fr] pb-4 md:pb-10 border-b border-[#FAF9F6]/10">

      {/* Brand + contact (schema.org/Resort microdata, exact Google Business Profile NAP) */}
      <div class="space-y-5">
        <Logo idPrefix="astro-ft" />
        <p class="text-sm text-[#FAF9F6]/75 leading-relaxed max-w-sm">
          A 25-room <strong class="text-[#FAF9F6] font-medium">resort near Mukteshwar and Nainital</strong> at 1,780 m in Malla Ramgarh,
          with 180° Nanda Devi and Trishul views from every room.
        </p>

        {/* itemid = the JSON-LD #hotel @id, so Google merges this into the one resort entity instead of listing a second. */}
        <address class="not-italic space-y-2 text-sm text-[#FAF9F6]/85" itemscope itemtype="https://schema.org/Resort" itemid="https://whisperingpinesresort.in/#hotel">
          <meta itemprop="url" content="https://whisperingpinesresort.in/" />
          <meta itemprop="image" content="https://whisperingpinesresort.in/og-image.webp" />
          <meta itemprop="currenciesAccepted" content="INR" />
          <p itemprop="name" class="font-semibold text-[#FAF9F6]">Whispering Pines Resort by Casa De Bello Mukteshwar Road</p>

          <a href={RESORT_CONTACT.gmapsCid} target="_blank" rel="noopener noreferrer"
            class="flex items-start gap-2 min-h-11 py-1 hover:text-[#C4A77D] transition-colors"
            itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
            <MapPin className="w-4 h-4 text-[#C4A77D] shrink-0 mt-0.5" />
            <span class="leading-relaxed">
              <span itemprop="streetAddress">Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Rd</span>,{' '}
              <span itemprop="addressLocality">Mukteshwar</span>,{' '}
              <span itemprop="addressRegion">Nainital, Uttarakhand</span>{' '}
              <span itemprop="postalCode">263137</span>
              <meta itemprop="addressCountry" content="IN" />
            </span>
          </a>

          <div class="flex flex-wrap gap-x-6">
            <a href={`tel:${RESORT_CONTACT.phoneTel || '+917505029696'}`}
              data-track-dl='{"event":"phone_call_click","event_category":"engagement","event_label":"footer_phone_call"}'
              class="inline-flex items-center gap-2 min-h-11 hover:text-[#C4A77D] transition-colors">
              <Phone className="w-4 h-4 text-[#C4A77D] shrink-0" />
              <span class="font-semibold tracking-wide" itemprop="telephone">+91 75050 29696</span>
            </a>
            <a href="tel:+919690194954"
              data-track-dl='{"event":"phone_call_click","event_category":"engagement","event_label":"footer_reservations_phone_call"}'
              class="inline-flex items-center gap-2 min-h-11 hover:text-[#C4A77D] transition-colors">
              <Phone className="w-4 h-4 text-[#C4A77D] shrink-0" />
              <span class="font-semibold tracking-wide">09690194954</span>
            </a>
            <a href={`mailto:${RESORT_CONTACT.email}`}
              class="inline-flex items-center gap-2 min-h-11 hover:text-[#C4A77D] transition-colors">
              <Mail className="w-4 h-4 text-[#C4A77D] shrink-0" />
              <span itemprop="email">{RESORT_CONTACT.email}</span>
            </a>
          </div>
        </address>

        <div class="flex flex-wrap items-center gap-3">
          <a href="https://wa.me/917505029696" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 min-h-11 px-5 bg-[#B0966D] hover:bg-[#FAF9F6] text-[#0E2C21] text-xs font-bold uppercase tracking-wider rounded-sm transition-colors">
            WhatsApp us
          </a>
          <a href={RESORT_CONTACT.gmapsCid} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 min-h-11 px-4 border border-[#FAF9F6]/25 hover:border-[#C4A77D] hover:text-[#C4A77D] text-xs font-semibold uppercase tracking-wider rounded-sm transition-colors">
            Get directions <ArrowUpRight className="w-3.5 h-3.5" />
          </a>
          <a href={RESORT_CONTACT.gmapsCid} target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-1 min-h-11 text-sm hover:text-[#C4A77D] transition-colors"
            title="Google rating from 433 reviews">
            <span class="text-[#C4A77D] font-bold">★ 4.6</span>
            <span class="text-[#FAF9F6]/70">· 433 Google reviews</span>
          </a>
        </div>
      </div>

      {/* Link groups: collapsed on phones, open columns on desktop */}
      <div class="grid md:grid-cols-3 md:gap-8">
        {groups.map((g) => (
          <details class="wp-fgroup border-b border-[#FAF9F6]/10 last:border-b-0 md:border-0 group">
            <summary class="flex items-center justify-between min-h-12 cursor-pointer list-none text-xs uppercase tracking-[0.14em] text-[#C4A77D] font-semibold md:min-h-0 md:mb-3 md:cursor-default md:pointer-events-none">
              {g.title}
              <span class="md:hidden text-lg leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <nav aria-label={g.title} class="pb-3 md:pb-0">
              <ul class="space-y-0.5 text-sm text-[#FAF9F6]/80">
                {g.links.map(([href, label]) => (
                  <li><a href={href} data-astro-prefetch="hover" class="flex items-center min-h-10 md:min-h-8 hover:text-[#C4A77D] transition-colors">{label}</a></li>
                ))}
              </ul>
            </nav>
          </details>
        ))}
      </div>
    </div>

    {/* Getting here: one line instead of seven links to the same page */}
    <div class="py-6 border-b border-[#FAF9F6]/10 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-sm text-[#FAF9F6]/75">
      <p>
        <span class="text-[#C4A77D] font-semibold">Getting here:</span>{' '}
        Delhi 340 km · 6.5 h &nbsp;·&nbsp; Kathgodam station 43 km · 1.5 h &nbsp;·&nbsp; Pantnagar airport 76 km · 2.5 h
      </p>
      <a href="/contact-whispering-pines-resort-mukteshwar/#distance-matrix"
        class="inline-flex items-center gap-1 min-h-11 font-semibold text-[#C4A77D] hover:text-[#FAF9F6] transition-colors shrink-0">
        All routes from Delhi NCR, Lucknow &amp; Chandigarh <ArrowUpRight className="w-3.5 h-3.5" />
      </a>
    </div>

    {/* Our hotels: sister properties on identical cream cards */}
    <div class="py-8 border-b border-[#FAF9F6]/10">
      <p class="text-xs uppercase tracking-[0.14em] text-[#C4A77D] font-semibold mb-4">Our hotels</p>
      <ul class="grid grid-cols-3 gap-3 md:gap-5 max-w-2xl">
        {ourHotels.map((h) => (
          <li>
            <a href={h.url} target="_blank" rel="noopener" class="group block text-center" title={`${h.name}, ${h.place}`}>
              <span class="flex items-center justify-center h-20 md:h-24 p-3 bg-[#FAF9F6] rounded-sm transition-opacity group-hover:opacity-90">
                <img src={h.logo} alt={`${h.name} logo`} width={h.w} height={h.h} loading="lazy" decoding="async" class="max-h-full w-auto object-contain" />
              </span>
              <span class="block mt-2 text-xs text-[#FAF9F6]/85 group-hover:text-[#C4A77D]">{h.name}</span>
              <span class="block text-[11px] text-[#FAF9F6]/55">{h.place}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {/* Bottom bar */}
    <div class="pt-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs text-[#FAF9F6]/60">
      <div class="space-y-2">
        <p>© {currentYear} <a href="https://casadebello.com/" target="_blank" rel="noopener noreferrer" class="hover:text-[#C4A77D]">CASADEBELLO PRIVATE LIMITED</a> (Whispering Pines Resort by Casa De Bello) · GSTIN: 05AALCC4284C1ZT. All rights reserved.</p>
        <p class="flex flex-wrap items-center gap-x-3">
          <a href="/privacy-policy/" class="inline-flex min-h-11 items-center hover:text-[#C4A77D]">Privacy</a>
          <a href="/terms/" class="inline-flex min-h-11 items-center hover:text-[#C4A77D]">Terms</a>
          <a href="/sitemap/" class="inline-flex min-h-11 items-center hover:text-[#C4A77D]">Sitemap</a>
          <span>Website by <a href="https://growguest.in/" target="_blank" rel="noopener" class="text-[#C4A77D] hover:underline">Growguest</a></span>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {socials.map(({ icon, url }) => (
          <a href={url} target="_blank" rel="noopener noreferrer" aria-label={icon.title} title={`Whispering Pines on ${icon.title}`}
            class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-[#FAF9F6] transition-opacity hover:opacity-85">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill={`#${icon.hex}`}><path d={icon.path} /></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  // Desktop: link groups are plain open columns. Phones: they stay collapsed (still in the HTML for crawlers).
  (function () {
    var mq = matchMedia('(min-width: 768px)');
    function sync() { document.querySelectorAll('.wp-fgroup').forEach(function (d) { d.open = mq.matches; }); }
    sync(); mq.addEventListener('change', sync);
  })();
</script>

<style>
  .wp-fgroup > summary::-webkit-details-marker { display: none; }
</style>
