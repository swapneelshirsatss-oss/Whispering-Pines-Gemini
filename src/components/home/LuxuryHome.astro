---
// Homepage redesign (Nov 2026), editorial style modelled on araiyahotels.com but built static and light:
// no React, no carousel library, CSS scroll-snap slider, Astro-optimised images.
// Data comes from src/data.ts so rooms, reviews and contact stay in one place.
import { Image, getImage } from 'astro:assets';
import { ROOMS_INVENTORY, TESTIMONIALS, BOOKING_ENGINE_URL, RESORT_CONTACT } from '../../data';
import hero1 from '../../assets/images/Whispering-pines-balcony-view-nanital.avif';
import hero2 from '../../assets/images/lounge-area-inwhispering-pines-resort-by-casa-de-bello.avif';
import hero3 from '../../assets/images/outside-view-from-resort-hotel.avif';
import heroBalcony from '../../assets/images/whispering-pines-balcony-valley-view.jpg';
import villaImg from '../../assets/images/villa_in_nanital.avif';
import skylightImg from '../../assets/images/Delux_room_Whispering_pines_mukteshwar.avif';
import familyImg from '../../assets/images/Family_Twin_Room_Near_nainital.avif';
import cedarImg from '../../assets/images/Group_booking_nainital_resort.avif';
import diningImg from '../../assets/images/Restaurant-cafe-ramgarh.avif';
import band1 from '../../assets/images/Private-Dining-Area-resort-near-mukteshwar.avif';
import band2 from '../../assets/images/Premiuam-villa-room.avif';

// Phones get their own photo per slide: landscape terrace shots crop to empty floor tiles on a tall screen,
// so the valley/mountain view (the headline's promise) leads on mobile. Alt text is true for both photos.
// Slide 1 must prove "views from every room": a room balcony over the valley (brand kit: the photo proves the headline).
// The sunset terrace moves to slide 3, cropped left so the red chimney is not the centre of the frame.
const heroSlides = [
  { img: heroBalcony, mobile: hero3, pos: '72% center', alt: 'Pine-covered valley seen from Whispering Pines, Malla Ramgarh, near Mukteshwar' },
  { img: hero2, mobile: hero2, pos: '70% center', alt: 'Covered lounge on the resort terrace with Himalayan ridges at dusk' },
  { img: hero1, mobile: heroBalcony, pos: '20% center', alt: 'Whispering Pines terrace and balconies above the hills at sunset, Malla Ramgarh' },
];
const mobileSrc = await Promise.all(heroSlides.map((s) =>
  getImage({ src: s.mobile, widths: [480, 750, 1080], format: 'webp', quality: 70 })));

const roomImg: Record<string, ImageMetadata> = {
  'entire-cottage': villaImg, 'delux-room': skylightImg, 'orchard-room': familyImg, 'cedar-room': cedarImg,
};
// Room names in data.ts carry SEO tails ("Private Villa — The Ultimate..."); cards show the short name.
const rooms = ROOMS_INVENTORY.map((r) => ({ ...r, short: r.name.split(' — ')[0], img: roomImg[r.id] }));

const perks = [
  { title: '25% less than OTAs', text: 'No MakeMyTrip or Booking.com commission added to your rate.' },
  { title: 'Best view, first', text: 'Priority allocation of 180° Nanda Devi and Trishul balcony rooms.' },
  { title: 'Pets stay free', text: 'Enclosed orchard lawns and no pet charge.' },
  { title: 'Talk to the host', text: 'Arrival times and day trips arranged directly with Director Gaurav Pandey.' },
];

const experiences = [
  { title: 'Kumaoni dining', sub: 'Multi-cuisine kitchen and bonfire BBQ evenings', img: diningImg, href: '/resort-services-ramgarh/' },
  // yoga: only "guided group yoga sessions" is confirmed (data.ts LOCAL_EXPERIENCES); no spa/massage claims
  { title: 'Yoga & wellness', sub: 'Guided group yoga sessions in the mountain air', src: '/images/yoga-in-resort-mukteshwar.avif', href: '/things-to-do-near-mukteshwar/' },
  { title: 'Pine trails', sub: 'Deodar and oak forest walks from the gate', src: '/images/Local-Sight-Himalayan-Excursions/pine-forest-nature-trails.webp', href: '/things-to-do-near-mukteshwar/' },
  { title: 'Orchards', sub: 'Apple, peach and plum, 0.5 km walk', src: '/images/Local-Sight-Himalayan-Excursions/malla-ramgarh-fruit-orchards.webp', href: '/things-to-do-near-mukteshwar/' },
  { title: 'Kainchi Dham', sub: 'Neem Karoli Baba Ashram, about 45 minutes', src: '/images/Local-Sight-Himalayan-Excursions/kainchi-dham-mukteshwar.webp', href: '/blog/resort-stay-near-kainchi-dham/' },
];

const pick = ['Anurag Arya', 'Ashok Gupta', 'Khushi Joshi'];
const reviews = pick.map((n) => TESTIMONIALS.find((t) => t.name === n)).filter((t) => t !== undefined);
const rating = RESORT_CONTACT.rating;
---

<script is:inline>
  // Motion entrance animations: hide animated elements only when JS runs and the visitor allows motion.
  // Safety net: if the motion bundle hasn't loaded in 3s, show everything without animation.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('lx-motion');
    window.__lxMotionFallback = setTimeout(function () { document.documentElement.classList.remove('lx-motion'); }, 3000);
  }
</script>

<section class="lx-hero" data-lx-hero aria-roledescription="carousel" aria-label="Resort photos">
  <div class="lx-track">
    {heroSlides.map((s, i) => (
      <picture>
        <source media="(max-width: 559px)" srcset={mobileSrc[i].srcSet.attribute} sizes="100vw" type="image/webp" />
        <Image src={s.img} alt={s.alt} widths={[640, 1024, 1600, 2200]} sizes="100vw" quality={72} format="webp"
          style={`object-position: ${s.pos}`}
          loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />
      </picture>
    ))}
  </div>
  <div class="lx-hero-copy">
    <p id="speakable-hero-intro" class="lx-hero-loc">Family resort in Uttarakhand · Malla Ramgarh · 1,780 m</p>
    <h1>Resort in Mukteshwar <span>with 180° Himalayan Views from Every Room</span></h1>
    <!-- generate_lead keeps homepage WhatsApp leads counting as Google Ads conversions, as the old room-list and booking-form buttons did (handled by /js/click-tracking.js) -->
    <a class="lx-btn lx-solid" href={BOOKING_ENGINE_URL} target="_blank" rel="noopener noreferrer"
      data-track-fn="trackAdsConversion" data-track-args='["generate_lead","booking","home_hero_whatsapp",{"conversion_type":"whatsapp"}]'>Check availability</a>
    <p class="lx-hero-proof"><span aria-hidden="true">★</span> {rating.value} on Google · {rating.reviewCount} reviews · Save 25% booking direct</p>
  </div>
</section>

<section class="lx-section lx-center">
  <div class="lx-wrap lx-narrow lx-reveal">
    <h2>Twenty-five rooms, one private villa, and Nanda Devi from every window.</h2>
    <p id="speakable-about-summary" class="lx-lead">
      Whispering Pines is an alpine resort at 1,780 m in Malla Ramgarh, Uttarakhand, a 25 km (45 minute) drive from Mukteshwar Dham.
      Every room faces 180° Nanda Devi and Trishul snow peaks, with fruit orchards and a 2,200 sq ft lawn, plus a 3-BHK
      villa for up to 10. Booking direct on WhatsApp saves 25%.
    </p>
    <a class="lx-link" href="/about-whispering-pines-resort-ramgarh/">Our story, formerly Clarks Exotica →</a>
  </div>
</section>

<section class="lx-quote">
  <img src="/images/Local-Sight-Himalayan-Excursions/nanda-devi-peak-view-mukteshwar.webp" alt="" width="1200" height="800" loading="lazy" decoding="async" />
  <blockquote class="lx-wrap lx-narrow lx-center lx-reveal">
    <p>“The view from the room was breathtaking.”</p>
    <cite>Priyanka Gupta, Google review</cite>
  </blockquote>
</section>

<section class="lx-section" id="rooms">
  <div class="lx-wrap">
    <header class="lx-head lx-reveal">
      <h2>Rooms, suites and a private villa</h2>
      <p>Every room has the 180° view. Pick by how many of you are coming.</p>
    </header>
    <div class="lx-grid4 lx-swipe">
      {rooms.map((r) => (
        <a class="lx-room lx-reveal" href="/suites-cottages-ramgarh-resort/">
          <Image src={r.img} alt={`${r.short} at Whispering Pines Resort, Mukteshwar`} widths={[480, 800]} sizes="(max-width: 559px) 82vw, (max-width: 1000px) 50vw, 300px" quality={72} format="webp" />
          <h3>{r.short}</h3>
          <p class="lx-meta">{r.sizeSqFt.toLocaleString('en-IN')} sq ft · up to {r.maxOccupancy} guests</p>
          <p class="lx-more">View room →</p>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="lx-perks">
  <div class="lx-wrap">
    <span class="lx-label lx-ink">Why book direct</span>
    <div class="lx-grid4 lx-perk-grid">
      {perks.map((p) => <div class="lx-reveal"><h3>{p.title}</h3><p>{p.text}</p></div>)}
    </div>
    <p class="lx-center"><a class="lx-btn lx-pine" href="/book-now/">Book direct</a></p>
  </div>
</section>

<section class="lx-section lx-dark wp-pine-surface" id="experiences">
  <div class="lx-wrap">
    <header class="lx-head lx-reveal"><h2>Slow days near Mukteshwar</h2></header>
    <div class="lx-grid4 lx-grid5 lx-swipe">
      {experiences.map((e) => (
        <a class="lx-exp lx-reveal" href={e.href}>
          {e.img
            ? <Image src={e.img} alt={e.sub} widths={[400, 700]} sizes="(max-width: 559px) 82vw, (max-width: 1000px) 50vw, 300px" quality={70} format="webp" />
            : <img src={e.src} alt={e.sub} width="700" height="933" loading="lazy" decoding="async" />}
          <span class="lx-cap"><strong>{e.title}</strong>{e.sub}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="lx-section">
  <div class="lx-wrap">
    <header class="lx-head lx-reveal">
      <span class="lx-label lx-ink">Guest words</span>
      <h2>{rating.value} on Google from {rating.reviewCount} reviews</h2>
    </header>
    <div class="lx-reviews lx-swipe">
      {reviews.map((r) => (
        <blockquote class="lx-review lx-reveal"><p>“{r.comment}”</p><cite>{r.name} · {r.source}, {r.date}</cite></blockquote>
      ))}
    </div>
    <p class="lx-center"><a class="lx-link" href="/reviews/">Read more reviews →</a></p>
  </div>
</section>

<div class="lx-bands lx-swipe">
  <Image src={band1} alt="Wooden booth seating in the Whispering Pines restaurant" widths={[640, 1280]} sizes="(max-width: 559px) 82vw, 50vw" quality={70} format="webp" />
  <Image src={band2} alt="Villa bedroom opening onto a balcony among the pines" widths={[640, 1280]} sizes="(max-width: 559px) 82vw, 50vw" quality={70} format="webp" />
</div>

<script>
  // motion/mini = Motion's small WAAPI animate (~2-3 KB) instead of the full engine (~70 KB raw)
  import { animate } from 'motion/mini';
  import { inView } from 'motion';

  clearTimeout((window as any).__lxMotionFallback);
  if (document.documentElement.classList.contains('lx-motion')) {
    const ease = [0.22, 1, 0.36, 1] as const; // soft "expo-out", calm rather than bouncy
    document.querySelectorAll('.lx-hero-copy > *').forEach((el, i) =>
      animate(el, { opacity: [0, 1], transform: ['translateY(24px)', 'none'] }, { duration: 0.9, ease, delay: 0.15 + i * 0.12 }));

    inView('.lx-reveal', (el) => {
      // cards in the same row enter one after another
      const row = [...(el.parentElement?.children ?? [])].filter((c) => c.classList.contains('lx-reveal'));
      const i = Math.min(Math.max(row.indexOf(el), 0), 4);
      animate(el, { opacity: [0, 1], transform: ['translateY(28px)', 'none'] }, { duration: 0.8, ease, delay: i * 0.08 });
    }, { margin: '0px 0px -8% 0px' });
  }
</script>

<script>
  // Auto-advance the hero; swipe/scroll-snap does the rest. Stops on first touch and for reduced motion.
  const t = document.querySelector<HTMLElement>('[data-lx-hero] .lx-track');
  if (t && t.children.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    const timer = setInterval(() => { i = (i + 1) % t.children.length; t.scrollTo({ left: i * t.clientWidth, behavior: 'smooth' }); }, 6000);
    t.addEventListener('pointerdown', () => clearInterval(timer), { once: true });
  }
</script>

<style>
  .lx-wrap { width: min(1200px, 100% - 32px); margin-inline: auto; }
  .lx-narrow { max-width: 760px; }
  .lx-center { text-align: center; }
  .lx-section { padding-block: clamp(64px, 9vw, 128px); }
  .lx-dark { color: var(--color-cream); } /* surface: .wp-pine-surface in global.css */
  h2 { font-family: var(--font-display); font-weight: 500; font-size: clamp(30px, 4vw, 50px); line-height: 1.15; color: inherit; margin: 0 0 .5em; }
  .lx-section:not(.lx-dark) h2 { color: var(--color-pine); }
  h3 { font-family: var(--font-display); font-weight: 500; font-size: 24px; line-height: 1.25; margin: 0 0 .3em; }
  .lx-lead { font-size: 18px; line-height: 1.75; color: var(--color-ink); margin-bottom: 28px; }
  .lx-label { display: block; font: 600 12px/1.4 var(--font-sans); letter-spacing: .2em; text-transform: uppercase; color: var(--color-brass); margin-bottom: 14px; text-align: center; }
  .lx-label.lx-ink { color: var(--color-brass-ink); }
  .lx-link { font-weight: 600; color: var(--color-brass-ink); text-decoration: underline; text-underline-offset: 4px; }
  .lx-link:hover { color: var(--color-pine); }
  .lx-btn { display: inline-block; padding: 16px 34px; font: 700 12px/1 var(--font-sans); letter-spacing: .12em; text-transform: uppercase; border-radius: 2px; transition: background-color .3s, color .3s; }
  .lx-solid { background: var(--color-brass); color: var(--color-pine); }
  .lx-solid:hover { background: var(--color-cream); }
  .lx-head { text-align: center; margin-bottom: 52px; }
  .lx-head p { color: var(--color-ink); margin: 0; }

  /* hero */
  /* full-bleed: the homepage header floats transparent over the hero */
  .lx-hero { position: relative; height: 100svh; min-height: 560px; background: var(--color-pine); color: var(--color-cream); }
  .lx-track { display: flex; height: 100%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .lx-track::-webkit-scrollbar { display: none; }
  .lx-track > picture { flex: 0 0 100%; display: block; width: 100%; height: 100%; scroll-snap-align: start; }
  .lx-track :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 70% center; }
  .lx-hero::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(10 33 24 / .65), transparent 22%),  /* keeps the transparent header legible */
      linear-gradient(to top, rgb(14 44 33 / .9), rgb(14 44 33 / .45) 35%, transparent 65%); }
  .lx-hero-copy { position: absolute; inset: auto 0 9vh; z-index: 1; text-align: center; padding-inline: 16px; }
  /* clear the sitewide mobile Call/WhatsApp bar */
  @media (max-width: 767px) { .lx-hero { height: calc(100svh - 59px); min-height: 520px; } .lx-hero-copy { bottom: 8vh; } }
  .lx-hero h1 { font-family: var(--font-display); font-weight: 500; font-size: clamp(34px, 5.2vw, 68px); line-height: 1.1; margin: 0 auto 14px; max-width: 18ch; text-shadow: 0 2px 14px rgb(0 0 0 / .45); }
  .lx-hero h1 span { display: block; font-size: .7em; margin-top: .25em; }
  /* cream, not brass: brass-light over bright sky failed contrast (brand kit: gold only on pine) */
  .lx-hero-loc { font: 600 12px/1.5 var(--font-sans); letter-spacing: .16em; text-transform: uppercase; color: var(--color-cream); opacity: .92; text-shadow: 0 1px 10px rgb(0 0 0 / .55); margin: 0 0 14px; }
  .lx-hero-proof { font-size: 14px; margin: 16px 0 0; opacity: .92; }
  .lx-hero-proof span { color: var(--color-brass-light); }
  .lx-hero h1 { margin-bottom: 26px !important; }

  /* quote band */
  .lx-quote { position: relative; overflow: hidden; background: var(--color-pine); color: var(--color-cream); padding-block: clamp(110px, 16vw, 220px); }
  .lx-quote img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .5; }
  .lx-quote blockquote { position: relative; margin: 0 auto; }
  .lx-quote p { font: italic 400 clamp(28px, 3.6vw, 46px)/1.25 var(--font-display); margin: 0 0 18px; }
  .lx-quote cite { font: 600 12px/1 var(--font-sans); letter-spacing: .2em; text-transform: uppercase; font-style: normal; color: var(--color-brass-light); }

  /* 4-item rows: 1 / 2 / 4 columns, never 3 + 1 */
  .lx-grid4 { display: grid; gap: 28px; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .lx-grid4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .lx-grid4 { grid-template-columns: repeat(4, 1fr); } }

  .lx-room { display: block; color: var(--color-ink); }
  .lx-room :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; margin-bottom: 18px; }
  .lx-room h3 { color: var(--color-pine); transition: color .3s; }
  .lx-room:hover h3 { color: var(--color-brass-ink); }
  .lx-meta { font-size: 14px; color: var(--color-ink); opacity: .8; margin: 0; }
  .lx-more { font-size: 14px; font-weight: 600; color: var(--color-brass-ink); margin: 6px 0 0; }

  /* Sand band: breaks the long dark run between the rooms and experiences sections, and gives
     the page a third tone instead of only cream and pine. Contrast on sand: text 9.6:1, headings 4.5:1. */
  .lx-perks { background: var(--color-sand); color: var(--color-ink); padding-block: 72px; }
  .lx-perks .lx-grid4 { margin: 24px 0 44px; }
  .lx-perks h3 { color: var(--color-brass-ink); font-size: 22px; }
  .lx-perks p { font-size: 15px; margin: 0; }
  .lx-btn.lx-pine { background: var(--color-pine); color: var(--color-cream); border: 1px solid var(--color-pine); }
  .lx-btn.lx-pine:hover { background: var(--color-brass-ink); border-color: var(--color-brass-ink); }

  .lx-exp { position: relative; display: block; overflow: hidden; color: var(--color-cream); }
  .lx-exp :global(img), .lx-exp img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
  .lx-cap { position: absolute; inset: auto 0 0; padding: 22px; background: linear-gradient(transparent, rgb(10 33 24 / .85)); font-size: 14px; }
  .lx-cap strong { display: block; font: 500 22px/1.3 var(--font-display); }
  .lx-exp:hover strong { color: var(--color-brass-light); }

  .lx-reviews { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-bottom: 36px; }
  /* hairline above each quote instead of a white box (brand kit: no card soup) */
  .lx-review { margin: 0; padding: 26px 0 0; border-top: 1px solid rgb(14 44 33 / .18); background: none; }
  .lx-review p { font: italic 400 19px/1.55 var(--font-display); color: var(--color-ink); }
  .lx-review cite { font-style: normal; font-size: 13px; color: var(--color-ink); opacity: .75; }

  .lx-bands { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .lx-bands :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }

  /* ---------- phones (70% of visitors) ---------- */
  @media (max-width: 559px) {
    .lx-section { padding-block: 56px; }
    h2 { font-size: 28px; }
    .lx-head { margin-bottom: 28px; }
    .lx-lead { font-size: 17px; }
    .lx-label { font-size: 13px; }
    /* shorter hero so the next section peeks and invites a scroll; sits above the sticky Call/WhatsApp bar */
    /* first-screen hierarchy for phones: location hook -> headline -> one CTA -> proof, in the top half */
    /* ~74% of the screen: enough photo to prove the view (~220px under the text), and the next
       section's heading peeks above the sticky bar so the page doesn't look finished (no "false floor") */
    .lx-hero { height: min(74svh, 620px); min-height: 500px; }
    .lx-hero-copy { top: calc(101px + 4svh); bottom: auto; } /* header = 60px logo + 2 × 20px padding */
    .lx-hero h1 { font-size: 34px; max-width: none; margin-bottom: 22px !important; }
    .lx-hero h1 span { font-size: .56em; margin-top: .4em; }
    .lx-hero-loc { font-size: 11px; letter-spacing: .12em; }
    .lx-hero-proof { font-size: 13px; }
    .lx-hero::after { background:
      linear-gradient(to bottom, rgb(10 33 24 / .72) 0%, rgb(10 33 24 / .42) 46%, transparent 64%, rgb(10 33 24 / .25) 100%); }
    .lx-track :global(img) { object-position: 50% center; }
    .lx-btn { width: 100%; max-width: 340px; padding-block: 18px; }
    .lx-quote { padding-block: 88px; }
    .lx-quote p { font-size: 26px; }

    /* long card lists become one swipeable row with the next card peeking in */
    .lx-swipe { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
      margin-inline: -16px; padding: 0 16px 8px; scroll-padding-inline: 16px; scrollbar-width: none; }
    .lx-swipe::-webkit-scrollbar { display: none; }
    .lx-swipe > * { flex: 0 0 82%; scroll-snap-align: start; }
    .lx-bands.lx-swipe { margin-inline: 0; padding-bottom: 0; }
    .lx-reviews.lx-swipe { margin-bottom: 20px; }
    .lx-review { padding: 22px 0 0; }
    .lx-review p { font-size: 17px; }

    /* perks: compact 2 x 2 instead of four stacked blocks */
    .lx-perks { padding-block: 48px; }
    .lx-perk-grid { grid-template-columns: 1fr 1fr; gap: 22px 16px; margin: 16px 0 28px; }
    .lx-perks h3 { font-size: 18px; }
    .lx-perks p { font-size: 14px; }
  }
  /* comfortable thumb targets for text links */
  .lx-link { display: inline-block; padding-block: 12px; }

  /* Motion (motion.dev) entrance animations: start hidden only while html.lx-motion is set (see inline script) */
  :global(html.lx-motion) .lx-reveal,
  :global(html.lx-motion) .lx-hero-copy > * { opacity: 0; }

  /* experiences has 5 cards: 5 across on desktop, swipe row below that (never 2 + 2 + 1) */
  @media (min-width: 560px) and (max-width: 999px) {
    .lx-grid5 { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .lx-grid5::-webkit-scrollbar { display: none; }
    .lx-grid5 > * { flex: 0 0 42%; scroll-snap-align: start; }
  }
  @media (min-width: 1000px) { .lx-grid5 { grid-template-columns: repeat(5, 1fr); gap: 20px; } }
</style>
