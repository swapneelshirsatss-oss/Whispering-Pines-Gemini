---
import { Trees, Compass, UtensilsCrossed, ArrowRight } from "lucide-react";
import aboutResortImg from "../assets/images/outside-view-from-resort-hotel.avif?url";
import LazyImage from "./LazyImage";

interface Props {
  hideLink?: boolean;
  title?: string;
  asH1?: boolean;
}

const { 
  hideLink = false,
  title = "A cozy sanctuary amidst fruit orchards and whispering pines",
  asH1 = false
} = Astro.props;

const HeadingTag = asH1 ? "h1" : "h2";

const USPList = [
  {
    title: "180° views from all rooms",
    icon: Compass,
    desc: "Gaze at Nanda Devi and Trishul snow peaks directly from your bed and private balcony. Every single room commands an unobstructed 180° mountain vista.",
  },
  {
    title: "Rich variety of food",
    icon: UtensilsCrossed,
    desc: "Savor a great variety of delicious homestyle meals, authentic Kumaoni delicacies, North Indian comforts, and evening bonfire barbecues.",
  },
  {
    title: "Ramgarh fruit hub and peace",
    icon: Trees,
    desc: "Set within active orchards of peach, plum, and apple trees. Breathe crisp Himalayan pine air on a quiet ridge built for deep rest.",
  },
];
---
<section id="about" class="py-20 lg:py-28 bg-[#FAF9F6]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Intro Grid */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      {/* Narrative - Left */}
      <div class="lg:col-span-7 space-y-6">
        <HeadingTag class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#0E2C21]">
          {title}
        </HeadingTag>
        <div class="w-16 rule-brass-left my-4" />
        
        <p id="speakable-about-summary" class="text-[17px] sm:text-lg text-[#2C3531]/90 font-sans leading-relaxed">
          Tucked away on the scenic Bhowali-Ramgarh-Mukteshwar Road in Malla Ramgarh, Whispering Pines by Casa De Bello (formerly Clarks Exotica near Mukteshwar) is rated 4.6 on Google by 433 guests. Continuing the legacy of authentic Kumaoni hospitality, we host both returning guests and first-time visitors to the Nainital hills. Perched at 1,780 metres, the property sits inside working orchards of apple, peach and plum.
        </p>
        <p class="text-[17px] sm:text-lg text-[#2C3531]/90 font-sans leading-relaxed">
          Every detail of the resort has been designed for pure relaxation and visual connection with nature. Uniquely, every single room commands an unobstructed 180° Himalayan view of Nanda Devi and Trishul. Mornings feature fresh mountain breezes through pine canopies, warm tea under sunlit fruit orchards, and a great variety of freshly prepared homestyle food. Cedar-paneled rooms, evening fireplace gatherings, and starlit bonfire dinners complete your stay.
        </p>

        <div class="pt-6 grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6">
          {USPList.map((item) => {
            const Icon = item.icon;
            return (
            <div class="space-y-3 sm:space-y-2 border-l-2 sm:border-l border-[#8A6F4A]/40 pl-5 sm:pl-4 py-1">
              <div class="flex items-center space-x-3 sm:space-x-2">
                <Icon className="w-6 h-6 sm:w-5 sm:h-5 text-[#7A6038]" />
                <h4 class="font-bold text-base sm:text-sm text-[#0E2C21] font-sans">
                  {item.title}
                </h4>
              </div>
              <p class="text-sm sm:text-sm text-[#2C3531]/80 leading-relaxed font-sans">
                {item.desc}
              </p>
            </div>
            );
          })}
        </div>
      </div>

      {/* Visual Graphics - Right */}
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-sm overflow-hidden">
          {/* Main Photo */}
          <LazyImage
            width={800}
            height={600}
            src={aboutResortImg}
            alt="Whispering Pines Resort exterior in Malla Ramgarh surrounded by fruit orchards"
            className="group w-full aspect-[4/3] sm:aspect-auto sm:h-[480px] lg:h-[520px]"
            imgClassName="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            referrerPolicy="no-referrer"
          />
          {/* Highlight Overlay */}
          <div class="absolute inset-0 bg-[#0E2C21]/5 mix-blend-multiply pointer-events-none" />
        </div>

        {/* Float Badge */}
        <div class="absolute -bottom-6 -left-6 bg-[#0E2C21] text-[#FAF9F6] p-6 rounded-sm shadow-md max-w-xs border border-[#B0966D]/30 hidden sm:block">
          <span class="font-display italic text-2xl text-[#B0966D] block mb-1">
            "Pure Serenity..."
          </span>
          <p class="text-sm font-sans text-white/80 leading-relaxed">
            "The 180° Himalayan view from our bedroom, the delicious variety of food, and quiet fruit orchards made this our most relaxing mountain holiday."
          </p>
          <a
            href="https://maps.google.com/?cid=8386667112972057918"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[10px] uppercase font-sans text-[#B0966D] mt-3 block hover:text-[#FAF9F6] transition-colors"
          >
            Priya S., review on Google
          </a>
        </div>
        
      </div>
    </div>

    {!hideLink && (
      <div class="mt-16 text-center">
        <a
          href="/about-whispering-pines-resort-ramgarh/"
          class="inline-flex items-center justify-center px-8 py-3 sm:px-10 sm:py-4 bg-transparent border border-[#8A6F4A] text-[#0E2C21] hover:bg-[#B0966D] hover:text-[#0E2C21] font-sans text-[11px] sm:text-xs font-semibold uppercase tracking-[0.1em] transition-colors duration-300 rounded-sm group"
        >
          Discover More About Us
          <ArrowRight className="w-4 h-4 ml-3 transition-transform duration-300 group-hover:translate-x-1" />
        </a>
      </div>
    )}
  </div>
</section>
