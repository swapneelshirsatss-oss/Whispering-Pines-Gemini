---
// ResortLodgingSchema.astro
// Resort + LodgingBusiness JSON-LD Schema
import balconyViewImg from '../assets/images/Whispering-pines-balcony-view-nanital.avif?url';
import villaImg from '../assets/images/villa_in_nanital.avif?url';
import deluxRoomImg from '../assets/images/Delux_room_Whispering_pines_mukteshwar.avif?url';

const siteBase = 'https://whisperingpinesresort.in';
const balconyUrl = new URL(balconyViewImg, siteBase).href;
const villaUrl = new URL(villaImg, siteBase).href;
const deluxUrl = new URL(deluxRoomImg, siteBase).href;

const schemaData = {
