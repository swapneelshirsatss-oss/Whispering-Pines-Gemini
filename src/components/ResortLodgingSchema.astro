      "containsPlace": [
        {
          "@type": "Accommodation",
          "name": "Standalone 10-Guest Private Alpine Villa",
          "description": "3 king bedrooms, skylight loft, living room with wood-fired stone fireplace, and private fruit orchard yard.",
          "occupancy": { "@type": "QuantitativeValue", "maxValue": 10 },
          "bed": { "@type": "BedDetails", "numberOfBeds": 3, "typeOfBed": "King Bed" }
        },
        {
          "@type": "Accommodation",
          "name": "Deluxe Skylight Suite",
          "description": "Glass skylight ceilings for stargazing and 180° Himalayan peak balcony views.",
          "occupancy": { "@type": "QuantitativeValue", "maxValue": 3 },
          "bed": { "@type": "BedDetails", "numberOfBeds": 1, "typeOfBed": "King Bed" }
        },
        {
          "@type": "Accommodation",
          "name": "Family Twin Room — Ground Floor Orchard Access",
          "description": "Ground floor family room with direct lawn and orchard access, exposed stone brick archways and geo-heater. Safe open space for children.",
          "occupancy": { "@type": "QuantitativeValue", "maxValue": 2 },
          "bed": { "@type": "BedDetails", "numberOfBeds": 1, "typeOfBed": "Double Bed" }
        },
        {
          "@type": "Accommodation",
          "name": "Group Cottage Room — Cedar Wood Pine Finish",
          "description": "Cedar wood pine finish room with mountain valley views and high-capacity heaters. Ideal for group bookings and large families.",
          "occupancy": { "@type": "QuantitativeValue", "maxValue": 2 },
          "bed": { "@type": "BedDetails", "numberOfBeds": 1, "typeOfBed": "Double Bed" }
        }
      ],
      "review": [
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "Dr. Vikram Sethi" },
          "datePublished": "2026-05-01",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5",
            "worstRating": "1"
          },
          "reviewBody": "An absolute masterpiece of a premium villa. The panoramic Nanda Devi peaks look otherworldly from the Attic suite in the morning. The chef's Kumaoni local chicken curry and warm mandua rotis were stellar. High-speed Wi-Fi let me consult cases seamlessly. Will return."
        },
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "Priya and Rohan Sen" },
          "datePublished": "2026-04-01",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5",
            "worstRating": "1"
          },
          "reviewBody": "Words cannot describe the tranquility of Malla Ramgarh. Whispering Pines is surrounded by massive peach trees and silent pinewood hills. The kids loved the fireplace evenings and our Golden Retriever was in absolute heaven running in the safe garden lawns. Gated parking was very convenient."
        },
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "Aman Rastogi" },
          "datePublished": "2026-06-01",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5",
            "worstRating": "1"
          },
          "reviewBody": "Exceptional remote working setup. Constant 150 Mbps speed on fiber, hot showers, cozy timber wood bed, and serene fresh air. Highly recommend booking the Entire Villa if travelling with extended family — the living room wood hearth is magnificent."
        }
