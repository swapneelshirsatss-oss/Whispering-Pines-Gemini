        { "@type": "LocationFeatureSpecification", "name": "Stone Fireplace Rooms", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Outdoor Bonfire and BBQ Area", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Free Private Parking", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Banquet and Event Hall", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "24-Hour Front Desk", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Daily Housekeeping", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Travel Desk and Cab Service", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Backup Generator Power", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Pine Forest Nature Trails", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Private Villa", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Workcation Setup Remote Work Ready", "value": true }
