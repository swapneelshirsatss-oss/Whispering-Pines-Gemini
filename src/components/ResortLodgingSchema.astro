          "@type": "EntryPoint",
          "urlTemplate": "https://whisperingpinesresort.in/?s={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },

    {
      "@type": "FAQPage",
      "@id": "https://whisperingpinesresort.in/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is there dedicated, secure private parking available on site?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The property features a secure, flat gated private gravel driveway that comfortably accommodates 3 to 4 tourist SUVs and sedans right in front of the villa. No tricky cliff-edge parking required."
          }
        },
        {
          "@type": "Question",
          "name": "Do you have high-speed internet suited for remote working?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Whispering Pines has a dedicated 150 Mbps fiber-optic internet connection supporting active work sessions, video calls, and streaming seamlessly throughout the villa and front outdoor gardens."
          }
        },
        {
          "@type": "Question",
          "name": "How do meals and dining work? Can we order customized food?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whispering Pines offers customized homestyle dining on-site. The resident cook prepares fresh multi-cuisine meals and authentic local Kumaoni delicacies using locally-sourced organic vegetables. Guests can choose breakfast, lunch and dinner packages or order on-demand."
          }
        },
        {
          "@type": "Question",
          "name": "Are pets allowed inside the villa and gardens?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Whispering Pines is completely pet-friendly. The villa has large, secure, enclosed front lawns and direct access to wilderness pine forest paths where dogs can explore safely. No additional pet charges apply."
          }
        },
        {
          "@type": "Question",
          "name": "How does the WhatsApp booking process work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To book, select your room, guest count, and dates, then send a WhatsApp inquiry to +91-7505029696. The reservations team responds in minutes, verifies availability, and shares a secure UPI or Credit Card payment invoice for confirmation."
          }
        },
        {
          "@type": "Question",
          "name": "Are fireplace logs and bonfire wood provided?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Whispering Pines arranges authentic wood logs for both the indoor living room fireplace and the outdoor bonfire grill. A complimentary setup is offered on every arrival and additional wood logs can be refilled at a nominal charge."
          }
        },
        {
          "@type": "Question",
          "name": "Where is Whispering Pines Resort located and how far is it from Delhi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Whispering Pines Resort is located in Malla Ramgarh on the Bhowali-Ramgarh-Mukteshwar Road, Uttarakhand 263137. It is 25 km from Mukteshwar Dham, 45 minutes from Kainchi Dham and approximately 6 to 8 hours drive from Delhi, Gurugram and Noida via NH9 and NH309."
          }
        },
        {
          "@type": "Question",
          "name": "Is Whispering Pines Resort the same as Clarks Exotica Mukteshwar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Whispering Pines by Casa De Bello is the upgraded successor to Clarks Exotica on the Mukteshwar Road in Ramgarh. Same iconic Bhowali-Ramgarh-Mukteshwar Road location, now with enhanced stone cottage architecture, a premium private villa, swimming pool and personalised Casa De Bello management."
          }
        },
        {
          "@type": "Question",
          "name": "Does Whispering Pines Resort have a swimming pool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Whispering Pines Resort has an on-site swimming pool surrounded by pine forest, making it one of the very few resorts near Mukteshwar and Nainital to offer a pool alongside 180 degree Himalayan views of the Nanda Devi and Trishul peaks."
          }
        },
        {
          "@type": "Question",
          "name": "What are the check-in and check-out times at Whispering Pines Resort?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Check-in time at Whispering Pines Resort is 2:00 PM and check-out is at 11:00 AM. Early check-in and late check-out can be requested directly via WhatsApp at +91-7505029696 and are accommodated subject to availability."
          }
        }
      ]
    }
