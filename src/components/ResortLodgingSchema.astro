      "@type": ["Resort", "Hotel"],
      "@id": "https://whisperingpinesresort.in/#resort",
      "name": "Whispering Pines Resort by Casa De Bello",
      "alternateName": [
        "Clarks Exotica Mukteshwar",
        "Whispering Pines Ramgarh",
        "Whispering Pines by Casa De Bello",
        "Casa De Bello Whispering Pines"
