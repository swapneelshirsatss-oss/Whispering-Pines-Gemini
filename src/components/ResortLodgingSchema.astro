        {
          "@type": "ImageObject",
          "url": villaUrl,
          "name": "Premium Private Villa — Whispering Pines Resort near Nainital",
          "description": "Stone and cedar wood heritage private villa at Whispering Pines Resort, Ramgarh — sleeps up to 10 guests with private orchard yard and fireplace"
        },
        {
          "@type": "ImageObject",
          "url": deluxUrl,
