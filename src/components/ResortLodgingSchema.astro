    {
      "@type": "FAQPage",
      "@id": "https://whisperingpinesresort.in/#faq",
      // Built from the same CONTACT_FAQS the homepage FAQAccordion shows, so schema and visible text match.
      "mainEntity": CONTACT_FAQS.map((faq) => ({ "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer } }))
    }
  ]
