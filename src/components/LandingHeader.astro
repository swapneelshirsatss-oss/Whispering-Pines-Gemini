---
// Header for Google Ads landing pages (used via LandingLayout): logo + Call, nothing else.
// Plain Astro with no React island — the site Navbar ships the React bundle (~55 KB gzip)
// only to run its menu, which an ad landing page doesn't need.
// The Call link fires the same Ads phone conversion as the site header's Call button
// (phone_call_click / header_phone_call), via the CSP-safe data-track-fn hook.
import Logo from './Logo.astro';

const PHONE_TEL = '+917505029696';
const PHONE_DISPLAY = '075050 29696';
---

<header class="sticky top-0 left-0 w-full z-50 wp-pine-surface border-b border-[#FAF9F6]/10 py-3.5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2 lg:gap-3 min-w-0">
      <Logo />
    </a>

    <a
      href={`tel:${PHONE_TEL}`}
      data-track-fn="trackBookingConversion"
      data-track-args='["phone_call_click","engagement","header_phone_call",{"conversion_type":"phone","phone_number":"7505029696"}]'
      class="flex items-center justify-center gap-2 shrink-0 min-h-11 min-w-11 px-3.5 sm:px-4 rounded-[4px] bg-[#B0966D] text-[#0E2C21] font-sans font-semibold text-[13px] sm:text-[14px] tracking-wide hover:bg-[#C4A77D] transition-colors"
      aria-label={`Call Whispering Pines on ${PHONE_DISPLAY}`}
    >
      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span class="sm:hidden">Call</span>
      <span class="hidden sm:inline">Call {PHONE_DISPLAY}</span>
    </a>
  </div>
</header>
