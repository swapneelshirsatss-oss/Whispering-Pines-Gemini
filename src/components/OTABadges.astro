---
import { ShieldCheck, Sparkles, ArrowRight } from "lucide-react";
---
<section class="py-8 sm:py-10 bg-[#1B3322] border-y border-[#c9a832]/25 text-[#FAF9F6] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row justify-between items-center gap-6 lg:gap-8">
      
      {/* Left: Verified OTA Listing Trust */}
      <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
        <div class="flex items-center gap-2">
          <ShieldCheck className="w-5 h-5 text-[#c9a832]" />
          <span class="text-xs font-mono font-bold tracking-widest text-[#FAF9F6]/80 uppercase">
            Official Property Listed On
          </span>
        </div>
        <div class="flex items-center gap-6 opacity-90 hover:opacity-100 transition-opacity">
          <a 
            href="https://www.makemytrip.com/hotels/whispering_pines_resort_mukteshwar-details-bhowali.html" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center space-x-2 text-[#FAF9F6] hover:text-[#c9a832] transition-colors bg-white/10 hover:bg-white/15 px-3 py-1.5 rounded-sm border border-white/10"
            title="View Whispering Pines Resort on MakeMyTrip"
          >
            <img 
              src="https://promos.makemytrip.com/Growth/Images/1x/mmt_dt_top_icon.png" 
              alt="MakeMyTrip" 
              width="20" 
              height="20" 
              decoding="async" 
              loading="lazy" 
              class="h-5 w-auto object-contain brightness-0 invert" 
            />
            <span class="font-bold text-xs tracking-wide">MakeMyTrip</span>
          </a>
          <a 
            href="https://www.goibibo.com/hotels/whispering-pines-resort-mukteshwar-hotel-in-bhowali-5090504030524027434/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center space-x-2 text-[#FAF9F6] hover:text-[#c9a832] transition-colors bg-white/10 hover:bg-white/15 px-3 py-1.5 rounded-sm border border-white/10"
            title="View Whispering Pines Resort on Goibibo"
          >
            <div class="w-5 h-5 bg-[#2274E0] rounded-full flex items-center justify-center text-white font-bold text-[10px] tracking-tighter">
              go
            </div>
            <span class="font-bold text-xs tracking-wide">Goibibo</span>
          </a>
        </div>
      </div>

      {/* Right: Direct Booking Disparity & Guarantee Callout */}
      <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-5 text-center sm:text-right">
        <div class="flex items-center gap-2">
          <Sparkles className="w-4 h-4 text-[#c9a832] animate-pulse" />
          <span class="text-xs sm:text-sm font-sans font-medium text-[#FAF9F6]/95">
            Book Direct on Site or WhatsApp: <strong class="text-[#c9a832] font-semibold">Save 15–20%</strong> + Complimentary Bonfire
          </span>
        </div>
        <a
          href="/book-now/"
          class="inline-flex items-center gap-1.5 bg-[#c9a832] hover:bg-[#FAF9F6] text-[#1B3322] px-4 py-2 rounded-sm font-mono text-[10px] font-bold uppercase tracking-wider transition-all duration-300 shadow-md group btn-shimmer shrink-0"
        >
          <span>Why Book Direct</span>
          <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

    </div>
  </div>
</section>

