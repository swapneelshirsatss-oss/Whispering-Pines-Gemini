---
import resortLuxuryHeroImg from "../assets/images/Whispering-pines-balcony-view-nanital.avif?url";
import LazyImage from "./LazyImage";

interface Props {
  optimizedImage?: string;
  optimizedMobileImage?: string;
}

const { optimizedImage, optimizedMobileImage } = Astro.props;
const BOOKING_ENGINE_URL = "https://casadebello-book.whisperingpinesresort.in/";
const mainHeroSrc = optimizedImage || resortLuxuryHeroImg;
---

<header class="relative min-h-screen flex items-center justify-center bg-[#0E2C21] overflow-hidden">
  <div class="absolute inset-0 z-0">
    <LazyImage
      src={mainHeroSrc}
      mobileSrc={optimizedMobileImage}
      alt="Whispering Pines Resort luxury 4-star mountain hotel exterior overlooking Himalayan snow peaks in Mukteshwar"
      className="w-full h-full object-cover"
      referrerPolicy="no-referrer"
      placeholderColor="#0E2C21"
      priority
    />
    {/* Single bottom-weighted scrim: keeps type legible without burying the photograph */}
    <div class="absolute inset-0 scrim-hero" />
    <div class="absolute inset-0 vignette pointer-events-none" />
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#FAF9F6] to-transparent pointer-events-none" />
  </div>

  {/* Main Structural Content Grid */}
  <div 
    class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-24 pb-12"
  >
    {/* Master Heading */}
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-medium tracking-tight text-[#FAF9F6] mb-6 leading-tight drop-shadow-[0_2px_14px_rgba(0,0,0,0.7)] max-w-5xl mx-auto">
      The Best Resort in Ramgarh, Uttarakhand <br class="hidden sm:block" />
      <span class="block mt-3 sm:mt-4 text-3xl sm:text-4xl md:text-5xl text-[#FAF9F6]">
        with 180° Himalayan Views from ALL Rooms
      </span>
    </h1>
    
    {/* Sub-copy block */}
    <p id="speakable-hero-intro" class="max-w-2xl mx-auto text-lg sm:text-xl text-[#FAF9F6]/95 font-sans font-light leading-relaxed mb-10 drop-shadow-[0_1px_6px_rgba(0,0,0,0.6)]">
      Whispering Pines by Casa De Bello stands at 1,780 metres in Malla Ramgarh, near Mukteshwar. Every room looks out across an unobstructed 180° at the Nanda Devi and Trishul snow peaks. Kumaoni and multi-cuisine kitchens, working fruit orchards, and fireplaces through the winter.
    </p>

    {/* Primary Actions Grid */}
    <div class="flex flex-col items-center gap-4 max-w-xl mx-auto">
      <a
        href={BOOKING_ENGINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto bg-[#B0966D] hover:bg-[#FAF9F6] text-[#0E2C21] px-10 py-4 font-sans text-[11px] font-bold uppercase tracking-[0.1em] transition-colors duration-300 flex items-center justify-center border border-[#8A6F4A] hover:border-[#FAF9F6] rounded-sm shadow-md"
      >
        <span>Check Availability</span>
        <svg class="w-4 h-4 ml-2 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/></svg>
      </a>
      <a
        href="/book-now/"
        class="text-[13px] font-sans text-[#FAF9F6]/80 hover:text-[#FAF9F6] underline underline-offset-4 decoration-[#7A6038]/50 hover:decoration-[#7A6038] transition-colors"
      >
        Booking direct is 25% below the travel portals
      </a>
    </div>

    {/* Trust & Social Proof Pill */}
    <div class="mt-8 flex flex-col items-center justify-center">
      <a 
        href="https://maps.google.com/?cid=8386667112972057918"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#0E2C21]/85 backdrop-blur-md border border-[#B0966D]/50 hover:border-[#B0966D] px-5 py-2.5 rounded-full shadow-md hover:bg-[#0E2C21] transition-all group"
        title="View Whispering Pines Resort verified Google reviews"
      >
        <svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
        </svg>
        <div class="flex items-center gap-2 text-xs sm:text-sm font-sans">
          <strong class="text-[#B0966D] font-bold text-sm sm:text-base tracking-wide">4.6★</strong>
          <span class="text-white/95 font-medium tracking-wide">Google Reviews</span>
          <span class="text-[#FAF9F6]/60 hidden sm:inline">•</span>
          <span class="text-[#B0966D] text-xs font-sans font-semibold hidden sm:inline">Casa De Bello Verified</span>
        </div>
      </a>
    </div>
  </div>
</header>
