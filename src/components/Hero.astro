---
import resortLuxuryHeroImg from "../assets/images/Whispering-pines-balcony-view-nanital.avif?url";
import LazyImage from "./LazyImage";

interface Props {
  optimizedImage?: string;
  optimizedMobileImage?: string;
}

const { optimizedImage, optimizedMobileImage } = Astro.props;
const BOOKING_ENGINE_URL = "https://wa.me/917505029696?text=Hi%20Whispering%20Pines%20Resort%21%20I%20would%20like%20to%20check%20availability%20and%20direct%20booking%20rates.";
const mainHeroSrc = optimizedImage || resortLuxuryHeroImg;
---

<header class="relative min-h-screen flex items-center justify-center bg-[#0E2C21] overflow-hidden">
  <div class="absolute inset-0 z-0">
    <LazyImage
      src={mainHeroSrc}
      mobileSrc={optimizedMobileImage}
      alt="Whispering Pines Resort luxury 4-star mountain hotel exterior overlooking Himalayan snow peaks in Mukteshwar"
      className="w-full h-full"
      imgClassName="w-full h-full object-cover object-[70%_center]"
      width={1400}
      height={800}
      referrerPolicy="no-referrer"
      placeholderColor="#0E2C21"
      priority
    />
    {/* Single bottom-weighted scrim and soft dark gradient at the bottom third so white text stays readable */}
    <div class="absolute inset-0 scrim-hero pointer-events-none" />
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#0E2C21]/90 via-[#0E2C21]/55 to-transparent pointer-events-none" />
  </div>

  {/* Main Structural Content Grid */}
  <div 
    class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-24 pb-12"
  >
    {/* Master Heading */}
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-medium tracking-tight text-[#FAF9F6] mb-4 leading-tight drop-shadow-[0_2px_14px_rgba(0,0,0,0.7)] max-w-5xl mx-auto">
      Resort in Mukteshwar <br class="hidden sm:block" />
      <span class="block mt-3 sm:mt-4 text-3xl sm:text-4xl md:text-5xl text-[#FAF9F6]">
        with 180° Himalayan Views from Every Room
      </span>
    </h1>

    {/* Single Supporting Line Under H1 */}
    <p id="speakable-hero-intro" class="max-w-2xl mx-auto text-base sm:text-lg text-[#FAF9F6]/95 font-sans font-normal leading-relaxed mb-8 drop-shadow-[0_1px_6px_rgba(0,0,0,0.6)]">
      Malla Ramgarh, Bhowali-Ramgarh-Mukteshwar Road · 1,780 m
    </p>

    {/* Single Gold CTA Button */}
    <div class="flex flex-col items-center justify-center max-w-xl mx-auto">
      <a
        href={BOOKING_ENGINE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto bg-[#B0966D] hover:bg-[#FAF9F6] text-[#0E2C21] px-10 py-4 font-sans text-xs font-bold uppercase tracking-[0.1em] transition-colors duration-300 inline-flex items-center justify-center rounded-sm shadow-sm"
      >
        <span>Check availability</span>
        <svg class="w-4 h-4 ml-2 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/></svg>
      </a>
    </div>
  </div>
</header>
