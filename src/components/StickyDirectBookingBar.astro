---
// StickyDirectBookingBar.astro
// Sleek, high-converting sticky bottom direct booking bar with automated GA4 & GTM conversion tracking.
---

<div
  id="sticky-direct-booking-bar"
  class="fixed bottom-0 inset-x-0 w-full z-[9999] bg-[#1B3322] text-[#FAF9F6] border-t-2 border-[#c9a832] shadow-[0_-4px_24px_rgba(0,0,0,0.45)] px-3 sm:px-6 py-2.5 transition-transform duration-300 transform translate-y-0"
  role="region"
  aria-label="Direct Booking Privileges Bar"
>
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2.5 sm:gap-4">
    <!-- Value Proposition Copy -->
    <div class="flex items-center gap-2 text-center sm:text-left">
      <span class="hidden sm:inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#c9a832]/20 text-[#c9a832] text-xs shrink-0 font-bold">
        ✦
      </span>
      <p class="text-xs sm:text-sm font-sans font-medium text-white/95 leading-tight">
        <span class="font-bold text-[#c9a832]">Book Direct & Save 25% vs OTAs</span>
        <span class="hidden md:inline"> • Instant Host Confirmation</span>
        <span class="hidden lg:inline text-white/70"> (Zero Portal Markup)</span>
      </p>
    </div>

    <!-- Direct Conversion Action -->
    <div class="flex items-center gap-2 w-full sm:w-auto justify-center sm:justify-end">
      <!-- WhatsApp Host CTA Button -->
      <a
        id="sticky-direct-wa-btn"
        href="https://wa.me/917505029696?text=Hi!%20I%20want%20to%20claim%20the%2025%25%20Direct%20Booking%20Discount%20at%20Whispering%20Pines%20Resort."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-2 sm:py-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-sans font-bold text-xs sm:text-sm rounded-full shadow-[0_2px_12px_rgba(37,211,102,0.35)] hover:shadow-[0_4px_16px_rgba(37,211,102,0.45)] transition-all duration-200 transform active:scale-[0.98] w-full sm:w-auto"
        title="Chat directly on WhatsApp with Front Desk Host (+91-7505029696)"
      >
        <span class="text-base leading-none">💬</span>
        <span>WhatsApp Host</span>
        <span class="hidden sm:inline font-mono text-[11px] opacity-90">(+91-7505029696)</span>
      </a>

      <!-- Secondary Quick Link for Native Booking Engine (Desktop only) -->
      <a
        href="https://whisperingpinesresort.bookingjini.in/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-1.5 px-4 py-2 bg-white/10 hover:bg-[#c9a832] text-white hover:text-[#1B3322] border border-[#c9a832]/40 rounded-full text-xs font-semibold transition-all duration-200 shrink-0"
        title="Check Live Inventory on Native Engine"
      >
        <span>Live Rates</span>
        <span>→</span>
      </a>
    </div>
  </div>
</div>

<style>
  @media (max-width: 767px) {
    body {
      padding-bottom: 68px !important;
    }
  }
</style>

<script is:inline>
  (function () {
    // 1. Dynamically append current window.location.pathname into WhatsApp pre-filled text
    function updateWhatsAppPageContext() {
      var btn = document.getElementById('sticky-direct-wa-btn');
      if (!btn) return;
      var path = window.location.pathname || '/';
      var baseText = "Hi! I want to claim the 25% Direct Booking Discount at Whispering Pines Resort.";
      var fullText = baseText + " (Inquiry from: " + path + ")";
      btn.href = "https://wa.me/917505029696?text=" + encodeURIComponent(fullText);
    }

    // 2. Mobile body padding enforcement
    function applyMobilePadding() {
      if (window.innerWidth < 768) {
        document.body.style.paddingBottom = '68px';
      } else {
        document.body.style.paddingBottom = '';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        updateWhatsAppPageContext();
        applyMobilePadding();
      });
    } else {
      updateWhatsAppPageContext();
      applyMobilePadding();
    }

    window.addEventListener('resize', applyMobilePadding);

    // 3. Global Click Listeners for Automated GA4 & GTM Conversion Tracking
    // Captures all wa.me/whatsapp.com, tel:, and bookingjini.in / /book-now links
    document.addEventListener('click', function (event) {
      var target = event.target && event.target.closest ? event.target.closest('a') : null;
      if (!target) return;

      var href = target.getAttribute('href') || '';
      if (!href) return;

      var eventName = null;
      var category = 'engagement';

      if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
        eventName = 'whatsapp_chat_click';
        category = 'lead_generation';
      } else if (href.indexOf('tel:') === 0) {
        eventName = 'phone_call_click';
        category = 'phone_conversion';
      } else if (href.indexOf('bookingjini.in') !== -1 || href.indexOf('/book-now') !== -1) {
        eventName = 'booking_engine_click';
        category = 'ecommerce';
      }

      if (eventName) {
        var label = (target.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 60) || href;
        var eventPayload = {
          event: eventName,
          event_category: category,
          event_label: label,
          link_url: href,
          page_location: window.location.href,
          page_path: window.location.pathname,
          timestamp: Date.now()
        };

        // GTM DataLayer Push
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(eventPayload);

        // GA4 gtag Dispatch (if available)
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, {
            event_category: category,
            event_label: label,
            link_url: href,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
      }
    }, true);
  })();
</script>
