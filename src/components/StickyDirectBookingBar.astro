---
// StickyDirectBookingBar.astro
// Sleek, high-converting sticky bottom direct booking bar with automated GA4 & GTM conversion tracking.
---

<div
  id="sticky-direct-booking-bar"
  class="fixed bottom-0 inset-x-0 w-full z-[9999] bg-[#0E2C21] text-[#FAF9F6] border-t-2 border-[#B0966D] shadow-[0_-4px_24px_rgba(0,0,0,0.45)] px-3 sm:px-6 py-2.5 transition-transform duration-300 transform translate-y-0"
  role="region"
  aria-label="Direct Booking Privileges Bar"
>
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2.5 sm:gap-4">
    <!-- Value Proposition Copy -->
    <div class="flex items-center gap-2 text-center sm:text-left">
      <span class="hidden sm:inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#B0966D]/20 text-[#C4A77D] text-xs shrink-0 font-bold">
        ✦
      </span>
      <p class="text-sm sm:text-sm font-sans font-medium text-white/95 leading-tight">
        <span class="font-bold text-[#7A6038]">Book Direct & Save 25% vs OTAs</span>
        <span class="hidden md:inline"> • Instant Host Confirmation</span>
        <span class="hidden lg:inline text-white/70"> (Zero Portal Markup)</span>
      </p>
    </div>

    <!-- Direct Conversion Actions: Call + WhatsApp (mobile), plus engine link (desktop) -->
    <div class="flex items-center gap-2 w-full sm:w-auto justify-center sm:justify-end">
      <!-- Call Front Desk. tel: links are picked up by the delegated phone_call_click tracker below. -->
      <a
        href="tel:+917505029696"
        class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-5 py-2 sm:py-2.5 bg-[#C27847] hover:bg-[#b06a3c] text-[#FAF9F6] font-sans font-bold text-xs sm:text-sm rounded-full border border-[#C27847]/40 shadow-sm transition-colors duration-200 active:scale-[0.98]"
        title="Call Whispering Pines Resort front desk (+91-7505029696)"
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.5a1 1 0 01.95.68l1.2 3.6a1 1 0 01-.24 1.03l-1.4 1.4a13 13 0 006.28 6.28l1.4-1.4a1 1 0 011.03-.24l3.6 1.2a1 1 0 01.68.95V19a2 2 0 01-2 2h-1A16 16 0 013 6V5z"/></svg>
        <span>Call Resort</span>
      </a>

      <!-- WhatsApp Host CTA Button -->
      <a
        id="sticky-direct-wa-btn"
        href="https://wa.me/917505029696?text=Hi!%20I%20want%20to%20claim%20the%2025%25%20Direct%20Booking%20Discount%20at%20Whispering%20Pines%20Resort."
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-5 py-2 sm:py-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-sans font-bold text-xs sm:text-sm rounded-full shadow-[0_2px_10px_rgba(10,18,15,0.22)] transition-colors duration-200 active:scale-[0.98]"
        title="Chat directly on WhatsApp with Front Desk Host (+91-7505029696)"
      >
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.116.554 4.1 1.523 5.823L0 24l6.344-1.498A11.93 11.93 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.792 9.792 0 01-5.002-1.374l-.359-.213-3.765.889.953-3.676-.234-.376A9.794 9.794 0 012.182 12C2.182 6.574 6.574 2.182 12 2.182S21.818 6.574 21.818 12 17.426 21.818 12 21.818z"/></svg>
        <span>WhatsApp Host</span>
        <span class="hidden sm:inline font-mono text-[11px] opacity-90">(+91-7505029696)</span>
      </a>

      <!-- Secondary Quick Link for Native Booking Engine (Desktop only) -->
      <a
        href="https://casadebello-book.whisperingpinesresort.in/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden lg:inline-flex items-center gap-1.5 px-4 py-2 bg-white/10 hover:bg-[#B0966D] text-white hover:text-[#0E2C21] border border-[#8A6F4A]/40 rounded-full text-xs font-semibold transition-colors duration-200 shrink-0"
        title="Check live inventory and rates on the direct booking engine"
      >
        <span>Live Rates</span>
        <span>&#8594;</span>
      </a>
    </div>
  </div>
</div>

<style>
  /* Fallback only. The real value is measured from the bar at runtime, because
     a hardcoded height silently breaks the moment the bar's content changes —
     which is exactly what happened when the Call CTA was added to it. */
  @media (max-width: 767px) {
    body {
      padding-bottom: 96px;
    }
  }
</style>

<script is:inline>
  (function () {
    // 1. Dynamically append current window.location.pathname into WhatsApp pre-filled text
    function updateWhatsAppPageContext() {
      var btn = document.getElementById('sticky-direct-wa-btn');
      if (!btn) return;
      var path = window.location.pathname || '/';
      var baseText = "Hi! I want to claim the 25% Direct Booking Discount at Whispering Pines Resort.";
      var fullText = baseText + " (Inquiry from: " + path + ")";
      btn.href = "https://wa.me/917505029696?text=" + encodeURIComponent(fullText);
    }

    // 2. Reserve exactly as much space as the bar actually occupies, so the
    //    footer is never hidden behind it. Measured, not assumed.
    function applyMobilePadding() {
      var bar = document.getElementById('sticky-direct-booking-bar');
      if (window.innerWidth < 768 && bar) {
        document.body.style.paddingBottom = Math.ceil(bar.getBoundingClientRect().height) + 'px';
      } else {
        document.body.style.paddingBottom = '';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        updateWhatsAppPageContext();
        applyMobilePadding();
      });
    } else {
      updateWhatsAppPageContext();
      applyMobilePadding();
    }

    window.addEventListener('resize', applyMobilePadding);
    window.addEventListener('orientationchange', applyMobilePadding);
    if (typeof ResizeObserver !== 'undefined') {
      var barEl = document.getElementById('sticky-direct-booking-bar');
      if (barEl) new ResizeObserver(applyMobilePadding).observe(barEl);
    }

    // 3. Global Click Listeners for Automated GA4 & GTM Conversion Tracking
    // Captures all wa.me/whatsapp.com, tel:, and casadebello-book / bookingjini.in / /book-now links
    document.addEventListener('click', function (event) {
      var target = event.target && event.target.closest ? event.target.closest('a') : null;
      if (!target) return;

      var href = target.getAttribute('href') || '';
      if (!href) return;

      var eventName = null;
      var category = 'engagement';

      if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
        eventName = 'whatsapp_chat_click';
        category = 'lead_generation';
      } else if (href.indexOf('tel:') === 0) {
        eventName = 'phone_call_click';
        category = 'phone_conversion';
      } else if (href.indexOf('casadebello-book') !== -1 || href.indexOf('bookingjini.in') !== -1 || href.indexOf('/book-now') !== -1) {
        eventName = 'booking_engine_click';
        category = 'ecommerce';
      }

      if (eventName) {
        var label = (target.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 60) || href;
        var eventPayload = {
          event: eventName,
          event_category: category,
          event_label: label,
          link_url: href,
          page_location: window.location.href,
          page_path: window.location.pathname,
          timestamp: Date.now()
        };

        // GTM DataLayer Push
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(eventPayload);

        // GA4 gtag Dispatch (if available)
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, {
            event_category: category,
            event_label: label,
            link_url: href,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
      }
    }, true);
  })();
</script>
