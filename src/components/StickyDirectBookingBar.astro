---
// StickyDirectBookingBar.astro
// Sleek, high-converting sticky bottom direct booking bar with automated GA4 & GTM conversion tracking.
interface Props {
  hideBar?: boolean;
}
const { hideBar = false } = Astro.props;
---

{!hideBar && (
<div
  id="sticky-direct-booking-bar"
  class="md:hidden fixed bottom-0 inset-x-0 w-full z-[9999] wp-pine-surface text-[#FAF9F6] border-t border-[#FAF9F6]/15 shadow-sm px-3 py-2.5"
  role="region"
  aria-label="Mobile Contact Bar"
>
  <div class="max-w-6xl mx-auto flex items-center gap-2.5 w-full">
    <!-- Call Button (Gold as used in header) -->
    <a
      href="tel:+917505029696"
      class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-[#B0966D] hover:bg-[#FAF9F6] text-[#0E2C21] font-sans font-bold text-xs uppercase tracking-[0.1em] rounded-sm shadow-sm transition-colors duration-200 active:scale-[0.98]"
      title="Call Whispering Pines Resort front desk (+91-7505029696)"
    >
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.5a1 1 0 01.95.68l1.2 3.6a1 1 0 01-.24 1.03l-1.4 1.4a13 13 0 006.28 6.28l1.4-1.4a1 1 0 011.03-.24l3.6 1.2a1 1 0 01.68.95V19a2 2 0 01-2 2h-1A16 16 0 013 6V5z"/></svg>
      <span>Call</span>
    </a>

    <!-- WhatsApp Button (Brand Dark Green #0E2C21 + White WhatsApp Icon) -->
    <a
      id="sticky-direct-wa-btn"
      href="https://wa.me/917505029696"
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-[#0E2C21] hover:bg-[#193F30] text-white border border-[#FAF9F6]/30 font-sans font-bold text-xs uppercase tracking-[0.1em] rounded-sm shadow-sm transition-colors duration-200 active:scale-[0.98]"
      title="Chat on WhatsApp with Whispering Pines Resort (+91-7505029696)"
    >
      <svg class="w-4 h-4 shrink-0 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.116.554 4.1 1.523 5.823L0 24l6.344-1.498A11.93 11.93 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.792 9.792 0 01-5.002-1.374l-.359-.213-3.765.889.953-3.676-.234-.376A9.794 9.794 0 012.182 12C2.182 6.574 6.574 2.182 12 2.182S21.818 6.574 21.818 12 17.426 21.818 12 21.818z"/></svg>
      <span>WhatsApp</span>
    </a>
  </div>
</div>

<style>
  @media (max-width: 767px) {
    body {
      padding-bottom: 68px;
    }
  }
</style>
)}

<script is:inline>
  (function () {
    // 1. Reserve space for the sticky bar on mobile viewports (<768px)
    function applyMobilePadding() {
      var bar = document.getElementById('sticky-direct-booking-bar');
      if (window.innerWidth < 768 && bar) {
        document.body.style.paddingBottom = Math.max(68, Math.ceil(bar.getBoundingClientRect().height)) + 'px';
      } else {
        document.body.style.paddingBottom = '';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyMobilePadding);
    } else {
      applyMobilePadding();
    }

    window.addEventListener('resize', applyMobilePadding);
    window.addEventListener('orientationchange', applyMobilePadding);
    if (typeof ResizeObserver !== 'undefined') {
      var barEl = document.getElementById('sticky-direct-booking-bar');
      if (barEl) new ResizeObserver(applyMobilePadding).observe(barEl);
    }

    // 3. Global Click Listeners for Automated GA4 & GTM Conversion Tracking
    // Captures all wa.me/whatsapp.com, tel:, and casadebello-book / bookingjini.in / /book-now links
    document.addEventListener('click', function (event) {
      var target = event.target && event.target.closest ? event.target.closest('a') : null;
      if (!target) return;
      if (target.hasAttribute('data-track-fn') || target.hasAttribute('data-track-dl')) return;

      var href = target.getAttribute('href') || '';
      if (!href) return;

      var eventName = null;
      var category = 'engagement';

      if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp.com') !== -1) {
        eventName = 'whatsapp_chat_click';
        category = 'lead_generation';
      } else if (href.indexOf('tel:') === 0) {
        eventName = 'phone_call_click';
        category = 'phone_conversion';
      } else if (href.indexOf('casadebello-book') !== -1 || href.indexOf('bookingjini.in') !== -1 || href.indexOf('/book-now') !== -1) {
        eventName = 'booking_engine_click';
        category = 'ecommerce';
      }

      if (eventName) {
        var label = (target.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 60) || href;
        var eventPayload = {
          event: eventName,
          event_category: category,
          event_label: label,
          link_url: href,
          page_location: window.location.href,
          page_path: window.location.pathname,
          timestamp: Date.now()
        };

        // GTM DataLayer Push
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(eventPayload);

        // GA4 gtag Dispatch (if available)
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, {
            event_category: category,
            event_label: label,
            link_url: href,
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        }
      }
    }, true);
  })();
</script>
