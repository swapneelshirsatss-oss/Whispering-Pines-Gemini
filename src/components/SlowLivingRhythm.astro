---
import { RESORT_CONTACT, generateWhatsAppLink } from '../data';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

const rhythmSteps = [
  {
    badge: "22 km • ~45 Mins Drive",
    title: "Kainchi Dham (Neem Karoli Baba)",
    subtitle: "Spiritual Darshan & Morning Aarti",
    description: "Seamless morning road access for early darshan without getting stuck in highway bypass bottlenecks. Our resident desk arranges dedicated cabs and local guidance for a peaceful visit.",
    sensoryTag: "Neem Karoli Baba Ashram • Easy Road Access • Cab Coordination"
  },
  {
    badge: "25 km • ~50 Mins Drive",
    title: "Mukteshwar Dham & Chauli Ki Jali",
    subtitle: "Ancient Temple & Dramatic Cliffs",
    description: "Visit the 350-year-old Shiva temple perched at 2,285 metres, explore the dramatic rock cliffs of Chauli Ki Jali, and take in panoramic Himalayan vistas with adventure rappelling spots.",
    sensoryTag: "Mukteshwar Temple • Cliffside Sunset • 180° Snow View"
  },
  {
    badge: "26 km • ~55 Mins Drive",
    title: "Nainital & Naini Lake Excursion",
    subtitle: "Boating, Mall Road & Naina Devi Temple",
    description: "Enjoy a day trip to iconic Naini Lake for boating, Mall Road strolls, and Naina Devi Temple darshan. Return comfortably to our peaceful ridge, avoiding Nainital's hotel noise and parking congestion.",
    sensoryTag: "Naini Lake Boating • Mall Road • Naina Devi Darshan"
  },
  {
    badge: "16 km • ~35 Mins Drive",
    title: "Bhalu Gaad Waterfall Trek",
    subtitle: "Hidden Waterfall & Crystal Pools",
    description: "A scenic, family-friendly trail through dense pine woods leading to a pristine 60-foot cascading mountain waterfall with clean natural plunge pools and refreshing mountain streams.",
    sensoryTag: "60-Ft Waterfall • Pine Forest Trail • Mountain Streams"
  },
  {
    badge: "On-Site • 4:30 PM Onwards",
    title: "Ramgarh Orchards & Cedar Bonfire",
    subtitle: "Fruit Groves, Sunset Tea & Live Barbecue",
    description: "Stroll right outside through historic terraced apple and peach orchards to Tagore Top. Return to quiet ridge breezes, sunset high tea on garden lawns, crackling cedar bonfires, and unpolluted starry skies.",
    sensoryTag: "Apple & Peach Orchards • 180° Sunset • Cedar Bonfire"
  }
];

const whatsappStoryLink = generateWhatsAppLink("Hi! I am planning a sightseeing trip to Nainital, Kainchi Dham, and Mukteshwar. I'd like to check room availability and cab assistance at Whispering Pines.");
---

<section id="slow-living" class={`py-20 lg:py-28 bg-[#FBF9F5] border-y border-[#E6E0D6] ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Editorial Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16 space-y-4">
      <span class="text-xs font-mono uppercase tracking-widest text-[#C27847] font-bold block">
        Central Himalayan Base • 1,780 Metres
      </span>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#1B3322]">
        The Central Hub for Kumaon Sightseeing
      </h2>
      <div class="flex justify-center items-center gap-3 text-[#c9a832]/60 select-none text-xs tracking-widest my-2" aria-hidden="true">
        ✦ &nbsp; ✦ &nbsp; ✦
      </div>
      <p class="text-base sm:text-lg text-[#2C3330]/85 font-sans font-light leading-relaxed text-pretty">
        Stay at the quiet centre of Uttarakhand's top attractions. Whispering Pines connects you effortlessly to Nainital, Kainchi Dham, Mukteshwar, waterfalls, and orchards—with none of the commercial traffic jams, parking stress, or noise of Nainital city.
      </p>

      <!-- Approachable Distance Quick-Pills -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-[11px] sm:text-xs font-mono">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-[#E6E0D6] rounded-full text-[#1B3322] shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
          Nainital: ~55 min (26 km)
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-[#E6E0D6] rounded-full text-[#1B3322] shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
          Kainchi Dham: ~45 min (22 km)
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-[#E6E0D6] rounded-full text-[#1B3322] shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
          Mukteshwar Dham: ~50 min (25 km)
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-[#E6E0D6] rounded-full text-[#1B3322] shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
          Bhalu Gaad Waterfall: ~35 min (16 km)
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-[#E6E0D6] rounded-full text-[#1B3322] shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
          Fruit Orchards: On-Site
        </span>
      </div>
    </div>

    <!-- Timeline Grid: 5 Rhythm Steps -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {rhythmSteps.map((step, idx) => (
        <div class="card-earth card-earth-interactive p-6 sm:p-8 flex flex-col justify-between group">
          <div class="space-y-4">
            <!-- Distance / Time Badge -->
            <div class="flex items-center justify-between border-b border-[#E6E0D6] pb-3">
              <span class="font-mono text-xs sm:text-sm font-bold text-[#C27847] tracking-wider tnum">
                {step.badge}
              </span>
              <span class="text-[11px] font-mono text-[#2C3330]/50 uppercase tracking-widest">
                0{idx + 1} / 05
              </span>
            </div>

            <!-- Titles -->
            <div>
              <h3 class="font-display text-xl sm:text-2xl font-bold text-[#1B3322] group-hover:text-[#C27847] transition-colors leading-snug">
                {step.title}
              </h3>
              <p class="text-xs font-mono text-[#c9a832] font-semibold mt-1">
                {step.subtitle}
              </p>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-[#2C3330]/80 font-sans font-light leading-relaxed text-pretty">
              {step.description}
            </p>
          </div>

          <!-- Sensory Tag Footer -->
          <div class="mt-6 pt-4 border-t border-[#E6E0D6]/60">
            <span class="text-[11px] font-mono text-[#1B3322]/70 block tracking-wide">
              {step.sensoryTag}
            </span>
          </div>
        </div>
      ))}

      <!-- 6th Special Invitation Card -->
      <div class="bg-[#1B3322] text-[#FAF9F6] rounded-2xl p-6 sm:p-8 border border-[#c9a832]/30 flex flex-col justify-between shadow-md relative overflow-hidden group">
        <div class="absolute -right-8 -bottom-8 text-white/[0.04] text-9xl font-serif select-none pointer-events-none" aria-hidden="true">
          ✦
        </div>
        <div class="relative z-10 space-y-4">
          <span class="text-xs font-mono uppercase tracking-widest text-[#c9a832] font-bold block">
            Sightseeing &amp; Stay Concierge
          </span>
          <h3 class="font-display text-2xl font-bold text-white leading-snug">
            Ready to explore Kumaon's top sights?
          </h3>
          <p class="text-xs sm:text-sm text-[#FAF9F6]/80 font-light leading-relaxed">
            Stay centrally in Ramgarh to explore Nainital, Kainchi Dham, and Mukteshwar with zero city traffic. Enjoy 15–20% direct booking privileges, complimentary breakfast, and dedicated in-house cab coordination.
          </p>
        </div>

        <div class="relative z-10 mt-6 pt-4 border-t border-white/15">
          <a
            href={whatsappStoryLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-[#c9a832] hover:bg-[#d8b73f] text-[#1B3322] font-bold text-xs sm:text-sm rounded-xl transition-all shadow-sm focus-ring"
            onclick="if(typeof window.trackAdsConversion==='function'){window.trackAdsConversion('generate_lead','booking','slow_living_whatsapp');}"
          >
            <!-- WhatsApp Official Icon -->
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.116.554 4.1 1.523 5.823L0 24l6.344-1.498A11.93 11.93 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.792 9.792 0 01-5.002-1.374l-.359-.213-3.765.889.953-3.676-.234-.376A9.794 9.794 0 012.182 12C2.182 6.574 6.574 2.182 12 2.182S21.818 6.574 21.818 12 17.426 21.818 12 21.818z"/>
            </svg>
            <span>Plan Excursions &amp; Book Direct</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
