---
import { generateWhatsAppLink } from '../data';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// Minimal editorial distance list (verified distances from AGENTS.md ground truth)
const destinations = [
  { name: "Kainchi Dham", note: "Neem Karoli Baba Ashram", time: "~45 min", km: "22 km" },
  { name: "Mukteshwar Dham", note: "Shiva temple & Chauli Ki Jali", time: "~50 min", km: "25 km" },
  { name: "Nainital", note: "Naini Lake & Mall Road", time: "~55 min", km: "26 km" },
  { name: "Bhalu Gaad Waterfall", note: "Pine forest trail", time: "~35 min", km: "16 km" },
  { name: "Ramgarh Orchards", note: "Apple, peach & plum groves", time: "On-site", km: "" },
];

const whatsappStoryLink = generateWhatsAppLink("Hi! I am planning a sightseeing trip to Nainital, Kainchi Dham, and Mukteshwar. I'd like to check room availability and cab assistance at Whispering Pines.");
---

<section id="slow-living" class={`py-16 lg:py-20 bg-[#FBF9F5] border-y border-[#E6E0D6] ${className}`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

    <div class="lg:col-span-5 space-y-5">
      <h2 class="font-display text-3xl sm:text-4xl font-medium tracking-tight text-[#0E2C21] leading-tight text-balance">
        Nainital, Kainchi Dham and Mukteshwar within an hour
      </h2>
      <div class="w-12 rule-brass-left" />
      <p class="text-base text-[#2C3330]/80 font-sans font-light leading-relaxed">
        A quiet ridge in Malla Ramgarh, away from town traffic, with Kumaon's best-known sights a short drive away.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-2">
        <a
          href={whatsappStoryLink}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-sans font-semibold text-[#0E2C21] underline underline-offset-4 decoration-[#B0966D] hover:text-[#7A6038] transition-colors"
          data-track-fn="trackAdsConversion" data-track-args='["generate_lead","booking","slow_living_whatsapp"]'
        >
          Plan your day trips on WhatsApp &rarr;
        </a>
        <a
          href="/things-to-do-near-mukteshwar/"
          class="text-sm font-sans text-[#2C3330]/70 hover:text-[#0E2C21] transition-colors"
        >
          All things to do
        </a>
      </div>
    </div>

    <ul class="lg:col-span-7 divide-y divide-[#E6E0D6] border-y border-[#E6E0D6]">
      {destinations.map((d) => (
        <li class="flex items-baseline justify-between gap-6 py-4 sm:py-5">
          <div class="min-w-0">
            <h3 class="font-display text-lg sm:text-xl text-[#0E2C21] leading-snug">{d.name}</h3>
            <p class="text-xs sm:text-sm font-sans text-[#2C3330]/60 mt-0.5">{d.note}</p>
          </div>
          <div class="text-right shrink-0 font-sans tnum">
            <span class="block text-sm sm:text-base text-[#0E2C21]">{d.time}</span>
            {d.km && <span class="block text-xs text-[#2C3330]/50">{d.km}</span>}
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>
