---
import '../styles/global.css';
import BreadcrumbSchema, { type BreadcrumbItem } from '../components/BreadcrumbSchema.astro';
import SpeakableSchema from '../components/SpeakableSchema.astro';
import Navbar from '../components/Navbar.tsx';
import FooterSection from '../components/FooterSection.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;

  noindex?: boolean;
  canonical?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description, noindex = false, canonical, breadcrumbs } = Astro.props;
const siteBase = 'https://whisperingpinesresort.in';
const rawPathname = canonical || Astro.url.pathname;
const pathname = (!rawPathname.endsWith('/') && !rawPathname.includes('.')) ? `${rawPathname}/` : rawPathname;
const canonicalURL = new URL(pathname, siteBase);
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=AW-18226439390"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18226439390');
    </script>
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    
    <!-- Technical SEO Meta Tags -->
    <meta name="description" content={description} />

    <meta name="author" content="Whispering Pines Resort Mukteshwar" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://whisperingpinesresort.in/og-image.webp" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://whisperingpinesresort.in/og-image.webp" />

    <!-- Google Fonts for Editorial Elegance and Readability (Asynchronous / Non-Blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>
    
    <BreadcrumbSchema title={title} breadcrumbs={breadcrumbs} />
    <SpeakableSchema />

    <slot name="head" />
    
    <!-- Google Tag Manager -->
    <script type="text/partytown">
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PL8FVLPX');
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body class="bg-[#FAF9F6] text-[#2C3531]">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PL8FVLPX"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <div class="pt-24 bg-[#FAF9F6] min-h-screen flex flex-col">
      <Navbar client:idle>
        <Logo />
      </Navbar>
      
      <main class="flex-grow">
        <slot />
      </main>

      <FooterSection />
    </div>
  </body>
</html>
