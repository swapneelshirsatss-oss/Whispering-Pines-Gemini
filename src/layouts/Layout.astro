---
import '../styles/global.css';
import BreadcrumbSchema, { type BreadcrumbItem } from '../components/BreadcrumbSchema.astro';
import SpeakableSchema from '../components/SpeakableSchema.astro';
import Navbar from '../components/Navbar.tsx';
import FooterSection from '../components/FooterSection.astro';
import Logo from '../components/Logo.astro';
import StickyDirectBookingBar from '../components/StickyDirectBookingBar.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: Array<{ question: string; answer: string }>;
}

const { title, description, image, noindex = false, canonical, breadcrumbs, faqs } = Astro.props;
const siteBase = 'https://whisperingpinesresort.in';
const rawPathname = canonical || Astro.url.pathname;
const pathname = (!rawPathname.endsWith('/') && !rawPathname.includes('.')) ? `${rawPathname}/` : rawPathname;
const canonicalURL = new URL(pathname, siteBase);
const ogImage = image ? (image.startsWith('http') ? image : `${siteBase}${image.startsWith('/') ? '' : '/'}${image}`) : 'https://whisperingpinesresort.in/og-image.webp';
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PL8FVLPX');</script>
    <!-- End Google Tag Manager -->

    <!-- Attribution Persistence for Google Ads / UTM tracking across all sessions -->
    <script is:inline>
      try {
        var urlParams = new URLSearchParams(window.location.search);
        var gclid = urlParams.get('gclid');
        var gbraid = urlParams.get('gbraid');
        var wbraid = urlParams.get('wbraid');
        var utmSource = urlParams.get('utm_source');
        var utmCampaign = urlParams.get('utm_campaign');
        var utmMedium = urlParams.get('utm_medium');
        var utmContent = urlParams.get('utm_content');

        if (gclid || gbraid || wbraid || utmSource || utmCampaign) {
          var attribution = {
            gclid: gclid || '',
            gbraid: gbraid || '',
            wbraid: wbraid || '',
            utm_source: utmSource || '',
            utm_campaign: utmCampaign || '',
            utm_medium: utmMedium || '',
            utm_content: utmContent || '',
            timestamp: Date.now()
          };
          sessionStorage.setItem('wpr_ads_attribution', JSON.stringify(attribution));
        }
      } catch (e) {}
    </script>
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon & App Icons (Optimized for Google Search & Web Standards) -->
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    
    <!-- Technical SEO Meta Tags -->
    <meta name="description" content={description} />

    <meta name="author" content="Whispering Pines Resort Mukteshwar" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Whispering Pines Resort by Casa De Bello - Near Mukteshwar" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts for Editorial Elegance and Readability (Asynchronous / Non-Blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" media="print" id="gfonts-css" />
    <script is:inline>(function(){var l=document.getElementById('gfonts-css');if(l.sheet){l.media='all';}else{l.addEventListener('load',function(){l.media='all';});}})();</script>
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>
    
    <BreadcrumbSchema title={title} breadcrumbs={breadcrumbs} />
    <SpeakableSchema />

    <!-- Google WebSite Schema for Site Name SERP Branding -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://whisperingpinesresort.in/#website",
      "name": "Whispering Pines Resort by Casa De Bello - Near Mukteshwar",
      "alternateName": [
        "Whispering Pines Resort by Casa De Bello",
        "Whispering Pines Resort Mukteshwar",
        "Whispering Pines Resort near Mukteshwar",
        "Whispering Pines by Casa De Bello",
        "Casa De Bello Mukteshwar - ramgarh",
        "Casa De Bello Mukteshwar - Ramgarh"
      ],
      "url": "https://whisperingpinesresort.in/"
    })} />

    <!-- Hotel / Resort Entity & Aggregate Rating Schema (Updated to 4.6 stars & 409 reviews) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Hotel",
      "@id": "https://whisperingpinesresort.in/#hotel",
      "name": "Whispering Pines Resort by Casa De Bello",
      "url": "https://whisperingpinesresort.in/",
      "image": "https://whisperingpinesresort.in/og-image.webp",
      "priceRange": "₹4,500 - ₹12,500",
      "telephone": "+917505029696",
      "hasMap": "https://maps.google.com/?cid=8386667112972057918",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Mukteshwar Road, Malla Ramgarh",
        "addressLocality": "Nainital",
        "addressRegion": "Uttarakhand",
        "postalCode": "263137",
        "addressCountry": "IN"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.6",
        "reviewCount": "409",
        "bestRating": "5",
        "worstRating": "1"
      }
    })} />

    <!-- Generative Engine Optimization (GEO) & LLM Knowledge Base Discovery -->
    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Whispering Pines Resort LLM Knowledge Base" />
    <link rel="llms" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Whispering Pines Resort Full LLM Knowledge Base" />

    <!-- Google Preferred Sources (Official Google Publisher Script) -->
    <link rel="preconnect" href="https://news.google.com" />
    <script async src="https://news.google.com/swg/js/v1/publisher.js"></script>

    <!-- Delegated data-track-* click tracking (no inline onclick handlers, CSP-safe) -->
    <script is:inline defer src="/js/click-tracking.js"></script>

    {faqs && faqs.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      })} />
    )}

    <slot name="head" />
  </head>
  <body class="bg-[#FAF9F6] text-[#2C3531]">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PL8FVLPX"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <div class="bg-[#FAF9F6] min-h-screen flex flex-col">
      <Navbar client:idle>
        <Logo />
      </Navbar>
      
      <main class="flex-grow">
        <slot />
      </main>

      <FooterSection />
    </div>

    <StickyDirectBookingBar />
  </body>
</html>
