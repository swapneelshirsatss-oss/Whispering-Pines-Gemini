# Apache configuration for Astro SSG static site
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Exclude static file extensions from trailing slash rewrites
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.(xml|txt|html|js|css|svg|png|jpg|jpeg|webp|ico|json)$ [NC]
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1/ [R=301,L]

  # Combine HTTP/WWW for static files or URLs with trailing slash into a single 301 redirect
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1 [R=301,L]

  # Force trailing slash on non-file URIs on canonical HTTPS domain
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.(xml|txt|html|js|css|svg|png|jpg|jpeg|webp|ico|json)$ [NC]
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1/ [R=301,L]
</IfModule>


