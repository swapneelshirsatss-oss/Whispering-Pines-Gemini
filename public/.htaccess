# Apache configuration for Astro SSG static site
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Strip trailing slash from all static file requests (e.g. /_astro/file.avif/ -> /_astro/file.avif, /sitemap.xml/ -> /sitemap.xml)
  RewriteCond %{REQUEST_URI} ^/(.+)\.(xml|txt|html|js|css|svg|png|jpg|jpeg|webp|avif|ico|json|woff|woff2)/+$ [NC]
  RewriteRule ^ https://whisperingpinesresort.in/%1.%2 [R=301,L]

  # 2. Canonicalize HTTP and/or WWW directly to https://whisperingpinesresort.in in a single 301 step (prevents redirect chains)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1 [R=301,L]

  # 3. Redirect legacy URL to canonical blog guide route
  RewriteRule ^resort-near-mukteshwar/?$ https://whisperingpinesresort.in/blog/resort-near-mukteshwar/ [R=301,L]
  RewriteRule ^why-ramgarh-is-the-fruit-bowl-of-kumaon/?$ https://whisperingpinesresort.in/blog/ramgarh-fruit-bowl-of-kumaon/ [R=301,L]
  RewriteRule ^blog/why-ramgarh-is-the-fruit-bowl-of-kumaon/?$ https://whisperingpinesresort.in/blog/ramgarh-fruit-bowl-of-kumaon/ [R=301,L]
  RewriteRule ^ramgarh-fruit-bowl-of-kumaon/?$ https://whisperingpinesresort.in/blog/ramgarh-fruit-bowl-of-kumaon/ [R=301,L]

  # 4. Force trailing slash ONLY on directory/page URIs (excluding static files and URIs with trailing slash)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.(xml|txt|html|js|css|svg|png|jpg|jpeg|webp|avif|ico|json|woff|woff2)$ [NC]
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1/ [R=301,L]
</IfModule>

# Enable GZIP Compression for All Static Assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Leverage Browser Caching (Far-Future Expiration)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security Headers & Caching Controls
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header set Cross-Origin-Resource-Policy "same-site"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://*.googletagmanager.com https://tagmanager.google.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com https://*.google.com https://www.googleadservices.com https://*.googleadservices.com https://googleads.g.doubleclick.net https://*.doubleclick.net https://pagead2.googlesyndication.com https://news.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://tagmanager.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.google-analytics.com https://www.googletagmanager.com https://*.googletagmanager.com https://tagmanager.google.com https://www.google.com https://*.google.com https://www.google.co.in https://*.google.co.in https://www.googleadservices.com https://*.googleadservices.com https://googleads.g.doubleclick.net https://*.doubleclick.net https://stats.g.doubleclick.net https://pagead2.googlesyndication.com https://adservice.google.com https://api.indexnow.org https://news.google.com; frame-src 'self' https://www.google.com https://*.google.com https://maps.google.com https://www.googletagmanager.com https://*.googletagmanager.com https://tagmanager.google.com https://*.doubleclick.net https://*.googleadservices.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https:; upgrade-insecure-requests;"

  # Revalidate HTML and XML files immediately to prevent stale CSP or cached versions
  <FilesMatch "\.(html|htm|xml|json|txt)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
  </FilesMatch>

  <FilesMatch "\.(ico|jpe?g|png|gif|webp|avif|swf|css|js|svg|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# Deny access to hidden files and sensitive dotfiles
<FilesMatch "(^\.|\.env|\.git|\.astro)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

