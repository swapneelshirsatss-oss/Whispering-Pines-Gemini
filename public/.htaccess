# Apache configuration for Astro SSG static site
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Strip trailing slash from static file requests (e.g. /sitemap.xml/ -> /sitemap.xml)
  RewriteCond %{REQUEST_URI} ^/(.+)\.(xml|txt|html|js|css|svg|png|jpg|jpeg|webp|ico|json)/+$ [NC]
  RewriteRule ^ https://whisperingpinesresort.in/%1.%2 [R=301,L]

  # 2. Canonicalize HTTP and/or WWW directly to https://whisperingpinesresort.in in a single 301 step (prevents redirect chains)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1 [R=301,L]

  # 3. Force trailing slash ONLY on directory/page URIs (excluding static files and URIs with trailing slash)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.(xml|txt|html|js|css|svg|png|jpg|jpeg|webp|ico|json)$ [NC]
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1/ [R=301,L]
</IfModule>

# Enable GZIP Compression for All Static Assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Leverage Browser Caching (Far-Future Expiration)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|webp|avif|swf|css|js|svg|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
