# Apache configuration for Astro SSG static site
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Strip trailing slash from static file requests (e.g. /sitemap.xml/ -> /sitemap.xml)
  RewriteCond %{REQUEST_URI} ^/(.+)\.(xml|txt|html|js|css|svg|png|jpg|jpeg|webp|ico|json)/+$ [NC]
  RewriteRule ^ https://whisperingpinesresort.in/%1.%2 [R=301,L]

  # 2. Canonicalize HTTP and/or WWW directly to https://whisperingpinesresort.in in a single 301 step (prevents redirect chains)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1 [R=301,L]

  # 3. Force trailing slash ONLY on directory/page URIs (excluding static files and URIs with trailing slash)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.(xml|txt|html|js|css|svg|png|jpg|jpeg|webp|ico|json)$ [NC]
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://whisperingpinesresort.in/$1/ [R=301,L]
</IfModule>


